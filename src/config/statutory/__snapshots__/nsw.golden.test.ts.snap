exports[`NSW wording (phase 1d) > is the wording the platform used before 1`] = `
{
  "CITATIONS": {
    "committeeSeatEndsOnSale": "s 35(1)(a) SSMA 2015",
    "evotingAdoption": "Reg cl 14",
    "interest": "SSMA 2015 s 85",
    "interestSection": "s 85",
    "noInterestResolution": "SSMA 2015 s 85(3)",
    "noInterestSection": "s 85(3)",
    "recoveryReminderNotice": "s.83(1) of the Strata Schemes Management Act 2015",
    "source": "Strata Schemes Management Act 2015 (NSW), as made",
    "worksTwoQuotes": "SSMA s 102",
  },
  "DEBT_RECOVERY_GUIDANCE": {
    "CLOSED": "Close the case once the debt is paid, settled or written off, and reconcile the lot ledger.",
    "COMMITTEE_REVIEW": "Decide whether to start proceedings once the 30-day notice has expired and no payment plan is being followed. Not confirmed: whether the strata committee can decide this or a general meeting resolution is needed (s 103). Check before acting.",
    "ENFORCEMENT": "The solicitor enforces the judgment or order. Not confirmed: the enforcement options. Rely on the solicitor's advice.",
    "FINAL_NOTICE": "Before any recovery action, give the owner written notice at least 30 days ahead. No action can be taken for levies covered by a payment plan that is being followed. Not confirmed: the prescribed content of this notice and the clause that requires it. Check both before issuing.",
    "HARDSHIP_REVIEW": "A payment plan request (and any request to waive interest) is decided by majority vote at an owners corporation or strata committee meeting and recorded in the minutes. The strata managing agent cannot decide it. Reply in writing within 28 days. A plan can run up to 12 months. A refusal must give reasons; the guidance says a request may be refused if the plan would leave a fund short. No fee can be charged. From 23 Oct 2026 a plan can cover current levies and interest as well as overdue levies. While a plan is followed, no recovery action can be taken for the levies it covers.",
    "INITIAL_CONTACT": "Contact the owner informally about the overdue levies and the amount owing. Tell them they can ask for a payment plan of up to 12 months on the standard form, and that the owners corporation cannot charge a fee for it.",
    "LEDGER_VERIFICATION": "Check each overdue levy was validly raised and the levy notice was served with the hardship information. Check payments were applied to the oldest overdue levies first, then interest, then recovery costs, unless the owner or a court or tribunal order said otherwise. Showing levies, interest and costs separately is StrataVerze practice.",
    "LEGAL_REFERRAL": "Refer the matter to a solicitor with the ledger, the levy notices, the 30-day notice, evidence of service and the decision authorising proceedings.",
    "PROCEEDINGS": "The solicitor starts proceedings to recover the unpaid levies as a debt (s 86; current wording not read). Not confirmed: the court or tribunal, its monetary limits and which recovery costs can be claimed. Rely on the solicitor's advice.",
    "REMINDER_NOTICE": "Send a written reminder showing levies, interest and any costs separately, with the hardship information and how to ask for a payment plan. No statutory period for a reminder is confirmed; the building sets its own.",
  },
  "HARDSHIP_INFORMATION": {
    "helplineName": "National Debt Helpline",
    "helplinePhone": "1800 007 007",
    "helplineWeb": "ndh.org.au",
    "moreInformationUrl": "https://www.nsw.gov.au/strata-levies-help",
    "summary": "If you are having trouble paying your levies, contact the owners corporation as soon as possible. You can ask for a payment plan, and the owners corporation must consider your request. Free, confidential financial counselling is available from the National Debt Helpline.",
    "title": "Financial Hardship Information Statement",
  },
  "TERMINOLOGY": {
    "act": "Strata Schemes Management Act 2015",
    "actShort": "SSMA 2015",
    "bodyCorporateName": "The Owners - Strata Plan No. {plan}",
    "bodyCorporateShortName": "The Owners - Strata Plan {plan}",
    "committee": "strata committee",
    "jurisdictionShort": "NSW",
    "lateCharge": "interest",
    "levies": "levies",
    "levy": "levy",
    "ownersCorporation": "owners corporation",
    "planLabel": "Strata Plan",
    "source": "Strata Schemes Management Act 2015 (NSW); NSW Civil and Administrative Tribunal",
    "tribunal": "NCAT",
  },
}
`;
