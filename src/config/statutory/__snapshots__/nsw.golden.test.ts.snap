exports[`NSW debt recovery > default recovery steps are unchanged 1`] = `
[
  {
    "actionRequired": "Check each overdue levy was validly raised and its notice served with the hardship information, and that payments were applied to the oldest levies first, then interest, then costs (unless the owner or a court or tribunal order directed otherwise)",
    "approvalRequired": false,
    "legalBasis": "SSMA 2015 ss 83, 85; payment order: NSW Government guidance (from 27 Oct 2025)",
    "responsibleParty": "ADVISER",
    "stepOrder": 1,
    "stepType": "LEDGER_VERIFICATION",
    "triggerCondition": "Case opened",
  },
  {
    "actionRequired": "Contact the owner about the overdue levies: the amount owing, and that they can ask for a payment plan on the standard form",
    "approvalRequired": false,
    "noticeType": "REMINDER",
    "responsibleParty": "ADVISER",
    "stepOrder": 2,
    "stepType": "INITIAL_CONTACT",
    "triggerCondition": "Ledger verified",
  },
  {
    "actionRequired": "Send a written reminder showing levies, interest and any costs separately, with the hardship information and how to ask for a payment plan",
    "approvalRequired": false,
    "legalBasis": "Interest: SSMA 2015 s 85",
    "noticeType": "DEMAND",
    "responsibleParty": "ADVISER",
    "stepOrder": 3,
    "stepType": "REMINDER_NOTICE",
    "triggerCondition": "No payment or payment plan request after initial contact (period set by the building)",
  },
  {
    "actionRequired": "Give the owner written notice at least 30 days before any recovery action. No action can be taken for levies covered by a payment plan that is being followed",
    "approvalRequired": false,
    "legalBasis": "NSW Government guidance on the changes from 27 Oct 2025",
    "noticeType": "FINAL_DEMAND",
    "responsibleParty": "ADVISER",
    "stepOrder": 4,
    "stepType": "FINAL_NOTICE",
    "triggerCondition": "Reminder unpaid and no payment plan being followed",
  },
  {
    "actionRequired": "Decide any payment plan request (and any request to waive interest) by majority vote at an owners corporation or strata committee meeting, recorded in the minutes, and reply in writing within 28 days. A refusal must give reasons. No fee can be charged. A request can arrive at any step",
    "approvalRequired": true,
    "legalBasis": "Strata Schemes Management Regulation 2016 cl 17K (Form 1); NSW Government guidance",
    "responsibleParty": "COMMITTEE",
    "stepOrder": 5,
    "stepType": "HARDSHIP_REVIEW",
    "triggerCondition": "Owner asks for a payment plan on the standard form",
  },
  {
    "actionRequired": "Decide whether to start recovery proceedings, after the 30-day notice has expired and with no payment plan being followed",
    "approvalRequired": true,
    "responsibleParty": "COMMITTEE",
    "stepOrder": 6,
    "stepType": "COMMITTEE_REVIEW",
    "triggerCondition": "30-day notice expired with no payment and no payment plan being followed",
  },
  {
    "actionRequired": "Refer the matter to a solicitor with the ledger, notices, evidence of service and the authorising decision",
    "approvalRequired": true,
    "legalBasis": "SSMA 2015 s 86",
    "responsibleParty": "ADVISER",
    "stepOrder": 7,
    "stepType": "LEGAL_REFERRAL",
    "triggerCondition": "Recovery proceedings authorised",
  },
  {
    "actionRequired": "Solicitor starts proceedings to recover the unpaid levies as a debt",
    "approvalRequired": false,
    "legalBasis": "SSMA 2015 s 86",
    "responsibleParty": "SOLICITOR",
    "stepOrder": 8,
    "stepType": "PROCEEDINGS",
    "triggerCondition": "Legal referral accepted",
  },
  {
    "actionRequired": "Solicitor enforces the judgment or order",
    "approvalRequired": false,
    "responsibleParty": "SOLICITOR",
    "stepOrder": 9,
    "stepType": "ENFORCEMENT",
    "triggerCondition": "Judgment or order obtained and unpaid",
  },
  {
    "actionRequired": "Close the case and reconcile the lot ledger",
    "approvalRequired": false,
    "responsibleParty": "ADVISER",
    "stepOrder": 10,
    "stepType": "CLOSED",
    "triggerCondition": "Debt paid, settled or written off",
  },
]
`;

