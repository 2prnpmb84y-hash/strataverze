exports[`NSW meetings > AGM template and motion library are unchanged 1`] = `
[
  {
    "explanatoryNote": "Confirmation of the minutes of the previous general meeting (Schedule 1 of the Strata Schemes Management Act 2015 (NSW)).",
    "resolutionCategory": "ORDINARY",
    "resolutionText": "The Owners - Strata Plan No. {{PLAN_NUMBER}} RESOLVES by ordinary resolution that the minutes of the last General Meeting held on {{LAST_MEETING_DATE}} be approved.",
    "title": "Confirmation of Minutes",
  },
  {
    "explanatoryNote": "Adoption of the financial statements for the most recent financial year.",
    "resolutionCategory": "ORDINARY",
    "resolutionText": "The Owners - Strata Plan No. {{PLAN_NUMBER}} RESOLVES by ordinary resolution to consider and adopt the account records and statements prepared for the most recent financial period.",
    "title": "Accounting Records and Financial Statements",
  },
  {
    "explanatoryNote": "A large strata scheme, or a scheme whose annual budget exceeds the prescribed amount, must have its accounts and financial statements audited; optional for other schemes.",
    "resolutionCategory": "ORDINARY",
    "resolutionText": "The Owners - Strata Plan No. {{PLAN_NUMBER}} RESOLVES by ordinary resolution to appoint an auditor to review the accounts and financial statements of the owners corporation for the coming financial year.",
    "title": "Audit",
  },
  {
    "explanatoryNote": "The owners corporation must have a 10-year capital works fund plan and review it at least once every 5 years.",
    "resolutionCategory": "ORDINARY",
    "resolutionText": "The Owners - Strata Plan No. {{PLAN_NUMBER}} RESOLVES by ordinary resolution to revise or replace the plan for the capital works fund for the 10-year capital works fund plan.",
    "title": "Ten-Year Capital Works Fund Plan",
  },
  {
    "explanatoryNote": "Consideration of the owners corporation's insurances as required business at the AGM.",
    "resolutionCategory": "ORDINARY",
    "resolutionText": "The Owners - Strata Plan No. {{PLAN_NUMBER}} RESOLVES by ordinary resolution to note the current insurances of the owners corporation and determine any additional insurances required.",
    "title": "Insurance",
  },
  {
    "explanatoryNote": "Estimates and levies for the administrative and capital works funds.",
    "resolutionCategory": "ORDINARY",
    "resolutionText": "The Owners - Strata Plan No. {{PLAN_NUMBER}} RESOLVES by ordinary resolution to determine the estimated contributions to the administrative fund and the capital works fund for the coming financial year.",
    "title": "Contributions to Administrative and Capital Works Funds",
  },
  {
    "explanatoryNote": "Environmental sustainability item added to the mandatory AGM agenda by the 2025 reforms.",
    "resolutionCategory": "ORDINARY",
    "resolutionText": "The Owners - Strata Plan No. {{PLAN_NUMBER}} RESOLVES by ordinary resolution to consider matters concerning the environmental sustainability of the common property and the scheme.",
    "title": "Environmental Sustainability",
  },
]
`;

