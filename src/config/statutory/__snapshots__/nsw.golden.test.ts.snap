      <tr><td style="padding:4px 12px 4px 0;font-size:13px;color:#64748B;white-space:nowrap;">Amount payable</td><td style="padding:4px 0;font-size:14px;color:#1a1a2e;"><strong>$$825.09</strong></td></tr>
