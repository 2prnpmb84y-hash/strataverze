  "MEETING_RULES_STATUS": {
    "debtorsMayVoteOn": {
      "note": "An unfinancial owner votes only on unanimous and without dissent resolutions (and leasehold expiry postponement and termination resolutions, which are not categories). Unfinancial is read as a levy notice issued, past its due date and not paid in full (FOR_REVIEW).",
      "source": "Strata Titles Act 1985 (WA) s 120(2)",
      "status": "CONFIRMED",
    },
    "labelsAndLists": {
      "note": "The names, the categories each meeting and the motions list offer, the poll categories, pre-meeting voting not offered and common property rows not counted are StrataVerze choices (FOR_REVIEW).",
      "source": "StrataVerze",
      "status": "STRATAVERZE",
    },
    "minutesDeadlines": {
      "note": "No deadline for distributing minutes was found in the STA or STGR read.",
      "source": "Strata Titles Act 1985 (WA) ss 77, 104(1)(b), 120(3), (8), 127 to 132; Strata Titles (General) Regulations 2019 (WA) regs 83, 89",
      "status": "CONFIRMED",
    },
    "noticePeriods": {
      "note": "14 days for a general meeting. The council's 7 days (Sch 1 by-law 8(1)) is a default by-law a scheme may have changed, so council notice is not checked.",
      "source": "Strata Titles Act 1985 (WA) s 129(1)",
      "status": "CONFIRMED",
    },
    "quorumRules": {
      "note": "Held as data; not evaluated. A 2-lot scheme needs both lots (s 130(2), (4)), which the shared basis does not hold: since stage 2, PR 8a-ii its count is refused unless both lots are counted at the item (quorumNeedsEveryLot). The council's quorum is a default by-law and is not held.",
      "source": "Strata Titles Act 1985 (WA) s 130",
      "status": "CONFIRMED",
    },
    "retention": {
      "note": "20 years, the longest period for a meeting's records: special, unanimous and without dissent resolutions are kept 20 years and minutes 7 (reg 83). Keeping the whole meeting record for 20 years is a StrataVerze choice (FOR_REVIEW).",
      "source": "Strata Titles Act 1985 (WA) ss 104, 105; Strata Titles (General) Regulations 2019 (WA) regs 83, 84",
      "status": "STRATAVERZE",
    },
  },
  "NOTICE_RULES": {
    "checked": {
