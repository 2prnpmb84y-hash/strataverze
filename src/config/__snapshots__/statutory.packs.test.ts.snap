  "DECISIONS": [
    {
      "decidedBy": null,
      "decidedOn": null,
      "decision": "Support unlimited owners corporations first; limited owners corporations are listed but blocked (OWNERS_CORPORATION_TYPE).",
      "proposedOn": "2026-10-27",
    },
    {
      "decidedBy": null,
      "decidedOn": null,
      "decision": "Hold annual fees and other money not paid into the maintenance fund in the ledger's administrative fund, and the maintenance fund in the ledger's capital works fund.",
      "proposedOn": "2026-10-27",
    },
    {
      "decidedBy": null,
      "decidedOn": null,
      "decision": "Hold fees in fee units, with a dollar table for each financial year marked as calculated, never as official.",
      "proposedOn": "2026-10-27",
    },
    {
      "decidedBy": null,
      "decidedOn": null,
      "decision": "Follow the Act where CAV guidance differs, and record the difference (GUIDANCE_CONFLICTS).",
      "proposedOn": "2026-10-27",
    },
    {
      "decidedBy": null,
      "decidedOn": null,
      "decision": "Keep each pending change off until its commencement is confirmed and a new pack version records it.",
      "proposedOn": "2026-10-27",
    },
    {
      "decidedBy": null,
      "decidedOn": null,
      "decision": "Charge no interest until a building records the general meeting resolution that authorises it, with the rate.",
      "proposedOn": "2026-10-27",
    },
    {
      "decidedBy": null,
      "decidedOn": null,
      "decision": "Show owners "fees", "fee notice" and "final notice", never "levy".",
      "proposedOn": "2026-10-27",
    },
    {
      "decidedBy": "Matthew Wrigley",
      "decidedOn": "2026-10-28",
      "decision": "Apply a payment to fees first, then interest, then recovery costs, as NSW (PAYMENT_ALLOCATION_ORDER). A StrataVerze choice: the notes record no order in force before s 32I.",
      "proposedOn": "2026-10-28",
    },
    {
      "decidedBy": "Matthew Wrigley",
      "decidedOn": "2026-10-28",
      "decision": "Notice timing (NOTICE_RULES): each fee notice goes out 35 days before it falls due, a StrataVerze choice, and never with less than 28 days' notice, StrataVerze's reading of s 31(2)(a) kept as the legal rule. Matthew Wrigley's StrataVerze decision of 28 Oct 2026.",
      "proposedOn": "2026-10-28",
    },
    {
      "decidedBy": "Matthew Wrigley",
      "decidedOn": "2026-10-29",
      "decision": "Quorum (MEETING_RULES.quorumAttestation): the chair's answer for each item, "quorum present: yes or no", is accepted until attendance is recorded. It is never filled in for the chair, an item not answered is refused, and the answer is kept in the meeting record with who recorded it. When attendance is recorded the quorum is to be worked out from it instead. Matthew Wrigley's StrataVerze decision of 29 Oct 2026.",
      "proposedOn": "2026-10-29",
    },
  ],
