  "RESOLUTIONS": {
    "ORDINARY": {
      "appliesAboveMembers": 2,
      "basis": "more votes for than against; on a poll, more voting value (unit entitlement) for than against",
      "oneOrTwoMembers": {
        "appliesFromMembers": 1,
        "appliesUpToMembers": 2,
        "basis": "no vote cast against and at least 1 vote cast in favour",
        "source": "Unit Titles (Management) Act 2011 (ACT) sch 3 s 3.15(2)",
      },
      "pollAvailable": true,
      "source": "Unit Titles (Management) Act 2011 (ACT) sch 3 s 3.15",
    },
    "SPECIAL": {
      "againstNotMoreThanFractionOfVotesThatCanBeCastByPeoplePresent": 0.25,
      "appliesAboveMembers": 3,
      "basis": "more votes for than against, and votes against not more than 1/4 of the total votes that can be cast by people present (including proxy votes); by number of votes unless a poll is taken, then by voting value",
      "oneOrTwoMembers": {
        "appliesFromMembers": 1,
        "appliesUpToMembers": 2,
        "basis": "no vote cast against and at least 1 vote cast in favour",
        "source": "Unit Titles (Management) Act 2011 (ACT) sch 3 s 3.16(3)",
      },
      "pollAvailable": true,
      "source": "Unit Titles (Management) Act 2011 (ACT) sch 3 s 3.16",
      "threeMembers": {
        "againstFractionDenominator": null,
        "againstFractionDenominatorStatus": "NOT_CONFIRMED",
        "againstLessThanFraction": 0.3333333333333333,
        "appliesFromMembers": 3,
        "appliesUpToMembers": 3,
        "source": "Unit Titles (Management) Act 2011 (ACT) sch 3 s 3.16(2)",
      },
      "votesPresentIncludeProxies": true,
    },
    "UNANIMOUS": {
      "appliesAboveMembers": 2,
      "basis": "every person entitled to vote is present, represented by proxy or has cast an absentee vote; no votes against; at least 1 vote for",
