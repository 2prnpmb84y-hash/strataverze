  "LATE_CHARGE": {
    "annual": {
      "accrual": {
        "daysInYear": {
          "note": "The notes give a rate a year and do not say how a day's share of it is worked out.",
          "source": "Unit Titles (Management) Act 2011 (ACT) s 94(1)(a)",
          "status": "NOT_CONFIRMED",
          "value": null,
        },
        "from": {
          "note": "The notes say 10% a year simple interest "until paid", and that a contribution is payable on the date stated in the notice or on the instalment dates. They do not say from which day interest runs.",
          "source": "Unit Titles (Management) Act 2011 (ACT) ss 80, 91, 94(1)(a)",
          "status": "NOT_CONFIRMED",
          "value": null,
        },
        "graceMonths": {
          "note": "The notes record no grace period, and do not say there is none.",
          "source": "Unit Titles (Management) Act 2011 (ACT) s 94",
          "status": "NOT_CONFIRMED",
          "value": null,
        },
        "simple": {
          "source": "Unit Titles (Management) Act 2011 (ACT) s 94(1)(a)",
          "status": "CONFIRMED",
