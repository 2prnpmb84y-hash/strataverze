        "appliesFromMembers": 1,
        "appliesUpToMembers": 2,
        "basis": "no vote cast against and at least 1 vote cast in favour",
        "source": "Unit Titles (Management) Act 2011 (ACT) sch 3 s 3.18(2)",
      },
      "pollAvailable": false,
      "source": "Unit Titles (Management) Act 2011 (ACT) sch 3 s 3.18",
    },
    "UNOPPOSED": {
      "appliesAboveMembers": null,
      "basis": "no votes against and at least 1 vote for; abstentions do not block it",
      "memberScopeStatus": "NOT_CONFIRMED",
      "pollAvailable": false,
