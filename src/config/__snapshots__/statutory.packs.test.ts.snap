  "PROXIES": {
    "capacities": [
      "attend, speak and vote at meetings",
      "vote at a ballot",
      "represent the owner on the committee",
    ],
    "coercionPenaltyUnits": 60,
    "committeeMemberProxyMustBeCommitteeMember": true,
    "deliveredTo": "the secretary",
    "effectiveFrom": "the first meeting after delivery",
    "form": "OCR Sch 1",
    "lapsesAfterMonths": 12,
    "limit": {
      "counts": "occupiable lots",
      "exceptions": [
        "family members",
        "one owner with multiple lots (prescribed)",
        "owners corporations managing commercial, retail or industrial common property (prescribed)",
      ],
      "maxLotOwnersWhenAtOrBelowThreshold": 1,
      "maxPercentOfLotOwnersWhenAboveThreshold": 5,
      "occupiableLotsThreshold": 20,
      "roundingStatus": "NOT_CONFIRMED",
      "source": "Owners Corporations Act 2006 (Vic) s 89D; Owners Corporations Regulations 2018 (Vic) reg 8A",
    },
    "mustAuthoriseAnIndividual": true,
    "nonOwnerProxyCannotVoteOn": [
      "delegations (s 11)",
      "the manager's appointment, pay or removal",
    ],
    "ownerInArrearsMayBeProxy": false,
    "powerOfAttorneySameLimitsFamilyExceptionOnly": true,
    "revocableByWrittenNoticeToSecretary": true,
    "source": "Owners Corporations Act 2006 (Vic) ss 89C, 89D, 89E, 89F, 89G; Owners Corporations Regulations 2018 (Vic) regs 8, 8A, Sch 1",
    "status": "CONFIRMED",
    "transferable": false,
  },
  "RECORDS": {
    "copiesCapped": true,
    "inspectionBy": [
