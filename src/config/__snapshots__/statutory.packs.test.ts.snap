  "RESOLUTIONS": {
    "ORDINARY": {
      "basis": "more than 50% of the lots for which votes are cast (or of their unit entitlements, if demanded); a tie fails",
      "countedBy": "number, or unit entitlement if demanded",
      "source": "Strata Titles Act 1985 (WA) ss 122, 123(7)",
    },
    "SPECIAL": {
      "againstLessThanFractionOfAllLots": 0.25,
      "againstLessThanFractionOfAllUnitEntitlement": 0.25,
      "basis": "for: at least 50% of all lots and at least 50% of all unit entitlements; against: less than 25% of all lots and less than 25% of all unit entitlements",
      "countedBy": "number and unit entitlement",
      "forMinFractionOfAllLots": 0.5,
      "forMinFractionOfAllUnitEntitlement": 0.5,
      "measuredAgainstAllLots": true,
      "source": "Strata Titles Act 1985 (WA) ss 122, 123(4)",
    },
    "UNANIMOUS": {
      "basis": "the vote of every lot is cast in favour",
      "countedBy": "number",
      "source": "Strata Titles Act 1985 (WA) ss 122, 123(1)",
    },
    "WITHOUT_DISSENT": {
      "basis": "no vote of any lot is cast against (a 2-lot scheme: only if unanimous)",
      "countedBy": "number",
      "source": "Strata Titles Act 1985 (WA) ss 122, 123(2), (3)",
    },
    "byLawRegistrationWithinMonths": 3,
    "defaultType": "ORDINARY",
    "developerExcludedFromDefectVotesYears": 10,
