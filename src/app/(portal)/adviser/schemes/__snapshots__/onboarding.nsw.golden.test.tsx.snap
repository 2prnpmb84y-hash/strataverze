exports[`NSW Add Property wizard (golden) > shows every step as before > balances problems 1`] = `"<div><div class="max-w-5xl"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><a class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-2" href="/adviser/schemes"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Schemes</a><h1 class="text-2xl font-bold font-heading text-ink mb-1">Add Property</h1><p class="text-sm text-ink-muted">Register a new Owners Corporation.</p></div></div><div><nav class="mb-8" aria-label="Add property steps"><ol class="flex items-center gap-2"><li class="flex items-center gap-2 flex-1 min-w-0"><button type="button" class="flex items-center gap-2 text-sm font-medium transition-colors min-w-0 text-ink"><span class="flex shrink-0 items-center justify-center w-7 h-7 rounded-full text-xs font-bold transition-colors bg-mint-soft text-turquoise"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7l3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="truncate hidden lg:inline">Strata Roll</span></button><div class="flex-1 h-px min-w-2 bg-turquoise/60"></div></li><li class="flex items-center gap-2 flex-1 min-w-0"><button type="button" class="flex items-center gap-2 text-sm font-medium transition-colors min-w-0 text-ink"><span class="flex shrink-0 items-center justify-center w-7 h-7 rounded-full text-xs font-bold transition-colors bg-mint-soft text-turquoise"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7l3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="truncate hidd