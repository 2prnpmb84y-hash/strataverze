r="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums py-2.5" value="2,000"></div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="rounded-[var(--radius-card)] border border-line p-4"><h3 class="text-sm font-semibold text-ink mb-3">Administrative fund</h3><div class="space-y-3"><div><div class="flex items-center gap-3"><label for="admin-cash" class="flex-1 text-sm text-ink">Cash at bank</label><input id="admin-cash" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="1,000"></div></div><div><div class="flex items-center gap-3"><label for="admin-receivable" class="flex-1 text-sm text-ink">Levies receivable (including interest)</label><input id="admin-receivable" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="300"></div></div><div><div class="flex items-center gap-3"><label for="admin-advance" class="flex-1 text-sm text-ink"><span class="text-ink-muted">less </span>Levies paid in advance</label><input id="admin-advance" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="100"></div></div><div><div class="flex items-center gap-3"><label for="admin-creditors" class="flex-1 text-sm text-ink"><span class="text-ink-muted">less </span>Creditors</label><input id="admin-creditors" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="200"></div></div><div class="flex items-center justify-between border-t border-line pt-3 text-sm"><span class="text-ink-muted">Balance sheet comes to</span><span class="font-medium tabular-nums text-ink">$1,000.00</span></div><div><div class="flex items-center gap-3"><label for="admin-balance" class="flex-1 text-sm text-ink">Fund opening balance</label><input id="admin-balance" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="1,000"></div></div><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Reconciles with the balance sheet</span></div></div></div><div class="rounded-[var(--radius-card)] border border-line p-4"><h3 class="text-sm font-semibold text-ink mb-3">Capital works fund</h3><div class="space-y-3"><div><div class="flex items-center gap-3"><label for="capitalWorks-cash" class="flex-1 text-sm text-ink">Cash at bank</label><input id="capitalWorks-cash" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabu