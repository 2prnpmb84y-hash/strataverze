g-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div><div class="flex items-center gap-3"><label for="admin-receivable" class="flex-1 text-sm text-ink">Levies receivable (including interest)</label><input id="admin-receivable" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div><div class="flex items-center gap-3"><label for="admin-advance" class="flex-1 text-sm text-ink"><span class="text-ink-muted">less </span>Levies paid in advance</label><input id="admin-advance" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div><div class="flex items-center gap-3"><label for="admin-creditors" class="flex-1 text-sm text-ink"><span class="text-ink-muted">less </span>Creditors</label><input id="admin-creditors" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div class="flex items-center justify-between border-t border-line pt-3 text-sm"><span class="text-ink-muted">Balance sheet comes to</span><span class="font-medium tabular-nums text-ink">$0.00</span></div><div><div class="flex items-center gap-3"><label for="admin-balance" class="flex-1 text-sm text-ink">Fund opening balance</label><input id="admin-balance" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Reconciles with the balance sheet</span></div></div></div><div class="rounded-[var(--radius-card)] border border-line p-4"><h3 class="text-sm font-semibold text-ink mb-3">Capital works fund</h3><div class="space-y-3"><div><div class="flex items-center gap-3"><label for="capitalWorks-cash" class="flex-1 text-sm text-ink">Cash at bank</label><input id="capitalWorks-cash" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div><div class="flex items-center gap-3"><label for="capitalWorks-receivable" class="flex-1 text-sm text-ink">Levies receivable (including interest)</label><input id="capitalWorks-receivable" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div><div class="flex items-center gap-3"><label for="capitalWorks-creditors" class="flex-1 text-sm text-ink"><span class="text-ink-muted">less </span>Creditors</label><input id="capitalWorks-creditors" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div class="flex items-center justify-between border-t border-line pt-3 text-sm"><span class="text-ink-muted">Balance sheet comes to</span><span class="font-medium tabular-nums text-ink">$0.00</span></div><div><div class="flex items-center gap-3"><label for="capitalWorks-balance" class="flex-1 text-sm text-ink">Fund opening balance</label><input id="capitalWorks-balance" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value=""></div></div><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Reconciles with the balance sheet</span></div></div></div></div><div class="mt-4"><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Total $0.00 equals administrative $0.00 plus capital works $0.00 ($0.00)</span></div></div><p class="mt-3 text-xs text-ink-muted">Other balances (investments, prepayments, GST) are not entered here. If the building has them, load the full trial balance in Finance, under Data Migration, before signing off the cutover.</p></div><div class="flex items-center justify-between mt-8 pt-6 border-t border-line"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back</button><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="button">Next: Lot Balances<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></div><div class="hidden"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div><h2 class="font-heading font-semibold text-ink mb-1">Lot Opening Balances</h2><p class="text-sm text-ink-muted mb-5">What each owner owes at the takeover date: the levies and the interest owing in each fund, as shown in the previous manager's handover. Unallocated is money an owner has paid that is not yet applied to a levy: it is held as a credit in the administrative fund. Type the amounts as the handover prints them: a minus sign is fine (Urbanise shows an amount owing as -250.12), because each column already says whether the amount is owed or a credit.</p><div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-5"><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Admin levies and interest $0.00 of $0.00 receivable</span></div><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Capital works levies and interest $0.00 of $0.00 receivable</span></div><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Unallocated $0.00 of $0.00 paid in advance</span></div></div><div class="overflow-x-auto rounded-[var(--radius-card)] border border-line"><table class="w-full min-w-[880px] text-sm"><thead><tr class="bg-muted/50 text-left"><th scope="col" class="px-3 py-2 font-medium text-ink-muted w-16">Lot</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted">Owner</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted text-right w-32">Admin levies</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted text-right w-32">Admin interest</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted text-right w-32">Capital works levies</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted text-right w-32">Capital works interest</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted text-right w-32">Unallocated</th></tr></thead><tbody></tbody><tfoot><tr class="border-t border-line bg-muted/30 font-medium"><td class="px-3 py-2 text-ink" colspan="2">Total</td><td class="px-3 py-2 text-right tabular-nums">$0.00</td><td class="px-3 py-2 text-right tabular-nums">$0.00</td><td class="px-3 py-2 text-right tabular-nums">$0.00</td><td class="px-3 py-2 text-right tabular-nums">$0.00</td><td class="px-3 py-2 text-right tabular-nums">$0.00</td></tr></tfoot></table></div></div><div class