&quot;1,000&quot;}}" name="balancesJson"><input type="hidden" value="[]" name="lotBalancesJson"><div class="hidden"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><h2 class="font-heading font-semibold text-ink mb-1">Property Details</h2><p class="text-sm text-ink-muted mb-6">Enter the core details of the Owners Corporation.</p><div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5"><div class="sm:col-span-2"><label for="name" class="block text-sm font-medium text-ink mb-1.5">Scheme Name<span class="text-red-500 ml-0.5">*</span></label><input id="name" required="" placeholder="e.g. Harbour View Towers OC" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="name"></div><div class=""><label for="planNumber" class="block text-sm font-medium text-ink mb-1.5">Plan Number<span class="text-red-500 ml-0.5">*</span></label><input id="planNumber" required="" placeholder="e.g. SP 12345" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="planNumber"></div><div class=""><label for="folio" class="block text-sm font-medium text-ink mb-1.5">Folio</label><input id="folio" placeholder="e.g. 12345/678" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="folio"><p class="mt-1.5 text-xs text-ink-muted">Land title folio reference</p></div><div class=""><label for="abnNumber" class="block text-sm font-medium text-ink mb-1.5">ABN</label><input id="abnNumber" placeholder="e.g. 12 345 678 901" class="w-ful