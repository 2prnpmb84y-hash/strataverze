;,&quot;leviesReceivable&quot;:&quot;300&quot;,&quot;leviesInAdvance&quot;:&quot;100&quot;,&quot;creditors&quot;:&quot;200&quot;,&quot;fundBalance&quot;:&quot;1,000&quot;},&quot;capitalWorks&quot;:{&quot;cashAtBank&quot;:&quot;900&quot;,&quot;leviesReceivable&quot;:&quot;100&quot;,&quot;leviesInAdvance&quot;:&quot;&quot;,&quot;creditors&quot;:&quot;&quot;,&quot;fundBalance&quot;:&quot;1,000&quot;}}" name="balancesJson"><input type="hidden" value="[{&quot;lotNumber&quot;:&quot;1&quot;,&quot;admin&quot;:&quot;300&quot;,&quot;interestAdmin&quot;:&quot;&quot;,&quot;capitalWorks&quot;:&quot;60&quot;,&quot;interestCapitalWorks&quot;:&quot;40&quot;,&quot;unallocated&quot;:&quot;&quot;},{&quot;lotNumber&quot;:&quot;2&quot;,&quot;admin&quot;:&quot;&quot;,&quot;interestAdmin&quot;:&quot;&quot;,&quot;capitalWorks&quot;:&quot;&quot;,&quot;interestCapitalWorks&quot;:&quot;&quot;,&quot;unallocated&quot;:&quot;100&quot;}]" name="lotBalancesJson"><div class="hidden"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><h2 class="font-heading font-semibold text-ink mb-1">Property Details</h2><p class="text-sm text-ink-muted mb-6">Enter the core details of the Owners Corporation.</p><div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5"><div class="sm:col-span-2"><label for="name" class="block text-sm font-medium text-ink mb-1.5">Scheme Name<span class="text-red-500 ml-0.5">*</span></label><input id="name" required="" placeholder="e.g. Harbour View Towers OC" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="name"></div><div class=""><label for="planNumber" class="block text-sm font-medium text-ink mb-1.5">Plan Number<span class="text-red-500 ml-0.5">*</span></label><input id="planNumber" required="" placeholder="e.g. SP 12345" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="planNumber"></div><div class=""><label for="folio" class="block text-sm font-medium text-ink mb-1.5">Folio</label><input id="folio" placeholder="e.g. 12345/678" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="folio"><p class="mt-1.5 text-xs text-ink-muted">Land title folio reference</p></div><div class=""><label for="abnNumber" class="block text-sm font-medium text-ink mb-1.5">ABN</label><input id="abnNumber" placeholder="e.g. 12 345 678 901" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="abnNumber"><p class="mt-1.5 text-xs text-ink-muted">Optional</p></div><div class=""><label for="buildingType" class="block text-sm font-medium text-ink mb-1.5">Building Type</label><select id="buildingType" name="buildingType" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="">Select type...</option><option value="STRATA">Strata</option><option value="COMMUNITY">Community</option><option value="COMPANY_TITLE">Company Title</option><option value="STRATUM">Stratum</option></select></div><div class=""><label for="buildingSubType" class="block text-sm font-medium text-ink mb-1.5">Building Sub-Type</label><select id="buildingSubType" name="buildingSubType" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="">Select sub-type...</option><option value="Residential">Residential</option><option value="Commercial">Commercial</option><option value="Mixed Use">Mixed Use</option><option value="Industrial">Industrial</option><option value="Retail">Retail</option></select></div><div class=""><label for="buildingClass" class="block text-sm font-medium text-ink mb-1.5">Building Class</label><select id="buildingClass" name="buildingClass" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="">Select class...</option><option value="1">Class 1 — Detached houses</option><option value="2">Class 2 — Apartments / units</option><option value="3">Class 3 — Residential (other)</option><option value="5">Class 5 — Office</option><option value="6">Class 6 — Retail / shops</option><option value="7">Class 7 — Storage / car parks</option><option value="8">Class 8 — Laboratory / production</option><option value="9">Class 9 — Public building</option></select></div><div class=""><label for="totalLots" class="block text-sm font-medium text-ink mb-1.5">Total Lots<span class="text-red-500 ml-0.5">*</span></label><input id="totalLots" required="" placeholder="e.g. 24" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="number" name="totalLots"><p class="mt-1.5 text-xs text-ink-muted">The lots on the strata plan. The Lots step must have this many.</p></div><div class=""><label for="totalEntitlement" class="block text-sm font-medium text-ink mb-1.5">Total Unit Entitlement<span class="text-red-500 ml-0.5">*</span></label><input id="totalEntitlement" required="" placeholder="e.g. 1000" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="number" name="totalEntitlement"><p class="mt-1.5 text-xs text-ink-muted">The aggregate unit entitlement. The lots' unit entitlements must add up to it.</p></div></div><div class="flex items-center justify-between mt-8 pt-6 border-t border-line"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back</button><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="button">Next: Address &amp; Settings<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></div><div class="hidden"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><h2 class="font-heading font-semibold text-ink mb-1">Address &amp; Settings</h2><p class="text-sm text-ink-muted mb-6">Set the property address, financial settings, and preferences.</p><div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5"><div class="sm:col-span-2"><label for="address" class="block text-sm font-medium text-ink mb-1.5">Street Address<span class="text-red-500 ml-0.5">*</span></label><input id="address" required="" placeholder="e.g. 42 Macquarie Street" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="address"></div><div class=""><label for="suburb" class="block text-sm font-medium text-ink mb-1.5">Suburb<span class="text-red-500 ml-0.5">*</span></label><input id="suburb" required="" placeholder="e.g. Sydney" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="suburb"></div><div class="grid grid-cols-2 gap-4"><div class=""><label for="state" class="block text-sm font-medium text-ink mb-1.5">State<span class="text-red-500 ml-0.5">*</span></label><select id="state" name="state" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="NSW" selected="">New South Wales</option></select><p class="mt-1.5 text-xs text-ink-muted">Only New South Wales buildings can be set up for now.</p></div><div class=""><label for="postcode" class="block text-sm font-medium text-ink mb-1.5">Postcode<span class="text-red-500 ml-0.5">*</span></label><input id="postcode" required="" placeholder="2000" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="text" name="postcode"></div></div><div class=""><label for="financialYearEnd" class="block text-sm font-medium text-ink mb-1.5">Financial Year End<span class="text-red-500 ml-0.5">*</span></label><input id="financialYearEnd" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" type="date" value="2027-06-30" name="financialYearEnd"><p class="mt-1.5 text-xs text-ink-muted">The last day of the building's current financial year (day, month and year).</p></div><div class=""><label for="paymentPlan" class="block text-sm font-medium text-ink mb-1.5">Payment Plan</label><select id="paymentPlan" name="paymentPlan" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="" selected="">Select plan...</option><option value="QUARTERLY">Quarterly</option><option value="MONTHLY">Monthly</option><option value="ANNUALLY">Annually</option><option value="HALF_YEARLY">Half-Yearly</option></select></div></div><div class="mt-6 pt-6 border-t border-line"><h3 class="text-sm font-semibold text-ink mb-4">Settings</h3><div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><div class=""><label class="flex items-start gap-3 cursor-pointer"><input class="mt-0.5 h-4 w-4 rounded border-line text-turquoise focus:ring-turquoise" type="checkbox" value="true" checked="" name="isActive"><div><span class="text-sm font-medium text-ink">Active</span><p class="text-xs text-ink-muted mt-0.5">Property is currently active</p></div></label></div><div class=""><label class="flex items-start gap-3 cursor-pointer"><input class="mt-0.5 h-4 w-4 rounded border-line text-turquoise focus:ring-turquoise" type="checkbox" value="true" name="allInclusiveFees"><div><span class="text-sm font-medium text-ink">All Inclusive Fees</span><p class="text-xs text-ink-muted mt-0.5">Include all fees in levy calculations</p></div></label></div><div class=""><label class="flex items-start gap-3 cursor-pointer"><input class="mt-0.5 h-4 w-4 rounded border-line text-turquoise focus:ring-turquoise" type="checkbox" value="true" name="debtCollection"><div><span class="text-sm font-medium text-ink">Debt Collection</span><p class="text-xs text-ink-muted mt-0.5">Enable automatic debt collection</p></div></label></div></div></div><div class="mt-6 pt-6 border-t border-line"><h3 class="text-sm font-semibold text-ink mb-1">Property photo (optional)</h3><p class="text-sm text-ink-muted mb-4">Shown on the building's page and beside it in your list of schemes. JPEG, PNG or WebP, up to 10 MB. You can add or change it later.</p><div class="flex flex-col gap-3 sm:flex-row sm:items-center"><div class="flex h-24 w-36 items-center justify-center rounded-lg border border-dashed border-line text-xs text-ink-muted">No photo chosen</div><div class="flex flex-wrap items-center gap-2"><label class="inline-flex h-10 cursor-pointer items-center rounded-full border-[1.5px] border-turquoise bg-white px-5 text-[13px] font-semibold uppercase tracking-[0.04em] text-turquoise hover:bg-turquoise/5 focus-within:ring-2 focus-within:ring-turquoise">Choose photo<input accept="image/jpeg,image/png,image/webp" class="sr-only" type="file"></label></div></div></div><div class="flex items-center justify-between mt-8 pt-6 border-t border-line"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back</button><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="button">Next: Lots &amp; Owners<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></div><div class="hidden"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div><h2 class="font-heading font-semibold text-ink mb-1">Lots and Owners</h2><p class="text-sm text-ink-muted mb-5">Enter every lot with its unit entitlement, and each owner's name exactly as it appears on the strata roll (for example joint owners, or a company with its ACN).</p><div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5"><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Lots: 2 entered of 2 on the building</span></div><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Unit entitlement: 100 entered of 100 total</span></div></div><div class="overflow-x-auto rounded-[var(--radius-card)] border border-line"><table class="w-full min-w-[640px] text-sm"><thead><tr class="bg-muted/50 text-left"><th scope="col" class="px-3 py-2 font-medium text-ink-muted w-24">Lot</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted w-24">Unit No.</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted w-32">Unit Entitlement</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted">Owner name (as on the strata roll)</th><th scope="col" class="px-3 py-2 w-12"><span class="sr-only">Remove</span></th></tr></thead><tbody><tr class="border-t border-line/60 align-top"><td class="px-3 py-2"><input aria-label="Lot number, row 1" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise" value="1"></td><td class="px-3 py-2"><input aria-label="Unit number, row 1" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise" value=""></td><td class="px-3 py-2"><input aria-label="Unit entitlement, row 1" inputmode="numeric" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums" value="40"></td><td class="px-3 py-2"><input aria-label="Owner name as on the strata roll, row 1" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise" maxlength="500" value="J CITIZEN"></td><td class="px-3 py-2 text-right"><button type="button" class="rounded px-2 py-1.5 text-ink-muted hover:bg-muted hover:text-ink" aria-label="Remove row 1">×</button></td></tr><tr class="border-t border-line/60 align-top"><td class="px-3 py-2"><input aria-label="Lot number, row 2" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise" value="2"></td><td class="px-3 py-2"><input aria-label="Unit number, row 2" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise" value=""></td><td class="px-3 py-2"><input aria-label="Unit entitlement, row 2" inputmode="numeric" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums" value="60"></td><td class="px-3 py-2"><input aria-label="Owner name as on the strata roll, row 2" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise" maxlength="500" value="ACME PTY LTD"></td><td class="px-3 py-2 text-right"><button type="button" class="rounded px-2 py-1.5 text-ink-muted hover:bg-muted hover:text-ink" aria-label="Remove row 2">×</button></td></tr></tbody></table></div><div class="flex flex-wrap gap-2 mt-3"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button">Add lot</button></div></div><div class="flex items-center justify-between mt-8 pt-6 border-t border-line"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back</button><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="button">Next: Opening Balances<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></div><div class="hidden"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div><h2 class="font-heading font-semibold text-ink mb-1">Opening Balances</h2><p class="text-sm text-ink-muted mb-5">The building's balances at the takeover date, from the previous manager's balance sheet. Each fund's balance sheet must come to its opening balance, and the total must equal the two funds. Enter zero for a new building with no balances.</p><div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5 mb-6"><div><label for="takeoverDate" class="block text-sm font-medium text-ink mb-1.5">Takeover date<span class="text-red-500 ml-0.5">*</span></label><input id="takeoverDate" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise py-2.5" type="date" value="2026-10-01"><p class="mt-1.5 text-xs text-ink-muted">The date the balances are struck at, in the year ending 30/06/2027.</p></div><div><label for="totalBalance" class="block text-sm font-medium text-ink mb-1.5">Total opening balance<span class="text-red-500 ml-0.5">*</span></label><input id="totalBalance" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums py-2.5" value="2,000"></div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="rounded-[var(--radius-card)] border border-line p-4"><h3 class="text-sm font-semibold text-ink mb-3">Administrative fund</h3><div class="space-y-3"><div><div class="flex items-center gap-3"><label for="admin-cash" class="flex-1 text-sm text-ink">Cash at bank</label><input id="admin-cash" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="1,000"></div></div><div><div class="flex items-center gap-3"><label for="admin-receivable" class="flex-1 text-sm text-ink">Levies receivable (including interest)</label><input id="admin-receivable" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="300"></div></div><div><div class="flex items-center gap-3"><label for="admin-advance" class="flex-1 text-sm text-ink"><span class="text-ink-muted">less </span>Levies paid in advance</label><input id="admin-advance" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="100"></div></div><div><div class="flex items-center gap-3"><label for="admin-creditors" class="flex-1 text-sm text-ink"><span class="text-ink-muted">less </span>Creditors</label><input id="admin-creditors" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="200"></div></div><div class="flex items-center justify-between border-t border-line pt-3 text-sm"><span class="text-ink-muted">Balance sheet comes to</span><span class="font-medium tabular-nums text-ink">$1,000.00</span></div><div><div class="flex items-center gap-3"><label for="admin-balance" class="flex-1 text-sm text-ink">Fund opening balance</label><input id="admin-balance" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums max-w-[11rem]" value="1,000"></div></div><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Reconciles with the balance sheet</span></div></div></div><div class="rounded-[var(--radius-card)] border border-line p-4"><h3 class="text-sm font-semibold text-ink mb-3">Capital works fund</h3><div class="space-y-3"><div><div class="flex items-center gap-3"><label for="capitalWorks-cash" class="flex-1 text-sm text-ink">Cash at bank</label><input id="capitalWorks-cash" inputmode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-