exports[`4. issuing NSW and Queensland notices > d. the Queensland schedule page: approved, planned and overdue > approved 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><a class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-2" href="/adviser/schemes/q2-qld-no-bank/finance/levies"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Contributions</a><h1 class="text-2xl font-bold font-heading text-ink mb-1">FY 2026 contribution schedule</h1></div></div><div class="flex flex-wrap items-center gap-3"><span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-blue-100 text-blue-700">Approved</span><span class="text-xs text-ink-muted">Budget contribution</span></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Details</h2></div></div><dl class="grid grid-cols-1 gap-4 px-6 pb-6 sm:grid-cols-2 lg:grid-cols-3"><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Fund</dt><dd class="mt-1 text-sm text-ink">—</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Financial year</dt><dd class="mt-1 text-sm text-ink">Starts 1 July 2026</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Frequency</dt><dd class="mt-1 text-sm text-ink">Quarterly</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Budget amount</dt><dd class="mt-1 text-sm text-ink">$40,000.00</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Total lots</dt><dd class="mt-1 text-sm text-ink">2</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Total contribution schedule lot entitlement</dt><dd class="mt-1 text-sm text-ink">100</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Resolution date</dt><dd class="mt-1 text-sm text-ink">20 Apr 2026</dd></div></dl></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">2. Issue notices</h2><p class="text-sm text-ink-muted mt-0.5">One notice per lot for each of the 4 instalments, in proportion to contribution schedule lot entitlement. Amounts are rounded to the cent so they add up exactly to $40,000.00.</p></div></div><div class="px-6 pb-6 space-y-4"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-line text-left text-xs uppercase tracking-wide text-ink-muted"><th scope="col" class="py-2 font-medium">Lot</th><th scope="col" class="py-2 font-medium text-right">Contribution schedule lot entitlement</th><th scope="col" class="py-2 font-medium">Owner on platform</th><th scope="col" class="py-2 font-medium text-right">First instalment</th><th scope="col" class="py-2 font-medium text-right">Total</th></tr></thead><tbody class="divide-y divide-line"><tr><td class="py-2 text-ink">Lot 1</td><td class="py-2 text-right tabular-nums">60</td><td class="py-2 text-ink-muted">Yes</td><td class="py-2 text-right tabular-nums">$6,000.00</td><td class="py-2 text-right tabular-nums">$24,000.00</td></tr><tr><td class="py-2 text-ink">Lot 2</td><td class="py-2 text-right tabular-nums">40</td><td class="py-2 text-ink-muted">No</td><td class="py-2 text-right tabular-nums">$4,000.00</td><td class="py-2 text-right tabular-nums">$16,000.00</td></tr></tbody></table></div><form class="space-y-4" action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><p class="text-sm text-ink-muted">Contributions are paid in advance: each instalment falls due on the first day of the period it covers. Each notice goes out by email 5 weeks before it falls due. Any whose 5-week mark has passed go out today, once you confirm.</p><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Plan 8 notices</button></form></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Contribution notices</h2><p class="text-sm text-ink-muted mt-0.5">0 notices</p></div></div><div class="px-6 pb-6"><div class="rounded-[var(--radius-card)] bg-white border border-line border-dashed p-12 text-center"><h3 class="font-heading font-semibold text-ink mb-1">No contribution notices yet</h3><p class="text-sm text-ink-muted max-w-sm mx-auto mb-6">Issue the notices above.</p></div></div></div></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;

