exports[`the certificate pages > Queensland: the lot's certificates 1`] = `"<div class="space-y-6 max-w-4xl"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><a class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-2" href="/adviser/schemes/aaaaaaaa-0000-4000-8000-000000000002/lots/bbbbbbbb-0000-4000-8000-000000000002"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Lot</a><h1 class="text-2xl font-bold font-heading text-ink mb-1">Body corporate certificate: Lot 3</h1><p class="text-sm text-ink-muted">Body Corporate and Community Management Act 1997 (Qld) s 205(4). Approved form: BCCM Form 33 (form number from Queensland Government guidance).</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Certificates for this lot</h2></div></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left text-xs text-ink-muted border-b border-line"><th class="py-2 pr-3">No.</th><th class="py-2 pr-3">Requested by</th><th class="py-2 pr-3">Received</th><th class="py-2 pr-3">Issued</th><th class="py-2 pr-3 text-right">Fee</th><th class="py-2 pr-3">Status</th></tr></thead><tbody><tr class="border-b border-line last:border-0"><td class="py-2 pr-3"><a class="text-turquoise underline" href="/adviser/schemes/aaaaaaaa-0000-4000-8000-000000000002/lots/bbbbbbbb-0000-4000-8000-000000000002/certificates/cccccccc-0000-4000-8000-000000000003">2</a></td><td class="py-2 pr-3">Pat Agent</td><td class="py-2 pr-3 tabular-nums">2026-10-20</td><td class="py-2 pr-3 tabular-nums"></td><td class="py-2 pr-3 tabular-nums text-right"></td><td class="py-2 pr-3"><span class="inline-flex items-center rounded-full h-[22px] px-2.5 text-[11px] font-medium whitespace-nowrap bg-[#FFF3E0] text-[#A16207] ">Draft</span></td></tr><tr class="border-b border-line last:border-0"><td class="py-2 pr-3"><a class="text-turquoise underline" href="/adviser/schemes/aaaaaaaa-0000-4000-8000-000000000002/lots/bbbbbbbb-0000-4000-8000-000000000002/certificates/cccccccc-0000-4000-8000-000000000004">1</a></td><td class="py-2 pr-3">Sam Buyer</td><td class="py-2 pr-3 tabular-nums">2026-10-01</td><td class="py-2 pr-3 tabular-nums">2026-10-02</td><td class="py-2 pr-3 tabular-nums text-right">$86.95 due</td><td class="py-2 pr-3"><span class="inline-flex items-center rounded-full h-[22px] px-2.5 text-[11px] font-medium whitespace-nowrap bg-[#E6F7F3] text-[#1A7A63] ">Issued</span></td></tr></tbody></table></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">New certificate</h2><p class="text-sm text-ink-muted mt-0.5">StrataVerze drafts each item from its records; you check and complete every item before issuing. Fee: $86.95 (76.75 fee units), or $73.90 (65.24 fee units) for a further certificate for the same person and lot within 3 months, at the amounts for 2026-27 (Body Corporate and Community Management (Standard Module) Regulation 2020 (Qld) s 233, in fee units. Dollar amounts: Queensland Government, Fees for accessing body corporate records (updated 1 Jul 2026)). It is recorded on issue and collected outside StrataVerze.</p></div></div><form class="space-y-3" action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><div class="grid gap-3 sm:grid-cols-2"><label class="text-sm "><span class="block mb-1 font-medium text-ink">Date the request was received</span><input type="date" max="2026-10-27" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-1 focus:ring-turquoise" required="" name="requestedOn" value="2026-10-27"/></label><label class="text-sm "><span class="block mb-1 font-medium text-ink">Who is asking</span><select name="requesterType" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-1 focus:ring-turquoise" required=""><option value="OWNER" selected="">Owner</option><option value="MORTGAGEE">Mortgagee</option><option value="BUYER">Buyer</option><option value="DISCLOSURE_RECIPIENT">Person given a seller&#x27;s disclosure statement</option><option value="PROPER_INTEREST">Person with a proper interest</option><option value="AGENT">Agent</option></select></label><label class="text-sm "><span class="block mb-1 font-medium text-ink">Their name</span><input type="text" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-1 focus:ring-turquoise" required="" name="requesterName" value=""/></label><label class="text-sm "><span class="block mb-1 font-medium text-ink">Their address</span><input type="text" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-1 focus:ring-turquoise" required="" name="requesterAddress" value=""/></label><label class="text-sm "><span class="block mb-1 font-medium text-ink">If authorised: who authorised them</span><select name="authorisedByType" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-1 focus:ring-turquoise"><option value="" selected="">None</option><option value="OWNER">Owner</option><option value="MORTGAGEE">Mortgagee</option><option value="BUYER">Buyer</option><option value="DISCLOSURE_RECIPIENT">Person given a seller&#x27;s disclosure statement</option><option value="PROPER_INTEREST">Person with a proper interest</option></select></label><label class="text-sm "><span class="block mb-1 font-medium text-ink">If authorised: that person&#x27;s name</span><input type="text" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-1 focus:ring-turquoise" name="authorisedByName" value=""/></label><label class="text-sm sm:col-span-2"><span class="block mb-1 font-medium text-ink">If authorised: that person&#x27;s address</span><input type="text" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-1 focus:ring-turquoise" name="authorisedByAddress" value=""/></label></div><div class="flex justify-end"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="submit">Start draft</button></div></form></div></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;
