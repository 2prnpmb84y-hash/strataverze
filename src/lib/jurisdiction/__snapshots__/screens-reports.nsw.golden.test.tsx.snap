s-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Income and expenditure</h2><p class="text-sm text-ink-muted mt-0.5">Prior year surplus: $0.00</p></div></div><table class="w-full text-sm"><tbody class="divide-y divide-line"><tr class="font-semibold"><td class="py-1.5 pr-4">Total income</td><td class="py-1.5 text-right tabular-nums">$8,000.00</td></tr><tr class="font-semibold"><td class="py-1.5 pr-4">Total expenditure</td><td class="py-1.5 text-right tabular-nums">$3,500.00</td></tr><tr class="font-semibold"><td class="py-1.5 pr-4">Surplus (deficit)</td><td class="py-1.5 text-right tabular-nums">$4,500.00</td></tr></tbody></table></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Balance sheet at year end</h2></div></div><table class="w-full text-sm"><tbody class="divide-y divide-line"><tr class="font-semibold"><td class="py-1.5 pr-4">Owners&#x27; funds</td><td class="py-1.5 text-right tabular-nums">$9,500.00</td></tr></tbody></table></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Levy register and arrears at year end</h2><p class="text-sm text-ink-muted mt-0.5">1 notices due in the year.</p></div></div><table class="w-full text-sm"><thead><tr class="border-b border-line text-left text-ink-muted"><th scope="col" class="py-1.5 pr-4 font-medium">Lot</th><th scope="col" class="py-1.5 text-right font-medium">Unpaid at year end</th></tr></thead><tbody class="divide-y divide-line"><tr><td class="py-1.5 pr-4">Lot 3</td><td class="py-1.5 text-right tabular-nums">$2,000.00</td></tr></tbody></table><details class="mt-3 text-sm"><summary class="cursor-pointer text-turq