exports[`NSW report screens (golden) > fund projections, with a fund going into deficit 1`] = `"<div class="space-y-6"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="p-4"><div class="flex items-center gap-4"><label for="years-select" class="text-sm font-medium text-ink whitespace-nowrap">Projection period</label><select id="years-select" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors max-w-[160px]"><option value="3">3 years</option><option value="5" selected="">5 years</option><option value="7">7 years</option><option value="10">10 years</option></select></div></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Capital Works Fund</h2><p class="text-sm text-ink-muted mt-0.5">Capital Works Fund</p></div></div><div class="px-4 pb-4"><div class="grid grid-cols-2 sm:grid-cols-4 gap-3"><div class="rounded-[var(--radius-card)] bg-white border border-line p-3"><p class="text-xs text-ink-muted">Current Balance</p><p class="text-lg font-semibold text-ink mt-0.5">$1,000</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-3"><p class="text-xs text-ink-muted">Annual Levy Income</p><p class="text-lg font-semibold text-emerald-600 mt-0.5">$500</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-3"><p class="text-xs text-ink-muted">Annual Expenses</p><p class="text-lg font-semibold text-rose-600 mt-0.5">$2,000</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-3"><p class="text-xs text-ink-muted">Projected Balance (FY 2026/27)</p><p class="text-lg font-semibold mt-0.5 text-rose-600">-$500</p></div></div></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-t border-b border-line text-left"><th scope="col" class="px-4 py-3 font-medium text-ink-muted">Financial Year</th><th scope="col" class="px-4 py-3 font-medium text-ink-muted text-right">Opening</th><th scope="col" class="px-4 py-3 font-medium text-ink-muted text-right">Levy Income</th><th scope="col" class="px-4 py-3 font-medium text-ink-muted text-right">Expenses</th><th scope="col" class="px-4 py-3 font-medium text-ink-muted text-right">Net Movement</th><th scope="col" class="px-4 py-3 font-medium text-ink-muted text-right">Closing</th></tr></thead><tbody><tr class="border-b border-line hover:bg-white/30 transition-colors"><td class="px-4 py-3 font-medium text-ink">FY 2026/27</td><td class="px-4 py-3 text-right text-ink">$1,000</td><td class="px-4 py-3 text-right text-emerald-600">$500</td><td class="px-4 py-3 text-right text-rose-600">$2,000</td><td class="px-4 py-3 text-right font-medium text-rose-600">-$1,500</td><td class="px-4 py-3 text-right font-semibold text-rose-600">-$500</td></tr></tbody></table></div><div class="p-4"><p class="text-xs font-medium text-ink-muted mb-2">Balance trajectory</p><div class="flex items-end gap-1 h-16"><div class="flex-1 flex flex-col items-center gap-0.5"><div class="w-full rounded-t bg-rose-500/70" style="height:100%"></div><span class="text-[10px] text-ink-muted leading-none">2026/27</span></div></div></div><div class="mx-4 mb-4 rounded-[var(--radius-card)] border border-rose-400/50 bg-rose-50/10 p-3"><p class="text-xs font-medium text-rose-600">⚠ This fund is projected to go into deficit. Consider reviewing the levy schedule or deferring planned expenditure.</p></div></div><div class="rounded-[var(--radius-card)] border border-line p-4 text-xs text-ink-muted space-y-1"><p class="font-medium text-ink text-sm">Projection assumptions</p><ul class="list-disc list-inside space-y-0.5"><li>Projections assume current levy schedules and budget allocations remain unchanged across future financial years.</li><li>Annual levy income is sourced from active levy schedules. Where no schedule exists, budget income is used as the estimate.</li><li>Annual expenses are based on the current financial year budget. Inflation and fee increases are not factored in.</li><li>Capital works funds may accumulate over multiple years to fund planned major works. Review the capital works plan alongside these projections.</li><li>These projections are indicative only and should be reviewed with the scheme&#x27;s accountant before making financial decisions.</li></ul></div></div>"`;

exports[`NSW report screens (golden) > the GST summary 1`] = `"<div class="space-y-6"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="p-4"><div class="flex items-center gap-4 flex-wrap"><label for="quarter-select" class="text-sm font-medium text-ink whitespace-nowrap">BAS period</label><select id="quarter-select" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors max-w-[240px]"></select><span class="text-xs text-ink-muted">Q1</span></div></div></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-4"><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-rose-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">GST on Sales (1A)</p><p class="text-2xl font-bold font-heading text-ink">$0.00</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-emerald-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">GST on Purchases (1B)</p><p class="text-2xl font-bold font-heading text-ink">$0.00</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-rose-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Net GST Payable</p><p class="text-2xl font-bold font-heading text-ink">$0.00</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">BAS Summary</h2><p class="text-sm text-ink-muted mt-0.5">Amounts for Business Activity Statement preparation</p></div></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-line text-left"><th scope="col" class="px-4 py-3 font-medium text-ink-muted w-16">Label</th><th scope="col" class="px-4 py-3 font-medium text-ink-muted">Description</th><th scope="col" class="px-4 py-3 font-medium text-ink-muted text-right">Amount</th></tr></thead><tbody><tr class="bg-white/30"><td colSpan="3" class="px-4 py-2 font-semibold text-ink text-xs uppercase tracking-wider">GST on Sales</td></tr><tr class="border-b border-line "><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G1</td><td class="px-4 py-2.5 text-ink">Total sales (including any GST)</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="border-b border-line "><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G2</td><td class="px-4 py-2.5 text-ink">Export sales</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="border-b border-line "><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G3</td><td class="px-4 py-2.5 text-ink">Other GST-free sales</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="border-b border-line "><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G4</td><td class="px-4 py-2.5 text-ink">Input taxed sales</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="border-b border-line bg-white/50 font-medium"><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G9</td><td class="px-4 py-2.5 text-ink">GST on sales</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="bg-white/30"><td colSpan="3" class="px-4 py-2 font-semibold text-ink text-xs uppercase tracking-wider">GST on Purchases</td></tr><tr class="border-b border-line "><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G10</td><td class="px-4 py-2.5 text-ink">Capital purchases (including any GST)</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="border-b border-line "><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G11</td><td class="px-4 py-2.5 text-ink">Non-capital purchases (including any GST)</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="border-b border-line "><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G14</td><td class="px-4 py-2.5 text-ink">Purchases for export (no GST)</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="border-b border-line "><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G15</td><td class="px-4 py-2.5 text-ink">Purchases for input taxed sales (no GST credit)</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="border-b border-line bg-white/50 font-medium"><td class="px-4 py-2.5 font-mono text-xs text-ink-muted">G20</td><td class="px-4 py-2.5 text-ink">GST on purchases</td><td class="px-4 py-2.5 text-right text-ink">$0.00</td></tr><tr class="bg-white/50 font-semibold border-t-2 border-line"><td class="px-4 py-3 text-ink"></td><td class="px-4 py-3 text-ink">Net GST payable (G9 minus G20)</td><td class="px-4 py-3 text-right text-rose-600">$0.00</td></tr></tbody></table></div></div><div class="rounded-[var(--radius-card)] border border-line p-4 text-xs text-ink-muted space-y-1"><p class="font-medium text-ink text-sm">Important notes</p><ul class="list-disc list-inside space-y-0.5"><li>This report is a summary to assist with BAS preparation. It does not constitute tax advice.</li><li>Amounts are derived from posted journal entries only. Draft or reversed entries are excluded.</li><li>Capital purchases (G10) are not separately tracked. All purchases appear under non-capital (G11). Adjust manually if capital purchases apply.</li><li>This report should be reviewed by the scheme&#x27;s accountant before lodging the BAS with the ATO.</li><li>Levy contributions from owners are generally not subject to GST. Income from other sources (e.g. common property rental) may attract GST if the OC is registered.</li></ul></div></div>"`;

