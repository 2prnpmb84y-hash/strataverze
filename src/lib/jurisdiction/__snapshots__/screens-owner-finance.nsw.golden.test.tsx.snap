radius-card)] border border-line bg-white pl-9 pr-3 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors" value=""/></div><div class="flex rounded-[var(--radius-card)] border border-line overflow-hidden shrink-0"><button type="button" class="px-3 py-2 transition-colors bg-turquoise text-white" aria-label="Grid view"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"></rect><rect x="9" y="1" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"></rect><rect x="1" y="9" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"></rect><rect x="9" y="9" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"></rect></svg></button><button type="button" class="px-3 py-2 transition-colors bg-white text-ink-muted hover:text-ink" aria-label="List view"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 3h14M1 8h14M1 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button></div></div><p class="text-xs text-ink-muted mb-4">1 property found</p><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"><button type="button" class="group text-left rounded-[var(--radius-card)] bg-white border border-line overflow-hidden transition-all hover:shadow-md hover:border-mint focus:outline-none focus:ring-2 focus:ring-turquoise focus:ring-offset-2 disabled:opacity-60"><div class="h-2 bg-turquoise group-hover:bg-mint-soft0 transition-colors"></div><div class="p-5"><div class="flex items-start justify-between gap-2 mb-3"><span class="inline-flex items-center rounded-md bg-mint-soft px-2.5 py-1 text-xs font-semibold text-turquoise">SP 12345</span><span class="inline-flex items-center justify-center min-w-[20px] h-5 rounded-full bg-danger px-1.5 text-[10px] font-bold text-white">2</span></div><p class="text-