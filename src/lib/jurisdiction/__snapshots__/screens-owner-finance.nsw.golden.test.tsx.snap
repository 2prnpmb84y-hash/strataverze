exports[`NSW owner home, scheme page and navigation (golden) > the owner scheme page with no property 1`] = `"<div class="max-w-4xl"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><h1 class="text-2xl font-bold font-heading text-ink mb-1">My Scheme</h1><p class="text-sm text-ink-muted">View details of your Owners Corporation.</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line border-dashed p-12 text-center"><div class="flex justify-center mb-4 text-ink-muted"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></div><h3 class="font-heading font-semibold text-ink mb-1">No scheme linked</h3><p class="text-sm text-ink-muted max-w-sm mx-auto mb-6">Your strata manager or committee will add you to a scheme. Once linked, you will see your scheme details here.</p></div></div>"`;

exports[`NSW vault card and document library (golden) > the issued-by card, empty and with a notice > empty 1`] = `"<section aria-labelledby="issued-heading" class="mt-8"><div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"><div><h2 id="issued-heading" class="font-heading font-semibold text-ink">Issued by StrataVerze</h2><p class="text-sm text-ink-muted">Captured into the vault the moment StrataVerze created them. Read-only.</p></div></div><p class="rounded-[var(--radius-card)] border border-dashed border-line p-6 text-center text-sm text-ink-muted">Nothing yet. Levy notices, remittance advices, committee and statutory packs, meeting notices and confirmed minutes appear here once StrataVerze issues them.</p></section>"`;

exports[`NSW vault card and document library (golden) > the issued-by card, empty and with a notice > records 1`] = `"<section aria-labelledby="issued-heading" class="mt-8"><div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"><div><h2 id="issued-heading" class="font-heading font-semibold text-ink">Issued by StrataVerze</h2><p class="text-sm text-ink-muted">Captured into the vault the moment StrataVerze created them. Read-only.</p></div><label class="text-sm text-ink"><span class="sr-only">Show</span><select class="h-9 rounded-lg border border-line bg-white px-2 text-sm"><option value="" selected="">All kinds</option><option value="LEVY_NOTICE">Levy notice</option><option value="MINUTES">Minutes</option></select></label></div><ul class="flex flex-col gap-2"><li><button type="button" aria-expanded="false" class="flex w-full flex-col gap-1 rounded-[var(--radius-card)] bg-muted px-4 py-3 text-left transition-colors hover:bg-muted/70 sm:flex-row sm:items-center sm:justify-between"><span class="min-w-0"><span class="block truncate text-sm font-medium text-ink">Levy notice LN 1 Lot 1</span><span class="block text-xs text-ink-muted">Levy notice · captured 01/10/2026 10:00 am</span></span></button></li><li><button type="button" aria-expanded="false" class="flex w-full flex-col gap-1 rounded-[var(--radius-card)] bg-muted px-4 py-3 text-left transition-colors hover:bg-muted/70 sm:flex-row sm:items-center sm:justify-between"><span class="min-w-0"><span class="block truncate text-sm font-medium text-ink">Minutes: AGM (version 1)</span><span class="block text-xs text-ink-muted">Minutes · captured 01/10/2026 10:00 am</span></span></button></li></ul></section>"`;

exports[`NSW vault card and document library (golden) > the upload modal 1`] = `"<div class="fixed inset-0 z-50 flex items-center justify-center"><div class="absolute inset-0 bg-black/50"></div><div class="relative z-10 w-full max-w-lg mx-4 bg-white rounded-2xl shadow-xl max-h-[90vh] flex flex-col"><div class="px-6 pt-6 pb-2 flex items-center justify-between flex-shrink-0"><div class="flex items-center gap-3"><h2 class="text-lg font-heading font-semibold text-ink">Upload Documents</h2></div><button type="button" class="text-ink-muted hover:text-ink transition-colors p-1"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button></div><div class="px-6 pb-3 flex-shrink-0"><div class="flex items-center gap-2"><div class="h-1 flex-1 rounded-full bg-turquoise"></div><div class="h-1 flex-1 rounded-full bg-gray-200"></div></div><div class="flex justify-between mt-1"><span class="text-xs text-ink-muted">Select files</span><span class="text-xs text-ink-muted">Allocate details</span></div></div><div class="px-6 pb-6 flex-1 overflow-y-auto"><div class="mt-2 flex flex-col items-center justify-center rounded-[var(--radius-card)] border-2 border-dashed p-10 cursor-pointer transition-colors border-line hover:border-mint hover:bg-muted/50"><svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="mb-3 text-ink-muted"><path d="M24 32V16m0 0l-6 6m6-6l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M40 30v6a4 4 0 01-4 4H12a4 4 0 01-4-4v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><p class="text-sm font-medium text-ink mb-1">Drag and drop files here</p><p class="text-xs text-ink-muted">or click to browse</p><p class="text-xs text-ink-muted mt-2">Supports .pdf, .docx, .xlsx and more (max 30 MB each)</p></div><input type="file" multiple="" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv,.txt,.png,.jpg,.jpeg,.gif,.webp" class="hidden"/><div class="mt-4 flex justify-end"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise ">Browse Files</button></div></div></div></div>"`;
