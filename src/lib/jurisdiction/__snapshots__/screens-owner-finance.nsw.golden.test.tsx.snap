exports[`NSW adviser lists (golden) > the adviser home with no schemes 1`] = `"<div class="max-w-4xl"><h1 class="text-2xl font-bold font-heading text-ink mb-1">Adviser Dashboard</h1><p class="text-sm text-ink-muted mb-8">Oversee schemes, reporting, and operational compliance.</p><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-adviser mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Managed Schemes</p><p class="text-2xl font-bold font-heading text-ink">0</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-adviser mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Active Work Orders</p><p class="text-2xl font-bold font-heading text-ink">0</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-adviser mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Compliance Alerts</p><p class="text-2xl font-bold font-heading text-ink">0</p></div></div><div class="mt-8 rounded-[var(--radius-card)] bg-white border border-line p-6"><h2 class="font-heading font-semibold text-ink mb-2">Getting Started</h2><p class="text-sm text-ink-muted leading-relaxed">Welcome to the Adviser Portal. Create your first scheme from the <a class="text-turquoise hover:underline" href="/adviser/schemes">Schemes</a> page to begin managing owners corporations.</p></div></div>"`;

exports[`NSW adviser lists (golden) > the reporting page with a building 1`] = `"<div class="max-w-3xl"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><h1 class="text-2xl font-bold font-heading text-ink mb-1">Reporting</h1><p class="text-sm text-ink-muted">Portfolio overview across all managed schemes.</p></div></div><div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8"><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-adviser mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Schemes</p><p class="text-2xl font-bold font-heading text-ink">1</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-green-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Collection Rate</p><p class="text-2xl font-bold font-heading text-ink">63%</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-yellow-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Active Work Orders</p><p class="text-2xl font-bold font-heading text-ink">0</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-red-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Compliance Rate</p><p class="text-2xl font-bold font-heading text-ink">0%</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 mb-6"><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Financial Summary</h2><p class="text-sm text-ink-muted mt-0.5">Levy collection across all schemes.</p></div></div><div class="flex flex-col gap-3"><div class="grid grid-cols-3 gap-3"><div class="rounded-[var(--r