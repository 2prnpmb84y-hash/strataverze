exports[`NSW onboarding lots > the lots step 1`] = `"<div><h2 class="font-heading font-semibold text-ink mb-1">Lots and Owners</h2><p class="text-sm text-ink-muted mb-5">Enter every lot with its unit entitlement, and each owner&#x27;s name exactly as it appears on the strata roll (for example joint owners, or a company with its ACN).</p><div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5"><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Lots: 4 entered of 4 on the building</span></div><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-turquoise/30 bg-mint-soft/50 text-ink"><span aria-hidden="true" class="mt-px font-bold">✓</span><span class="sr-only">Passes:</span><span>Unit entitlement: 110 entered of 110 total</span></div></div><div class="overflow-x-auto rounded-[var(--radius-card)] border border-line"><table class="w-full min-w-[640px] text-sm"><thead><tr class="bg-muted/50 text-left"><th scope="col" class="px-3 py-2 font-medium text-ink-muted w-24">Lot</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted w-24">Unit No.</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted w-32">Unit Entitlement</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted">Owner name (as on the strata roll)</th><th scope="col" class="px-3 py-2 w-12"><span class="sr-only">Remove</span></th></tr></thead><tbody><tr class="border-t border-line/60 align-top"><td class="px-3 py-2"><input aria-label="Lot number, row 1" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise" value="1"/></td><td class="px-3 py-2"><input aria-label="Unit number, row 1" class="w-full min-w-0 rounded-[