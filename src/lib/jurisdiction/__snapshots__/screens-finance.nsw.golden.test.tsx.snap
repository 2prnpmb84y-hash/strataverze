exports[`NSW owner credits and budget (golden) > the budget page 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><a class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-2" href="/adviser/schemes/s1/finance"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Finance</a><h1 class="text-2xl font-bold font-heading text-ink mb-1">Budget Management</h1><p class="text-sm text-ink-muted">Harbour View — FY 2026/2027</p></div></div><div class="rounded-[var(--radius-card)] border border-line bg-white p-6"><p class="font-medium text-ink">Budget adoption</p><p class="mt-1 text-sm text-ink-muted">Budget levies can only be issued once the budget for that fund and year is adopted at a general meeting. An adopted budget is read-only; start a revision to change it, and adopt the revision at a later meeting.</p><ul class="divide-y divide-line"><li class="space-y-3 py-4 text-sm"><div class="flex flex-wrap items-center justify-between gap-2"><span><span class="font-medium text-ink">Administrative Fund</span><span class="text-ink-muted"> · no budget yet</span></span><span class="flex flex-wrap gap-2"></span></div></li></ul></div><div class="space-y-6"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Budget Settings</h2></div></div><div class="px-6 pb-6 grid grid-cols-1 sm:grid-cols-2 gap-4"><div class=""><label for="year" class="block text-sm font-medium text-ink mb-1.5">Financial Year</label><select id="year" name="year" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="2024">FY 2024/2025</option><option value="2025">FY 2025/2026</option><option value="2026" selected="">FY 2026/2027</option><option value="2027">FY 2027/2028</option><option value="2028">FY 2028/2029</option></select></div><div class=""><label for="fund" class="block text-sm font-medium text-ink mb-1.5">Fund</label><select id="fund" name="fund" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="f1" selected="">Administrative Fund</option></select></div></div></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-3"><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-blue-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Budgeted Expenditure</p><p class="text-2xl font-bold font-heading text-ink">$0.00</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-emerald-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Budgeted Income</p><p class="text-2xl font-bold font-heading text-ink">$0.00</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-violet-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Quarterly Levy</p><p class="text-2xl font-bold font-heading text-ink">$0.00</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Budget Lines</h2><p class="text-sm text-ink-muted mt-0.5">FY 2026/2027 — Administrative Fund</p></div><div class="shrink-0"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise text-sm px-3 py-1.5">Add Line</button></div></div><div class="px-6 pb-6"><div class="rounded-[var(--radius-card)] bg-white border border-line border-dashed p-12 text-center"><h3 class="font-heading font-semibold text-ink mb-1">No budget lines</h3><p class="text-sm text-ink-muted max-w-sm mx-auto mb-6">Add budget lines to set the annual budget for this fund. Budget amounts are used to calculate levy schedules.</p></div></div></div></div></div>"`;

exports[`NSW owner credits and budget (golden) > the owner credits page 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><h1 class="text-2xl font-bold font-heading text-ink mb-1">Owner Credits</h1><p class="text-sm text-ink-muted">Payments above what a levy notice owed are held as the owner&#x27;s credit for that lot, in the same fund.</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="space-y-4"><label class="flex items-start gap-2 text-sm text-ink"><input type="checkbox" class="mt-1" checked=""/><span>Apply an owner&#x27;s credit to their next levy notice automatically when notices are issued.</span></label><div class="flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button">Apply credit to open notices now</button></div></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Credit balances</h2><p class="text-sm text-ink-muted mt-0.5">Total held: $50.00</p></div></div><ul class="divide-y divide-line"><li class="space-y-2 py-4"><div class="flex flex-wrap items-baseline justify-between gap-2 text-sm"><span class="font-medium text-ink">Lot 1, Administrative Fund</span><span class="tabular-nums font-semibold">$50.00</span></div><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button">Refund credit</button></li></ul></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Refunds</h2><p class="text-sm text-ink-muted mt-0.5">A refund is approved under the scheme&#x27;s payment policy, by someone other than the person who prepared it, before it is paid.</p></div></div><p class="text-sm text-ink-muted">No refunds yet.</p></div></div>"`;

exports[`NSW reconciliation (golden) > the workbench with a deposit to match 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><h1 class="text-2xl font-bold font-heading text-ink mb-1">Bank Reconciliation</h1><p class="text-sm text-ink-muted">Allocate each bank transaction to what it paid for. One deposit can cover several levy notices, and one entry can take several payments.</p></div></div><div class=""><label for="account" class="block text-sm font-medium text-ink mb-1.5">Bank account</label><select id="account" name="account" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="">Choose an account</option><option value="b1" selected="">Operating (BSB 062-000, 1234)</option></select></div><div class="grid grid-cols-2 gap-4 sm:grid-cols-4"><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-amber-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">To match</p><p class="text-2xl font-bold font-heading text-ink">1</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-blue-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Matched</p><p class="text-2xl font-bold font-heading text-ink">0</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-green-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Reconciled</p><p class="text-2xl font-bold font-heading text-ink">0</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-red-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">In suspense</p><p class="text-2xl font-bold font-heading text-ink">0</p></div></div><div class="space-y-6"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">To match</h2><p class="text-sm text-ink-muted mt-0.5">1 transaction, $305.00 not yet allocated. Split a deposit across levy notices, combine payments against one entry, or park what you cannot identify in suspense.</p></div></div><ul class="divide-y divide-line"><li class="py-3"><div class="flex flex-wrap items-start justify-between gap-2 text-sm"><span class="min-w-0"><span class="font-medium text-ink">2 Oct 2026</span> · Deposit lot 1<span class="text-ink-muted"> · LN-1</span></span><span class="flex items-center gap-2"><span class="tabular-nums font-semibold text-green-700">$305.00</span><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button">Allocate</button><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none text-ink-muted hover:text-ink hover:bg-muted focus:ring-turquoise " type="button">Exclude</button></span></div></li></ul></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Matched, ready to reconcile</h2><p class="text-sm text-ink-muted mt-0.5">Check each against the statement, then mark it reconciled.</p></div></div><p class="text-sm text-ink-muted">Nothing is waiting.</p></div><div id="suspense"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Suspense</h2><p class="text-sm text-ink-muted mt-0.5">Unidentified amounts. Each must be cleared to the right account before the period it falls in can be closed.</p></div></div><p class="text-sm text-ink-muted">Nothing is in suspense.</p></div></div></div></div>"`;

exports[`NSW reconciliation (golden) > with no bank account 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><h1 class="text-2xl font-bold font-heading text-ink mb-1">Bank Reconciliation</h1><p class="text-sm text-ink-muted">Allocate each bank transaction to what it paid for. One deposit can cover several levy notices, and one entry can take several payments.</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line border-dashed p-12 text-center"><h3 class="font-heading font-semibold text-ink mb-1">No bank accounts</h3><p class="text-sm text-ink-muted max-w-sm mx-auto mb-6">Add a bank account and import transactions before reconciling.</p><a class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " href="/adviser/schemes/s1/finance/bank-accounts/new">Add Bank Account</a></div></div>"`;
