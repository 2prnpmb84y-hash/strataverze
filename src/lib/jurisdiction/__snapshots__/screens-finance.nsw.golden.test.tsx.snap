exports[`NSW finance documents (golden) > the new periods page 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><a class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-2" href="/adviser/schemes/s1/finance/periods"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Periods</a><h1 class="text-2xl font-bold font-heading text-ink mb-1">Generate Financial Periods</h1><p class="text-sm text-ink-muted">Create monthly accounting periods for a financial year. This will generate 12 monthly periods between the start and end dates.</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Financial Year</h2><p class="text-sm text-ink-muted mt-0.5">Enter the start and end dates for the financial year. Monthly periods will be generated automatically.</p></div></div><form class="px-6 pb-6 space-y-4"><div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><div class=""><label for="startDate" class="block text-sm font-medium text-ink mb-1.5">Financial Year Start<span class="text-red-500 ml-0.5">*</span></label><input id="startDate" type="date" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="startDate" value="2026-07-01"/><p class="mt-1.5 text-xs text-ink-muted">Typically 1 July for NSW strata schemes</p></div><div class=""><label for="endDate" class="block text-sm font-medium text-ink mb-1.5">Financial Year End<span class="text-red-500 ml-0.5">*</span></label><input id="endDate" type="date" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="endDate" value="2027-06-30"/><p class="mt-1.5 text-xs text-ink-muted">Typically 30 June of the following year</p></div></div><div class="rounded-[var(--radius-card)] bg-blue-50 border border-blue-200 px-4 py-3 text-sm text-blue-700">This will create 12 monthly periods between the selected dates. Each period will be set to “Open” status, allowing journal entries to be posted against them.</div><div class="flex items-center gap-3 pt-2"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Generate 12 Monthly Periods</button><a class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " href="/adviser/schemes/s1/finance/periods">Cancel</a></div></form></div></div>"`;

exports[`NSW finance documents (golden) > the upload page 1`] = `"<div class="space-y-6"><h2 class="text-xl font-semibold tracking-tight">Upload Financial Document</h2><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Document Details</h2><p class="text-sm text-ink-muted mt-0.5">Upload a receipt, invoice, bank statement, or other financial document.</p></div></div><div class="px-6 pb-6"><form class="space-y-4"><div class=""><label for="documentType" class="block text-sm font-medium text-ink mb-1.5">Document Type<span class="text-red-500 ml-0.5">*</span></label><select id="documentType" name="documentType" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="RECEIPT">Receipt</option><option value="INVOICE">Invoice</option><option value="BANK_STATEMENT">Bank Statement</option><option value="LEVY_NOTICE">Levy Notice</option><option value="INSURANCE">Insurance</option><option value="CONTRACTOR_QUOTE">Contractor Quote</option><option value="TAX_DOCUMENT">Tax Document</option><option value="OTHER">Other</option></select></div><div><label for="file" class="block text-sm font-medium text-ink mb-1.5">File<span class="text-red-500 ml-0.5">*</span></label><input id="file" type="file" required="" accept=".pdf,.png,.jpg,.jpeg,.heic" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2.5 text-sm text-ink file:mr-4 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-mint-soft file:text-turquoise hover:file:bg-mint focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors" name="file"/><p class="mt-1.5 text-xs text-ink-muted">Max 10 MB. PDF, PNG, JPG, JPEG, HEIC accepted.</p></div><div class=""><label for="documentDate" class="block text-sm font-medium text-ink mb-1.5">Document Date</label><input id="documentDate" type="date" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="documentDate"/><p class="mt-1.5 text-xs text-ink-muted">The date shown on the document (e.g. invoice date, receipt date).</p></div><div class=""><label for="amount" class="block text-sm font-medium text-ink mb-1.5">Amount</label><input id="amount" type="number" placeholder="0.00" step="0.01" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="amount"/><p class="mt-1.5 text-xs text-ink-muted">The monetary amount on the document, if applicable.</p></div><div class=""><label for="payerName" class="block text-sm font-medium text-ink mb-1.5">Payer Name</label><input id="payerName" type="text" placeholder="e.g. John Smith" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="payerName"/><p class="mt-1.5 text-xs text-ink-muted">Name of the person or entity who paid, if applicable.</p></div><div class=""><label for="payeeReference" class="block text-sm font-medium text-ink mb-1.5">Payee / Reference</label><input id="payeeReference" type="text" placeholder="e.g. INV-2025-001" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="payeeReference"/><p class="mt-1.5 text-xs text-ink-muted">Reference number or payee details, if applicable.</p></div><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Upload Document</button></form></div></div></div>"`;

exports[`NSW finance overview and tabs (golden) > the finance tabs 1`] = `"<div><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><h1 class="text-2xl font-bold font-heading text-ink mb-1">Financial Management</h1></div></div><div class="flex gap-1 mb-6 border-b border-line overflow-x-auto"><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance">Overview</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/accounts">Chart of Accounts</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/bank-accounts">Bank Accounts</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-turquoise" href="/adviser/schemes/s1/finance/levies">Levies<span class="absolute bottom-0 left-0 right-0 h-0.5 bg-turquoise rounded-t"></span></a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/invoices">Invoices</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/suppliers">Suppliers</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/journal">Journal</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/bank-import">Bank Import</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/reconciliation">Reconciliation</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/matching-rules">Matching Rules</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/budget">Budget</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/capital-works">Capital Works Plan</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/interest">Interest</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/owner-credits">Owner Credits</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/periods">Periods</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/reports">Reports</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/documents">Documents</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/migration">Migration</a><a class="px-4 py-2.5 text-sm font-medium transition-colors relative whitespace-nowrap text-ink-muted hover:text-ink" href="/adviser/schemes/s1/finance/platform-fees">StrataVerze Fees</a></div><div></div></div>"`;

exports[`NSW finance overview and tabs (golden) > the overview before the chart of accounts is set up 1`] = `"<div class="space-y-6"><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-blue-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Admin Fund</p><p class="text-2xl font-bold font-heading text-ink">$1,000.00</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-emerald-500 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Capital Works Fund</p><p class="text-2xl font-bold font-heading text-ink">$2,000.00</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-zinc-300 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Overdue Levies</p><p class="text-2xl font-bold font-heading text-ink">$0.00</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-5"><div class="w-2.5 h-2.5 rounded-full bg-zinc-300 mb-3"></div><p class="text-xs text-ink-muted font-medium uppercase tracking-wide mb-1">Overdue Invoices</p><p class="text-2xl font-bold font-heading text-ink">$0.00</p></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Funds</h2><p class="text-sm text-ink-muted mt-0.5">2 funds configured.</p></div><div class="shrink-0"><a class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " href="/adviser/schemes/s1/funds/new">Manage Funds</a></div></div><div class="flex flex-col gap-2"><a class="flex items-center justify-between rounded-[var(--radius-card)] bg-muted px-4 py-3 hover:bg-muted/70 transition-colors" href="/adviser/schemes/s1/funds/f1"><div><p class="text-sm font-medium text-ink">Administrative Fund</p><p class="text-xs text-ink-muted">Administrative Fund</p></div><span class="text-sm font-medium text-ink font-variant-numeric tabular-nums">$1,000.00</span></a><a class="flex items-center justify-between rounded-[var(--radius-card)] bg-muted px-4 py-3 hover:bg-muted/70 transition-colors" href="/adviser/schemes/s1/funds/f2"><div><p class="text-sm font-medium text-ink">Capital Works Fund</p><p class="text-xs text-ink-muted">Capital Works Fund</p></div><span class="text-sm font-medium text-ink font-variant-numeric tabular-nums">$2,000.00</span></a></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Levies</h2><p class="text-sm text-ink-muted mt-0.5">No levies raised yet.</p></div><div class="shrink-0"><div class="flex flex-wrap gap-2"><a class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " href="/adviser/schemes/s1/finance/levies/special/new">Raise Special Levy</a><a class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " href="/adviser/schemes/s1/finance/levies">Go to Levies</a></div></div></div><p class="text-sm text-ink-muted">Create a budget levy schedule or raise a special levy under Financials.</p></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Get started</h2><p class="text-sm text-ink-muted mt-0.5">Complete these steps to set up financial management for this scheme.</p></div></div><div class="space-y-3"><a class="flex items-center gap-4 rounded-[var(--radius-card)] px-3 py-3 hover:bg-muted/50 transition-colors" href="/adviser/schemes/s1/finance/accounts"><span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold bg-muted text-ink-muted">1</span><div class="min-w-0 flex-1"><p class="text-sm font-medium text-ink">Seed chart of accounts</p><p class="text-xs text-ink-muted">Create the default NSW strata account codes</p></div><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 text-ink-muted"><path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a class="flex items-center gap-4 rounded-[var(--radius-card)] px-3 py-3 hover:bg-muted/50 transition-colors" href="/adviser/schemes/s1/finance/bank-accounts"><span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold bg-muted text-ink-muted">2</span><div class="min-w-0 flex-1"><p class="text-sm font-medium text-ink">Link bank account</p><p class="text-xs text-ink-muted">Add the scheme&#x27;s operating bank account</p></div><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 text-ink-muted"><path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a class