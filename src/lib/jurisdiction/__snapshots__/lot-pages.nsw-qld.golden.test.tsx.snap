ss="min-w-0"><dt class="text-xs text-ink-muted">Owner (strata roll)</dt><dd class="break-words text-ink">J CITIZEN</dd></div><div class="min-w-0"><dt class="text-xs text-ink-muted">Email</dt><dd class="break-words text-ink">j@example.com</dd></div><div class="min-w-0"><dt class="text-xs text-ink-muted">Mobile</dt><dd class="break-words text-ink">—</dd></div><div class="min-w-0"><dt class="text-xs text-ink-muted">Phone</dt><dd class="break-words text-ink">—</dd></div><div class="min-w-0"><dt class="text-xs text-ink-muted">Postal address</dt><dd class="break-words text-ink">—</dd></div><div class="min-w-0"><dt class="text-xs text-ink-muted">Last settled</dt><dd class="break-words text-ink">—</dd></div><div class="min-w-0"><dt class="text-xs text-ink-muted">Unit entitlement</dt><dd class="break-words text-ink">40</dd></div></dl></div></div>"`;

