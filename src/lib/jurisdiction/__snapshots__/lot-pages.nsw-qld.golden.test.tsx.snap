cx="10" cy="8" r="5"></circle></svg>Change owner</button></div><div><section data-tab="details"><div class="space-y-6"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Bank Account</h2></div></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><div><dl class="text-sm space-y-2"><div><dt class="text-ink-muted text-xs mb-0.5">BSB</dt><dd class="text-ink font-medium">—</dd></div><div><dt class="text-ink-muted text-xs mb-0.5">Account</dt><dd class="text-ink font-medium">—</dd></div></dl></div><div><div class="h-32 flex items-center justify-center rounded-[var(--radius-card)] bg-muted text-xs text-ink-muted">Reconciliation chart coming soon</div></div></div></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">S/Plan Details</h2></div></div><dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm"><div><dt class="text-ink-muted text-xs mb-0.5">S/Plan</dt><dd class="text-ink font-medium">SP 12345</dd></div><div><dt class="text-ink-muted text-xs mb-0.5">Lot</dt><dd class="text-ink font-medium">1</dd></div><div><dt class="text-ink-muted text-xs mb-0.5">Unit No.</dt><dd class="text-ink font-medium">3</dd></div><div><dt class="text-ink-muted text-xs mb-0.5">Street No</dt><dd class="text-ink font-medium">—</dd></div><div><dt class="text-ink-muted text-xs mb-0.5">Street Name</dt><dd class="text-ink font-medium">1 Harbour St</dd></div><div><dt class="text-ink-muted text-xs mb-0.5">Suburb</dt><dd class="text-ink font-medium">Sydney</dd></div><div><dt class="text-ink-muted text-xs mb-0.5">Accessory Unit</dt><dd class="text-ink font-medium">—</dd></div><div><dt class="text-ink-muted text-xs mb-0.5">Contribution Schedule Lot Entitlement</dt><dd c