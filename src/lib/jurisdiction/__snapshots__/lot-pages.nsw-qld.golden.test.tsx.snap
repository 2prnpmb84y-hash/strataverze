t" placeholder="Search by email or name..." class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors" value=""/></div></div></div></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Debt Collection</h2></div></div><form class="space-y-5"><div class=""><label for="stage" class="block text-sm font-medium text-ink mb-1.5">Stage</label><select id="stage" name="stage" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="NONE" selected="">None</option><option value="LETTER_1">Letter 1</option><option value="LETTER_2">Letter 2</option><option value="LETTER_3">Letter 3</option><option value="LEGAL">Legal</option></select></div><div class=""><label for="notes" class="block text-sm font-medium text-ink mb-1.5">Notes</label><textarea id="notes" name="notes" placeholder="Add notes about debt collection..." rows="3" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors resize-y"></textarea></div><div class="space-y-3"><div class=""><label class="flex items-start gap-3 cursor-pointer"><input type="checkbox" class="mt-0.5 h-4 w-4 rounded border-line text-turquoise focus:ring-turquoise" name="excludeFromCollection" value="true"/><div><span class="text-sm font-medium text-ink">Exclude from Debt Collection</span></div></label></div><div class=""><label class="flex items-start gap-3 cursor-pointer"><input type="checkbox" class="mt-0.5 h-4 w-4 rounded bor