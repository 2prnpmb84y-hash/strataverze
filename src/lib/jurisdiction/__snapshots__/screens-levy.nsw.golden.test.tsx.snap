ass="text-sm font-medium text-ink mb-2">Building Debt Collection</p><div class="flex items-center gap-3"><span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold bg-green-100 text-green-700">Y</span><span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold bg-muted text-ink-muted">N</span><input type="hidden" name="buildingDebtCollection" value="on"/></div></div><div class="pt-2"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Save</button></div></form></div>"`;

exports[`NSW levy schedule page (golden) > a budget levy schedule waiting for approval 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><a class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-2" href="/adviser/schemes/s1/finance/levies"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Levies</a><h1 class="text-2xl font-bold font-heading text-ink mb-1">FY 2026 levy schedule</h1></div></div><div class="flex flex-wrap items-center gap-3"><span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-zinc-100 text-zinc-600">Draft</span><span class="text-xs text-ink-muted">Budget levy</span></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Details</h2></div></div><dl class="grid grid-cols-1 gap-4 px-6 pb-6 sm:grid-cols-2 lg:grid-cols-3"><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Fund</dt><dd class="mt-1 text-sm text-ink">Administrative Fund</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Financial year</dt><dd class="mt-1 text-sm text-ink">Starts 1 July 2026</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Frequency</dt><dd class="mt-1 text-sm text-ink">Quarterly</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Budget amount</dt><dd class="mt-1 text-sm text-ink">$4,000.00</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Total lots</dt><dd class="mt-1 text-sm text-ink">2</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Total unit entitlement</dt><dd class="mt-1 text-sm text-ink">100</dd></div><div><dt class="text-xs font-medium text-ink-muted uppercase tracking-wide">Resolution date</dt><dd class="mt-1 text-sm text-ink">15 June 2026</dd></div></dl></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">1. Record approval</h2><p class="text-sm text-ink-muted mt-0.5">Contributions are set by the owners corporation at a general meeting. Record the resolution before notices are issued.</p></div></div><div class="px-6 pb-6"><form class="space-y-4" action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><div class=""><label for="resolutionDate" class="block text-sm font-medium text-ink mb-1.5">Resolution date<span class="text-red-500 ml-0.5">*</span></label><input id="resolutionDate" type="date" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="resolutionDate"/><p class="mt-1.5 text-xs text-ink-muted">Date of the general meeting at which the owners corporation set these contributions.</p></div><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Record approval</button></form></div></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Levy notices</h2><p class="text-sm text-ink-muted mt-0