ne px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="totalEntitlement" value="100"/><p class="mt-1.5 text-xs text-ink-muted">Aggregate unit entitlement in the strata plan</p></div></div><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Create Levy Schedule</button></form></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;

exports[`NSW new levy schedule and special levy pages (golden) > the new special levy page 1`] = `"<div class="max-w-3xl"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><a class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-2" href="/adviser/schemes/s1/finance/levies"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Levies</a><h1 class="text-2xl font-bold font-heading text-ink mb-1">Raise a Special Levy</h1><p class="text-sm text-ink-muted">A one-off contribution resolved by the owners corporation.</p></div></div><form class="space-y-6" action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><div class=""><label for="title" class="block text-sm font-medium text-ink mb-1.5">Title<span class="text-red-500 ml-0.5">*</span></label><input id="title" type="text" required="" placeholder="e.g. Façade remediation" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="title"/></div><div class=""><label for="description" class="block text-sm font-medium text-ink mb-1.5">Purpose</label><textarea id="description" name="description" placeholder="What the special levy is for, as resolved" rows="3" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors resize-y"></textarea></div><div class=""><label for="fundId" class="block text-sm font-medium text-ink mb-1.5">Fund<span class="text-red-500 ml-0.5">*</span></label><select id="fundId" name="fundId" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white"><option value="">Select a fund...</option><option value="f1">Administrative Fund</option><option value="f2">Capital Works Fund</option></select></div><div class=""><label for="amount" class="block text-sm font-medium text-ink mb-1.5">Total amount ($)<span class="text-red-500 ml-0.5">*</span></label><input id="amount" type="number" required="" placeholder="0.00" step="0.01" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="amount"/><p class="mt-1.5 text-xs text-ink-muted">Levied on every lot in proportion to unit entitlement.</p></div><div class="grid grid-cols-1 gap-6 sm:grid-cols-2"><div class=""><label for="resolutionDate" class="block text-sm font-medium text-ink mb-1.5">Resolution date<span class="text-red-500 ml-0.5">*</span></label><input id="resolutionDate" type="date" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="resolutionDate"/><p class="mt-1.5 text-xs text-ink-muted">Date of the general meeting that resolved the special levy.</p></div><div class=""><label for="dueDate" class="block text-sm font-medium text-ink mb-1.5">Due date<span class="text-red-500 ml-0.5">*</span></label><input id="dueDate" type="date" required="" class="w-full rounded-[var(--radius-card)] border border-line px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise transition-colors bg-white" name="dueDate"/></div></div><p class="text-sm text-ink-muted">Creating the special levy does not issue anything. You will see the amount for each lot and issue the notices on the next screen.</p><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Create Special Levy</button></form></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;

exports[`NSW onboarding income and budget screen (golden) > the levies section 1`] = `"<form class="space-y-6" noValidate=""><section class="rounded-[var(--radius-card)] border border-line bg-white p-4 sm:p-5 space-y-3"><dl class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm"><div><dt class="text-ink-muted">Takeover date</dt><dd class="font-medium text-ink">30/06/2026</dd></div><div><dt class="text-ink-muted">Last year (actuals)</dt><dd class="font-medium text-ink">1 July 2025 to 30 June 2026</dd></div><div><dt class="text-ink-muted">This year (budget and levies)</dt><dd class="font-medium text-ink">1 July 2026 to 30 June 2027</dd></div></dl><p class="text-sm text-ink-muted">Last year&#x27;s actuals are kept as comparatives for this year&#x27;s financial statements and budget. They are not posted: the fund balances in the opening balances already include last year&#x27;s result. Each fund must reconcile with its opening balance.</p><p class="rounded-[var(--radius-card)] border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">Instalment 1 was raised before the takeover and is not raised again; StrataVerze plans the rest. Bring the unpaid ones across in the cutover&#x27;s outstanding levy notices, with their original due dates.</p></section><section class="rounded-[var(--radius-card)] border border-line bg-white p-4 sm:p-5 space-y-3"><h2 class="font-heading font-semibold text-ink">Fill from the annual financial statement</h2><p class="text-sm text-ink-muted">Choose the previous manager&#x27;s annual financial statement for 1 July 2025 to 30 June 2026 (PDF). Each fund&#x27;s income and expenditure lines and opening balance are read into the tables below, for you to check. Accounts are matched by name, and the levy line goes to levy income; any other line becomes a new account with the statement&#x27;s name. Budgets you have typed are kept.</p><div class="flex flex-wrap items-center gap-3"><input type="file" accept="application/pdf,.pdf" aria-label="Annual financial statement PDF" class="text-sm"/></div></section><section class="rounded-[var(--radius-card)] border border-line bg-white p-4 sm:p-5 space-y-4"><h2 class="font-heading font-semibold text-ink">Administrative Fund</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><label class="block text-sm"><span class="text-ink-muted">Fund balance at 01/07/2025 (opening balance in last year&#x27;s statements)</span><input class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums mt-1" inputMode="decimal" placeholder="0.00" value=""/></label><div class="self-end"><div class="flex items-start gap-2 rounded-[var(--radius-card)] border px-3 py-2 text-sm border-amber-200 bg-amber-50 text-amber-900"><span aria-hidden="true" class="mt-px font-bold">!</span><span class="sr-only">Does not match yet:</span><span>Enter the opening balance. The fund must come to $0.00 at 30/06/2026.</span></div></div></div><div class="relative overflow-x-auto rounded-[var(--radius-card)] border border-line"><table class="w-full min-w-[760px] text-sm"><thead><tr class="bg-muted/50 text-left"><th scope="col" class="px-3 py-2 font-medium text-ink-muted">Account</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted w-36">Type</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted text-right w-36">Last year</th><th scope="col" class="px-3 py-2 font-medium text-ink-muted text-right w-36">Budget</th><th scope="col" class="px-3 py-2 w-10"><span class="sr-only">Remove</span></th></tr></thead><tbody><tr class="border-t border-line/60 align-top"><td class="px-3 py-2 space-y-2"><select aria-label="Account, Administrative Fund row 1" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise"><option value="__new">New account…</option><optgroup label="Income"><option value="a1" selected="">4-1000 Levy Income</option></optgroup><optgroup label="Expenditure"><option value="a2">5-1100 Insurance</option></optgroup></select><p class="text-xs text-ink-muted">The budget on this line is the levies to raise for the year.</p></td><td class="px-3 py-2"><span class="inline-block pt-2 text-ink-muted">Income</span></td><td class="px-3 py-2"><input aria-label="Last year, Administrative Fund row 1" inputMode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums" value=""/></td><td class="px-3 py-2"><input aria-label="Budget, Administrative Fund row 1" inputMode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums" value=""/></td><td class="px-3 py-2 pt-3"><button type="button" aria-label="Remove Administrative Fund row 1" class="rounded px-2 py-1 text-ink-muted hover:bg-muted hover:text-ink">✕</button></td></tr><tr class="border-t border-line/60 align-top"><td class="px-3 py-2 space-y-2"><select aria-label="Account, Administrative Fund row 2" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise"><option value="__new" selected="">New account…</option><optgroup label="Income"></optgroup><optgroup label="Expenditure"><option value="a2">5-1100 Insurance</option></optgroup></select><input aria-label="New account name, Administrative Fund row 2" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise" placeholder="Account name, as in the statements" value=""/></td><td class="px-3 py-2"><select aria-label="Income or expenditure, Administrative Fund row 2" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise"><option value="INCOME">Income</option><option value="EXPENSE" selected="">Expenditure</option></select></td><td class="px-3 py-2"><input aria-label="Last year, Administrative Fund row 2" inputMode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums" value=""/></td><td class="px-3 py-2"><input aria-label="Budget, Administrative Fund row 2" inputMode="decimal" placeholder="0.00" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise text-right tabular-nums" value=""/></td><td class="px-3 py-2 pt-3"><button type="button" aria-label="Remove Administrative Fund row 2" class="rounded px-2 py-1 text-ink-muted hover:bg-muted hover:text-ink">✕</button></td></tr></tbody><tfoot class="tabular-nums"><tr class="border-t border-line bg-muted/30"><td class="px-3 py-2 text-ink" colSpan="2">Income</td><td class="px-3 py-2 text-right">$0.00</td><td class="px-3 py-2 text-right">$0.00</td><td></td></tr><tr class="bg-muted/30"><td class="px-3 py-2 text-ink" colSpan="2">Expenditure</td><td class="px-3 py-2 text-right">$0.00</td><td class="px-3 py-2 text-right">$0.00</td><td></td></tr><tr class="bg-muted/30 font-medium"><td class="px-3 py-2 text-ink" colSpan="2">Surplus (deficit)</td><td class="px-3 py-2 text-right">$0.00</td><td class="px-3 py-2 text-right">$0.00</td><td></td></tr></tfoot></table></div><div class="flex flex-wrap gap-2"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button">Add income line</button><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-white border-[1.5px] border-turquoise text-turquoise hover:bg-turquoise/5 focus:ring-turquoise " type="button">Add expenditure line</button></div></section><section class="rounded-[var(--radius-card)] border border-line bg-white p-4 sm:p-5 space-y-3"><h2 class="font-heading font-semibold text-ink">Budget adoption</h2><fieldset class="space-y-2 text-sm"><legend class="sr-only">Was the budget adopted before the takeover?</legend><label class="flex items-start gap-2"><input type="radio" class="mt-1" name="adoption" checked=""/><span>Adopted at a general meeting held before StrataVerze took over. The budget is recorded as adopted at that meeting, and the levies as approved on that date.</span></label><label class="ml-6 block max-w-xs"><span class="text-ink-muted">Date of the meeting</span><input type="date" class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise mt-1" max="2026-06-30" value="2026-06-15"/></label><label class="flex items-start gap-2"><input type="radio" class="mt-1" name="adoption"/><span>Not adopted yet. Keep the budget as a draft for adoption at the first general meeting held in StrataVerze; the levies wait for it.</span></label></fieldset></section><section class="rounded-[var(--radius-card)] border border-line bg-white p-4 sm:p-5 space-y-3"><h2 class="font-heading font-semibold text-ink">Levies for 1 July 2026 to 30 June 2027</h2><p class="text-sm text-ink-muted">Each fund&#x27;s levies are the budget on its levy income line, shared between the lots by unit entitlement when the notices are generated. The notices are generated on the Levies page once the cutover has been run.</p><fieldset class="space-y-2 text-sm"><legend class="text-ink">Did the previous manager raise the levies for 1 July 2026 to 30 June 2027 before the takeover?</legend><label class="flex items-start gap-2"><input type="radio" class="mt-1" name="raised"/><span>No, they were not raised. Make the levy schedules for the whole year.</span></label><label class="flex items-start gap-2"><input type="radio" class="mt-1" name="raised" checked=""/><span>Yes, some or all of them. Tick those raised: they are not raised again, and their unpaid notices come across in the cutover.</span></label><div class="ml-6 space-y-1"><label class="flex items-center gap-2"><input type="checkbox" checked=""/><span>Instalment 1, due 01/07/2026</span></label><label class="flex items-center gap-2"><input type="checkbox"/><span>Instalment 2, due 01/10/2026</span></label><label class="flex items-center gap-2"><input type="checkbox"/><span>Instalment 3, due 01/01/2027</span></label><label class="flex items-center gap-2"><input type="checkbox"/><span>Instalment 4, due 01/04/2027</span></label></div></fieldset><div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl text-sm"><label class="block"><span class="text-ink-muted">How often</span><select class="w-full min-w-0 rounded-[var(--radius-card)] border border-line bg-white px-2.5 py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-turquoise focus:border-turquoise mt-1"><option value="QUARTERLY" selected="">Quarterly</option><option value="MONTHLY">Monthly</option><option value="HALF_YEARLY">Half-yearly</option><option value="ANNUALLY">Annually</option></select></label></div><p class="text-sm text-ink-muted">Levies are paid in advance, so each instalment falls due on the first day of its period: 1 July 2026, 1 October 2026, 1 January 2027, 1 April 2027. Each notice goes out 5 weeks before it falls due.</p><ul class="text-sm text-ink space-y-1"><li>Administrative Fund: $0.00 for the year</li></ul></section><div class="flex flex-wrap items-center gap-3"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Save</button><span class="text-sm text-ink-muted">2 thing(s) to complete before saving.</span><a class="text-sm text-ink-muted underline" href="/cutover">Back to the cutover</a></div></form>"`;
