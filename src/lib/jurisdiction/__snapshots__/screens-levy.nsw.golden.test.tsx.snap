exports[`NSW capital works fund plan page (golden) > with an adopted plan due for review 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><h1 class="text-2xl font-bold font-heading text-ink mb-1">Capital Works Fund Plan</h1><p class="text-sm text-ink-muted">A plan of anticipated major expenditure for at least the next 10 years, reviewed at least every 5 years (Strata Schemes Management Act 2015 (NSW) s 80; Strata Schemes Legislation Amendment Act 2025).</p></div></div><p role="alert" class="rounded-[var(--radius-card)] border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">The adopted plan was due for review by 2021-07-01. Open it and start the review.</p><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Plans</h2></div></div><ul class="divide-y divide-line"><li class="flex flex-wrap items-baseline justify-between gap-2 py-3 text-sm"><a class="font-medium text-ink underline" href="/adviser/schemes/s1/finance/capital-works/p1">Capital works fund plan</a><span class="text-ink-muted">Adopted · FY 2016 to FY 2025 · $1,000.00 planned · review due 2021-07-01</span></li></ul></div><div class="rounded-[var(--radius-card)] bg-white border border-line p-6 "><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Prepare a new plan</h2><p class="text-sm text-ink-muted mt-0.5">From 1 April 2026 a new or reviewed plan must follow the NSW standard form. Record the items from that form here.</p></div></div><form class="grid gap-3 sm:grid-cols-2" action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><label class="text-sm text-ink"><span class="mb-1 block font-medium">Title</span><input required="" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink" name="title" value="Capital works fund plan"/></label><label class="text-sm text-ink"><span class="mb-1 block font-medium">Prepared by (person or firm)</span><input class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink" name="preparedBy"/></label><label class="text-sm text-ink"><span class="mb-1 block font-medium">Date prepared</span><input type="date" required="" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink" name="preparedAt" value="2026-10-27"/></label><label class="text-sm text-ink"><span class="mb-1 block font-medium">First financial year (FY starting 1 July)</span><input type="number" min="2000" max="2100" required="" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink" name="periodStartYear" value="2026"/></label><label class="text-sm text-ink"><span class="mb-1 block font-medium">Capital works fund balance at the start</span><input type="number" step="0.01" min="0" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink" name="openingBalance" value="0"/></label><label class="text-sm text-ink"><span class="mb-1 block font-medium">How the yearly contribution is worked out</span><select name="method" class="w-full rounded-[var(--radius-card)] border border-line bg-white px-3 py-2 text-sm text-ink"><option value="LEVEL" selected="">Level contribution (keeps the fund above zero every year)</option><option value="AVERAGE">Average over the plan</option></select></label><div class="flex items-center gap-3 sm:col-span-2"><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="submit">Create plan</button></div></form></div></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;

