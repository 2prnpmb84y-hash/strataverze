exports[`NSW e-voting and debt collection sections (golden) > the e-voting section, not adopted and adopted > adopted 1`] = `"<div class="rounded-[var(--radius-card)] bg-white border border-line p-6 mb-6"><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Pre-meeting electronic voting</h2><p class="text-sm text-ink-muted mt-0.5">Open a ballot so owners can vote on the agenda before the meeting.</p></div></div><div class="space-y-3"><p class="text-sm text-ink-muted">Owners will be able to vote from 7 days before the meeting until the close (24 hours before, or at the meeting for a committee meeting).</p><button class="inline-flex items-center justify-center gap-2 rounded-full px-6 h-10 text-[13px] font-semibold uppercase tracking-[0.04em] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-turquoise text-white hover:bg-turquoise/90 focus:ring-turquoise " type="button">Open ballot</button></div></div>"`;

exports[`NSW e-voting and debt collection sections (golden) > the e-voting section, not adopted and adopted > not adopted 1`] = `"<div class="rounded-[var(--radius-card)] bg-white border border-line p-6 mb-6"><div class="flex items-start justify-between gap-4 mb-4"><div><h2 class="font-heading font-semibold text-base text-ink">Pre-meeting electronic voting</h2><p class="text-sm text-ink-muted mt-0.5">Open a ballot so owners can vote on the agenda before the meeting.</p></div></div><p class="text-sm text-ink-muted">The owners corporation has not resolved to adopt pre-meeting electronic voting, so a ballot cannot be opened. This is a configurable scheme setting backed by the adopting resolution (Reg cl 14).</p></div>"`;

