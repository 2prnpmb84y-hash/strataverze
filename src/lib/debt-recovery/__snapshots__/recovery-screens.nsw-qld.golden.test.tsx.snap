exports[`the adviser case page > QLD: a closed case at its current step 1`] = `"<div class="space-y-6"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8"><div><a class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-2" href="/adviser/schemes/qld-1/finance/debt-recovery"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back to debt recovery</a><h1 class="text-2xl font-bold font-heading text-ink mb-1">DR-2026-0001</h1><p class="text-sm text-ink-muted">Lot 1 (Unit 3) — Dee Btor</p></div><div class="shrink-0"><span class="inline-flex items-center rounded-full h-[22px] px-2.5 text-[11px] font-medium whitespace-nowrap bg-[#E6F7F3] text-[#1A7A63] ">Closed</span></div></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-4"><div class="rounded-xl bg-white border border-gray-100 p-3"><p class="text-xs text-gray-500">Principal</p><p class="text-base font-semibold text-gray-900 tabular-nums">$1,200.00</p></div><div class="rounded-xl bg-white border border-gray-100 p-3"><p class="text-xs text-gray-500">Penalty</p><p class="text-base font-semibold text-gray-900 tabular-nums">$35.50</p></div><div class="rounded-xl bg-white border border-gray-100 p-3"><p class="text-xs text-gray-500">Costs</p><p class="text-base font-semibold text-gray-900 tabular-nums">$0.00</p></div><div class="rounded-xl bg-turquoise/5 border border-turquoise/20 p-3"><p class="text-xs text-turquoise">Total Owing</p><p class="text-base font-semibold text-turquoise tabular-nums">$1,235.50</p></div></div><div class="rounded-xl bg-white border border-gray-100 p-4"><div class="flex items-center justify-between mb-3"><p class="text-sm font-medium text-gray-900">Recovery Progress</p><p class="text-xs text-gray-500">3 of 10 steps completed</p></div><div class="flex items-