// ─── Works Module: Quotations & Evaluation ──────────────────────

model WorksQuotation {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rfqId                 String                  @map("rfq_id") @db.Uuid
  contractorBusinessId  String                  @map("contractor_business_id") @db.Uuid
  quotationNumber       String                  @map("quotation_number") @db.VarChar(30)
  currentVersion        Int                     @default(1) @map("current_version")
  subtotal              Decimal                 @db.Decimal(12, 2)
  gstAmount             Decimal                 @default(0) @db.Decimal(12, 2) @map("gst_amount")
  totalAmount           Decimal                 @db.Decimal(12, 2) @map("total_amount")
  validUntil            DateTime?               @db.Timestamptz @map("valid_until")
  estimatedDuration     Int?                    @map("estimated_duration") // days
  methodology           String?
  inclusions            String?
  exclusions            String?
  conditions            String?
  status                String                  @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, SHORTLISTED, ACCEPTED, DECLINED, WITHDRAWN, SUPERSEDED
  submittedAt           DateTime?               @db.Timestamptz @map("submitted_at")
  /// The contractor's own quote document (works stage 3), a storage path.
  documentPath          String?                 @map("document_path")
  documentName          String?                 @map("document_name") @db.VarChar(500)
  createdAt             DateTime                @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime                @updatedAt @db.Timestamptz @map("updated_at")

  rfq                   WorksRfq                @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  contractorBusiness    ContractorBusiness       @relation(fields: [contractorBusinessId], references: [id])
  versions              WorksQuotationVersion[]
  lineItems             WorksQuotationLineItem[]
  evaluations           WorksEvaluation[]
  decisions             WorksDecision[]
  recommendations       WorksRecommendation[]
  approvalWorkflows     WorksApprovalWorkflow[]
  contracts             WorksContract[]

  @@unique([rfqId, contractorBusinessId])
  @@index([rfqId, status])
  @@map("works_quotations")
}

model WorksQuotationVersion {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId     String          @map("quotation_id") @db.Uuid
  versionNumber   Int             @map("version_number")
  subtotal        Decimal         @db.Decimal(12, 2)
  gstAmount       Decimal         @default(0) @db.Decimal(12, 2) @map("gst_amount")
  totalAmount     Decimal         @db.Decimal(12, 2) @map("total_amount")
  methodology     String?
  inclusions      String?
  exclusions      String?
  conditions      String?
  changeReason    String?         @map("change_reason")
  createdAt       DateTime        @default(now()) @db.Timestamptz @map("created_at")

  quotation       WorksQuotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, versionNumber])
  @@map("works_quotation_versions")
}

model WorksQuotationLineItem {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId     String          @map("quotation_id") @db.Uuid
