  status                String                   @default("SUBMITTED") // SUBMITTED, UNDER_ASSESSMENT, FURTHER_INFORMATION, DISPUTED, APPROVED, PAYMENT_INSTRUCTED, PAID, RECONCILED
  assessedById          String?                  @map("assessed_by_id") @db.Uuid
  assessedAt            DateTime?                @db.Timestamptz @map("assessed_at")
  assessmentNotes       String?                  @map("assessment_notes")
  differenceReasons     String?                  @map("difference_reasons")
  documentUrl           String?                  @map("document_url")
  /// The work order invoiced (works stage 4, 25 Oct 2026).
  workOrderId           String?                  @map("work_order_id") @db.Uuid
  /// The contractor's own invoice document (storage path and file name).
  documentPath          String?                  @map("document_path")
  documentName          String?                  @map("document_name") @db.VarChar(500)
  /// Why the invoice is more than the work order's not-to-exceed amount.
  excessReason          String?                  @map("excess_reason")
  /// Why the building sent the invoice back.
  returnReason          String?                  @map("return_reason")
  /// Who chose the fund and account and sent it to finance.
  codedById             String?                  @map("coded_by_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime                 @updatedAt @db.Timestamptz @map("updated_at")

  workOrder             WorksWorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: NoAction)
  codedBy               Profile?                 @relation("WorksInvoiceCodedBy", fields: [codedById], references: [id], onDelete: SetNull)
  supplierInvoices      SupplierInvoice[]
  variationDecisions    WorksDecision[]
  request               WorksRequest?            @relation(fields: [requestId], references: [id])
  contract              WorksContract?           @relation(fields: [contractId], references: [id])
  milestone             WorksMilestone?          @relation(fields: [milestoneId], references: [id])
  scheme                Scheme                   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  contractorBusiness    ContractorBusiness        @relation(fields: [contractorBusinessId], references: [id])
  submittedBy           Profile                  @relation("WorksInvoiceSubmittedBy", fields: [submittedById], references: [id])
  assessedBy            Profile?                 @relation("WorksInvoiceAssessedBy", fields: [assessedById], references: [id])
  duplicateOf           WorksInvoice?            @relation("WorksInvoiceDuplicate", fields: [duplicateOfId], references: [id])
  duplicates            WorksInvoice[]           @relation("WorksInvoiceDuplicate")
  paymentAssessments    WorksPaymentAssessment[]
  paymentInstructions   WorksPaymentInstruction[]
  documents             WorksDocument[]

  @@index([schemeId, status])
  @@index([contractorBusinessId])
  @@index([contractId])
  @@index([workOrderId])
  @@map("works_invoices")
}

