  location        String?               @db.VarChar(500)
  priority        String                @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  isEmergency     Boolean               @default(false) @map("is_emergency")
  estimatedCost   Decimal?              @db.Decimal(12, 2) @map("estimated_cost")
  status          String                @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, SCOPE_PREPARATION, PROCUREMENT, APPROVAL, DELIVERY, CLOSE_OUT, CLOSED
  isUrgent        Boolean               @default(false) @map("is_urgent")
