  @@map("works_completion_submissions")
}

// ─── Works Module: Invoices & Payments ──────────────────────────

model WorksInvoice {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId             String?                  @map("request_id") @db.Uuid
  contractId            String?                  @map("contract_id") @db.Uuid
  milestoneId           String?                  @map("milestone_id") @db.Uuid
  schemeId              String                   @map("scheme_id") @db.Uuid
  contractorBusinessId  String                   @map("contractor_business_id") @db.Uuid
  submittedById         String                   @map("submitted_by_id") @db.Uuid
  invoiceNumber         String                   @map("invoice_number") @db.VarChar(50)
  invoiceDate           DateTime                 @db.Date @map("invoice_date")
  dateReceived          DateTime                 @db.Date @map("date_received")
  dueDate               DateTime                 @db.Date @map("due_date")
  claimedAmount         Decimal                  @db.Decimal(12, 2) @map("claimed_amount")
  gstAmount             Decimal                  @default(0) @db.Decimal(12, 2) @map("gst_amount")
  assessedAmount        Decimal?                 @db.Decimal(12, 2) @map("assessed_amount")
  scheduledAmount       Decimal?                 @db.Decimal(12, 2) @map("scheduled_amount")
  approvedAmount        Decimal?                 @db.Decimal(12, 2) @map("approved_amount")
  paidAmount            Decimal                  @default(0) @db.Decimal(12, 2) @map("paid_amount")
  variationReferences   String[]                 @map("variation_references")
  isDuplicate           Boolean                  @default(false) @map("is_duplicate")
  duplicateOfId         String?                  @map("duplicate_of_id") @db.Uuid
  isStatutoryClaim      Boolean                  @default(false) @map("is_statutory_claim")
  bankDetailChangeFlag  Boolean                  @default(false) @map("bank_detail_change_flag")
  responseDeadline      DateTime?                @db.Timestamptz @map("response_deadline")
  status                String                   @default("SUBMITTED") // SUBMITTED, UNDER_ASSESSMENT, FURTHER_INFORMATION, DISPUTED, APPROVED, PAYMENT_INSTRUCTED, PAID, RECONCILED
  assessedById          String?                  @map("assessed_by_id") @db.Uuid
  assessedAt            DateTime?                @db.Timestamptz @map("assessed_at")
  assessmentNotes       String?                  @map("assessment_notes")
  differenceReasons     String?                  @map("difference_reasons")
  documentUrl           String?                  @map("document_url")
  createdAt             DateTime                 @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime                 @updatedAt @db.Timestamptz @map("updated_at")

  request               WorksRequest?            @relation(fields: [requestId], references: [id])
  contract              WorksContract?           @relation(fields: [contractId], references: [id])
  milestone             WorksMilestone?          @relation(fields: [milestoneId], references: [id])
  scheme                Scheme                   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  contractorBusiness    ContractorBusiness        @relation(fields: [contractorBusinessId], references: [id])
  submittedBy           Profile                  @relation("WorksInvoiceSubmittedBy", fields: [submittedById], references: [id])
  assessedBy            Profile?                 @relation("WorksInvoiceAssessedBy", fields: [assessedById], references: [id])
  duplicateOf           WorksInvoice?            @relation("WorksInvoiceDuplicate", fields: [duplicateOfId], references: [id])
  duplicates            WorksInvoice[]           @relation("WorksInvoiceDuplicate")
  paymentAssessments    WorksPaymentAssessment[]
  paymentInstructions   WorksPaymentInstruction[]
  documents             WorksDocument[]

  @@index([schemeId, status])
  @@index([contractorBusinessId])
  @@index([contractId])
  @@map("works_invoices")
}

model WorksPaymentAssessment {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String       @map("invoice_id") @db.Uuid
  assessorId      String       @map("assessor_id") @db.Uuid
  assessedAmount  Decimal      @db.Decimal(12, 2) @map("assessed_amount")
  previousClaims  Decimal      @default(0) @db.Decimal(12, 2) @map("previous_claims")
  previousPayments Decimal     @default(0) @db.Decimal(12, 2) @map("previous_payments")
  thisClaimAmount Decimal      @db.Decimal(12, 2) @map("this_claim_amount")
  comments        String?
  assessedAt      DateTime     @default(now()) @db.Timestamptz @map("assessed_at")
  createdAt       DateTime     @default(now()) @db.Timestamptz @map("created_at")

  invoice         WorksInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  assessor        Profile      @relation("WorksPaymentAssessor", fields: [assessorId], references: [id])

  @@index([invoiceId])
  @@map("works_payment_assessments")
}

model WorksPaymentInstruction {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId          String       @map("invoice_id") @db.Uuid
  authorisedById     String       @map("authorised_by_id") @db.Uuid
  approvedAmount     Decimal      @db.Decimal(12, 2) @map("approved_amount")
  beneficiary        String       @db.VarChar(300)
  bankDetailVersionId String?     @map("bank_detail_version_id") @db.Uuid
  authorisedAt       DateTime     @default(now()) @db.Timestamptz @map("authorised_at")
  status             String       @default("PENDING") // PENDING, EXPORTED, INVALIDATED
  invalidatedReason  String?      @map("invalidated_reason")
  exportedAt         DateTime?    @db.Timestamptz @map("exported_at")
  createdAt          DateTime     @default(now()) @db.Timestamptz @map("created_at")

  invoice            WorksInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  authorisedBy       Profile      @relation("WorksPaymentAuthorisedBy", fields: [authorisedById], references: [id])
  bankDetailVersion  WorksBankDetailVersion? @relation(fields: [bankDetailVersionId], references: [id])
  paymentRecords     WorksPaymentRecord[]

  @@index([invoiceId])
  @@map("works_payment_instructions")
}

model WorksPaymentRecord {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentInstructionId   String                  @map("payment_instruction_id") @db.Uuid
  externalReference      String?                 @map("external_reference") @db.VarChar(200)
  paymentMethod          String                  @map("payment_method") // EFT, CHEQUE, BPAY, DIRECT_DEBIT
  amount                 Decimal                 @db.Decimal(12, 2)
  paymentDate            DateTime                @db.Date @map("payment_date")
  recordedById           String                  @map("recorded_by_id") @db.Uuid
  remittanceInfo         String?                 @map("remittance_info")
  reconciliationStatus   String                  @default("UNRECONCILED") // UNRECONCILED, RECONCILED
  reconciliationEvidence String?                 @map("reconciliation_evidence")
  reconciledAt           DateTime?               @db.Timestamptz @map("reconciled_at")
  reconciledById         String?                 @map("reconciled_by_id") @db.Uuid
  createdAt              DateTime                @default(now()) @db.Timestamptz @map("created_at")

  paymentInstruction     WorksPaymentInstruction @relation(fields: [paymentInstructionId], references: [id], onDelete: Cascade)
  recordedBy             Profile                 @relation("WorksPaymentRecordedBy", fields: [recordedById], references: [id])
  reconciledBy           Profile?                @relation("WorksPaymentReconciledBy", fields: [reconciledById], references: [id])

  @@index([paymentInstructionId])
  @@map("works_payment_records")
}

model WorksBankDetailVersion {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorBusinessId  String                  @map("contractor_business_id") @db.Uuid
  versionNumber         Int                     @map("version_number")
  bsb                   String                  @db.VarChar(7)
  accountNumber         String                  @map("account_number") @db.VarChar(20)
  accountName           String                  @map("account_name") @db.VarChar(200)
  bankName              String?                 @map("bank_name") @db.VarChar(200)
  updatedById           String                  @map("updated_by_id") @db.Uuid
  verifiedById          String?                 @map("verified_by_id") @db.Uuid
  verificationMethod    String?                 @map("verification_method") // PHONE_CALLBACK, LETTER, IN_PERSON, OTHER
  status                String                  @default("PENDING") // PENDING, VERIFIED, SUPERSEDED
  verifiedAt            DateTime?               @db.Timestamptz @map("verified_at")
  createdAt             DateTime                @default(now()) @db.Timestamptz @map("created_at")

  contractorBusiness    ContractorBusiness      @relation(fields: [contractorBusinessId], references: [id], onDelete: Cascade)
  updatedBy             Profile                 @relation("WorksBankDetailUpdatedBy", fields: [updatedById], references: [id])
  verifiedBy            Profile?                @relation("WorksBankDetailVerifiedBy", fields: [verifiedById], references: [id])
  paymentInstructions   WorksPaymentInstruction[]

  @@unique([contractorBusinessId, versionNumber])
  @@index([contractorBusinessId])
  @@map("works_bank_detail_versions")
}

// ─── Works Module: Documents, Notifications & Audit ─────────────

model WorksDocument {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId       String?       @map("request_id") @db.Uuid
  contractId      String?       @map("contract_id") @db.Uuid
  invoiceId       String?       @map("invoice_id") @db.Uuid
  schemeId        String        @map("scheme_id") @db.Uuid
  documentType    String        @map("document_type") // SCOPE, RFQ, QUOTATION, CONTRACT, WORK_ORDER, INVOICE, CERTIFICATE, COMPLIANCE, SITE_REPORT, VARIATION, COMPLETION, OTHER
  title           String        @db.VarChar(300)
  fileName        String        @map("file_name") @db.VarChar(500)
  fileUrl         String        @map("file_url")
  fileSize        Int?          @map("file_size")
  mimeType        String?       @map("mime_type") @db.VarChar(100)
  version         Int           @default(1)
  uploadedById    String        @map("uploaded_by_id") @db.Uuid
  accessLevel     String        @default("RESTRICTED") // PUBLIC, RESTRICTED, CONFIDENTIAL
  retentionDate   DateTime?     @db.Date @map("retention_date")
  createdAt       DateTime      @default(now()) @db.Timestamptz @map("created_at")
  deletedAt       DateTime?     @db.Timestamptz @map("deleted_at")

  request         WorksRequest? @relation(fields: [requestId], references: [id])
  contract        WorksContract? @relation(fields: [contractId], references: [id])
  invoice         WorksInvoice? @relation(fields: [invoiceId], references: [id])
  scheme          Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  uploadedBy      Profile       @relation("WorksDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([schemeId, documentType])
  @@index([requestId])
  @@index([contractId])
  @@map("works_documents")
}

model WorksNotification {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId       String?       @map("request_id") @db.Uuid
  schemeId        String        @map("scheme_id") @db.Uuid
  recipientId     String        @map("recipient_id") @db.Uuid
  type            String        // REQUEST_SUBMITTED, REVIEW_REQUIRED, QUOTE_RECEIVED, APPROVAL_REQUIRED, WORK_STARTED, COMPLIANCE_EXPIRING, INVOICE_RECEIVED, PAYMENT_DUE, VARIATION_REQUESTED, DEFECT_FOUND, COMPLETION_SUBMITTED, BANK_DETAIL_CHANGED
  title           String        @db.VarChar(300)
  message         String
  entityType      String?       @map("entity_type")
  entityId        String?       @map("entity_id") @db.Uuid
  isRead          Boolean       @default(false) @map("is_read")
  readAt          DateTime?     @db.Timestamptz @map("read_at")
  createdAt       DateTime      @default(now()) @db.Timestamptz @map("created_at")

  request         WorksRequest? @relation(fields: [requestId], references: [id])
  scheme          Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  recipient       Profile       @relation("WorksNotificationRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, isRead])
  @@index([schemeId])
  @@map("works_notifications")
}

model WorksAuditEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId       String?       @map("request_id") @db.Uuid
  schemeId        String        @map("scheme_id") @db.Uuid
  actorId         String        @map("actor_id") @db.Uuid
  action          String        // CREATED, UPDATED, SUBMITTED, REVIEWED, APPROVED, REJECTED, ISSUED, CLOSED, SIGNED, VERIFIED, PAID, RECONCILED, DELEGATED, VARIED, COMPLETED, ARCHIVED
  entityType      String        @map("entity_type") // WorksRequest, WorksScope, WorksRfq, WorksQuotation, WorksContract, WorksWorkOrder, WorksInvoice, WorksPayment, WorksVariation, WorksComplianceCheck, etc.
  entityId        String        @map("entity_id") @db.Uuid
  beforeValues    Json?         @map("before_values")
  afterValues     Json?         @map("after_values")
  approvalRef     String?       @map("approval_ref") @db.Uuid
  documentRef     String?       @map("document_ref") @db.Uuid
  ipAddress       String?       @map("ip_address") @db.VarChar(45)
  metadata        Json?
  createdAt       DateTime      @default(now()) @db.Timestamptz @map("created_at")

  request         WorksRequest? @relation(fields: [requestId], references: [id])
  scheme          Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  actor           Profile       @relation("WorksAuditActor", fields: [actorId], references: [id])

  @@index([schemeId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("works_audit_events")
}
