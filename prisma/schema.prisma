  plan          CapitalWorksPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, plannedYear])
  @@map("capital_works_plan_items")
}

/// A locked copy of the statutory statements pack as adopted at the AGM.
model StatutoryPackSnapshot {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId            String   @map("scheme_id") @db.Uuid
  financialYear       Int      @map("financial_year")
  meetingId           String   @map("meeting_id") @db.Uuid
  motionId            String?  @map("motion_id") @db.Uuid
  content             String
  contentHash         String   @map("content_hash")
  financialDocumentId String?  @map("financial_document_id") @db.Uuid
  adoptedBy           String   @map("adopted_by") @db.Uuid
  adoptedAt           DateTime @default(now()) @db.Timestamptz @map("adopted_at")

  @@unique([schemeId, financialYear, meetingId])
  @@map("statutory_pack_snapshots")
}

/// The bytes of a document StrataVerze generated (a PDF), base64 encoded.
/// Kept in the database behind the finance access checks, not in file storage.
model FinancialDocumentFile {
  financialDocumentId String   @id @map("financial_document_id") @db.Uuid
  contentBase64       String   @map("content_base64")
  createdAt           DateTime @default(now()) @db.Timestamptz @map("created_at")

  @@map("financial_document_files")
}

/// TC-009: the fields read from an uploaded supplier invoice, kept unchanged,
/// and the values the adviser created the invoice with after reviewing them.
model InvoiceExtraction {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId            String    @map("scheme_id") @db.Uuid
  financialDocumentId String    @map("financial_document_id") @db.Uuid
  supplierInvoiceId   String?   @map("supplier_invoice_id") @db.Uuid
  /// TEXT or OCR.
  method              String
  confidence          String
  /// The extracted fields, as read. Never updated.
  extracted           Json
  /// The values the invoice was created with.
  accepted            Json?
  /// The fields changed in review: [{ field, label, extracted, accepted }].
  corrections         Json?
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz @map("created_at")
  reviewedBy          String?   @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime? @db.Timestamptz @map("reviewed_at")

  @@index([schemeId])
  @@index([supplierInvoiceId])
  @@map("invoice_extractions")
}

/// A financial cutover from another system (Stage 7): the staged files, the
/// checks, the sign-off and what was created when it ran.
model MigrationBatch {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId     String    @map("scheme_id") @db.Uuid
  /// stratamax, strata_master, myob, xero or other.
  sourceSystem String    @map("source_system")
  cutoverDate  DateTime? @db.Date @map("cutover_date")
  /// DRAFT, SIGNED_OFF, EXECUTED.
  status       String    @default("DRAFT")
  /// Per file type: { fileName, sha256, mapping, headers, records }.
  files        Json      @default("{}")
  /// { signedOffBy, signedOffAt, sourceSystem, cutoverDate, files, acknowledgedDifferences, note }.
  signOff      Json?     @map("sign_off")
  signedOffBy  String?   @map("signed_off_by") @db.Uuid
  signedOffAt  DateTime? @db.Timestamptz @map("signed_off_at")
  /// What the run created: journal entry, counts and ids.
  results      Json?
  executedBy   String?   @map("executed_by") @db.Uuid
  executedAt   DateTime? @db.Timestamptz @map("executed_at")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt    DateTime  @default(now()) @db.Timestamptz @map("updated_at")

  @@index([schemeId])
  @@map("migration_batches")
}

/// One-time permission, written by the app after its checks, to add a second
/// authenticator ("enrol") or remove a verified one ("remove", with factorId).
/// A database trigger on auth.mfa_factors requires it, so the Supabase Auth
/// API cannot be used to skip the app's rules (security stage S4).
model MfaFactorGrant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String    @map("auth_user_id") @db.Uuid
  /// enrol or remove.
  action     String
  factorId   String?   @map("factor_id") @db.Uuid
  /// Profile id of whoever authorised it (the user, or the resetting admin).
  grantedBy  String    @map("granted_by") @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz @map("created_at")
  usedAt     DateTime? @db.Timestamptz @map("used_at")

  @@index([authUserId, action, createdAt], map: "mfa_factor_grants_user_idx")
  @@map("mfa_factor_grants")
}

/// A Supabase Auth session the app has seen (security stage S5). The id is
/// the access token's session_id. Setting revokedAt ends the Auth session too
/// (a database trigger deletes it from auth.sessions).
model AppSession {
  id              String    @id @db.Uuid
  profileId       String    @map("profile_id") @db.Uuid
  /// When the user signed in (the earliest amr timestamp).
  authenticatedAt DateTime  @db.Timestamptz @map("authenticated_at")
  firstSeenAt     DateTime  @default(now()) @db.Timestamptz @map("first_seen_at")
  lastSeenAt      DateTime  @default(now()) @db.Timestamptz @map("last_seen_at")
  revokedAt       DateTime? @db.Timestamptz @map("revoked_at")
  /// idle, absolute, revoked, signed_out.
  revokedReason   String?   @map("revoked_reason")

  @@index([profileId], map: "app_sessions_profile_idx")
  @@map("app_sessions")
}

/// Append-only security audit log (security stage S6). Insert only, through
/// recordSecurityEvent (src/lib/audit/security-audit.ts). The database
/// numbers, stamps and hash-chains each row and refuses any change or
/// deletion except the 7-year retention job.
model SecurityAuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Set by the database.
  seq            BigInt   @default(0) @unique
  /// Set by the database.
  occurredAt     DateTime @default(now()) @db.Timestamptz @map("occurred_at")
  actorProfileId String?  @map("actor_profile_id") @db.Uuid
  actorAuthId    String?  @map("actor_auth_id") @db.Uuid
  actorRole      String?  @map("actor_role")
  schemeId       String?  @map("scheme_id") @db.Uuid
  action         String
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  /// allowed, denied or failed.
  outcome        String
  reason         String?
  ipHash         String?  @map("ip_hash")
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  metadata       Json     @default("{}")
  /// Set by the database.
  prevHash       String   @default("") @map("prev_hash")
  /// Set by the database.
  rowHash        String   @default("") @map("row_hash")

  @@index([occurredAt], map: "security_audit_events_time_idx")
  @@index([schemeId, occurredAt], map: "security_audit_events_scheme_idx")
  @@index([actorProfileId, occurredAt], map: "security_audit_events_actor_idx")
  @@index([action, occurredAt], map: "security_audit_events_action_idx")
  @@map("security_audit_events")
}

/// Result of each hash chain check of the security audit log (append-only).
model SecurityAuditCheck {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Set by the database.
  checkSeq    BigInt   @default(dbgenerated("0")) @unique @map("check_seq")
  /// Set by the database.
  checkedAt   DateTime @default(now()) @db.Timestamptz @map("checked_at")
  fullCheck   Boolean  @default(false) @map("full_check")
  ok          Boolean
  rowsChecked BigInt   @map("rows_checked")
  firstBadSeq BigInt?  @map("first_bad_seq")
  headSeq     BigInt?  @map("head_seq")
  headHash    String?  @map("head_hash")
  problem     String?

  @@index([checkedAt], map: "security_audit_checks_time_idx")
  @@map("security_audit_checks")
}

/// A file upload the server prepared (security stage S3). The server chose
/// the path and checks what arrived before the file is used. See
/// src/lib/storage/uploads.ts.
model StorageUpload {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId     String    @map("scheme_id") @db.Uuid
  /// library, committee_library, insurance, claim_evidence, finance_document, payment_confirmation.
  purpose      String
  path         String    @unique
  profileId    String    @map("profile_id") @db.Uuid
  /// The original file name, as the person chose it.
  fileName     String    @map("file_name")
  declaredSize Int       @map("declared_size")
  createdAt    DateTime  @default(now()) @db.Timestamptz @map("created_at")
  expiresAt    DateTime  @db.Timestamptz @map("expires_at")
  verifiedAt   DateTime? @db.Timestamptz @map("verified_at")
  verifiedSize Int?      @map("verified_size")
  verifiedMime String?   @map("verified_mime")
  usedAt       DateTime? @db.Timestamptz @map("used_at")
  /// The record it became, or "refused".
  usedFor      String?   @map("used_for")

  @@index([schemeId, createdAt], map: "storage_uploads_scheme_idx")
  @@index([profileId, createdAt], map: "storage_uploads_profile_idx")
  @@map("storage_uploads")
}

/// One attempt at a rate-limited action (security stage S7, SEC-020). The key
/// is a keyed hash (never an email address or IP address in the clear).
/// Rows older than a day are removed hourly by pg_cron.
model RateLimitHit {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyHash String   @map("key_hash")
  hitAt   DateTime @default(now()) @db.Timestamptz @map("hit_at")

  @@index([keyHash, hitAt], map: "rate_limit_hits_key_idx")
  @@map("rate_limit_hits")
}

/// Last year's income and expenditure by fund and account, from the previous
/// manager's statements (onboarding). Comparatives only, never posted.
model PriorYearActual {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId      String   @map("scheme_id") @db.Uuid
  fundId        String   @map("fund_id") @db.Uuid
  accountCodeId String   @map("account_code_id") @db.Uuid
  financialYear Int      @map("financial_year")
  amount        Decimal  @db.Decimal(12, 2)
  source        String   @default("onboarding")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime @default(now()) @db.Timestamptz @map("updated_at")

  @@unique([fundId, accountCodeId, financialYear])
  @@index([schemeId, financialYear])
  @@map("prior_year_actuals")
}

// ─── Building vault (trial, 24 Oct 2026) ─────────────────────────────────────
// prisma/migrations/20261029_vault_trial.sql. Every table is append-only;
// times, numbers and hashes are set by database triggers.

model Vault {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId  String   @unique @map("scheme_id") @db.Uuid
  openedBy  String   @map("opened_by") @db.Uuid
  /// Set by the database.
  openedAt  DateTime @default(now()) @db.Timestamptz @map("opened_at")

  @@map("vaults")
}

model VaultRecord {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vaultId      String    @map("vault_id") @db.Uuid
  schemeId     String    @map("scheme_id") @db.Uuid
  recordType   String    @map("record_type")
  title        String
  /// UPLOAD or STRATAVERZE.
  source       String
  sourceRef    String?   @map("source_ref")
  reportedDate DateTime? @db.Date @map("reported_date")
  reportedBy   String?   @map("reported_by")
  createdBy    String?   @map("created_by") @db.Uuid
  /// Set by the database.
  createdAt    DateTime  @default(now()) @db.Timestamptz @map("created_at")

  @@unique([schemeId, sourceRef])
  @@index([schemeId, createdAt], map: "vault_records_scheme_idx")
  @@map("vault_records")
}

model VaultVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordId          String   @map("record_id") @db.Uuid
  /// Set by the database from the record.
  schemeId          String   @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("scheme_id") @db.Uuid
  /// Set by the database.
  versionNo         Int      @default(0) @map("version_no")
  /// Set by the database.
  previousVersionId String?  @map("previous_version_id") @db.Uuid
  contentHash       String   @map("content_hash")
  sizeBytes         BigInt   @map("size_bytes")
  mimeType          String   @map("mime_type")
  fileName          String   @map("file_name")
  storagePath       String   @unique @map("storage_path")
  capturedBy        String?  @map("captured_by") @db.Uuid
  /// Set by the database.
  capturedAt        DateTime @default(now()) @db.Timestamptz @map("captured_at")

  @@unique([recordId, versionNo])
  @@unique([schemeId, contentHash])
  @@map("vault_versions")
}

model VaultReceipt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId        String   @map("version_id") @db.Uuid
  /// Set by the database from the version.
  schemeId         String   @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("scheme_id") @db.Uuid
  source           String
  sourceRef        String?  @map("source_ref")
  originalFileName String   @map("original_file_name")
  receivedBy       String?  @map("received_by") @db.Uuid
  /// Set by the database.
  receivedAt       DateTime @default(now()) @db.Timestamptz @map("received_at")

  @@index([versionId, receivedAt], map: "vault_receipts_version_idx")
  @@map("vault_receipts")
}

model VaultEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId       String   @map("scheme_id") @db.Uuid
  /// Set by the database.
  seq            BigInt   @default(0)
  /// Set by the database.
  occurredAt     DateTime @default(now()) @db.Timestamptz @map("occurred_at")
  eventType      String   @map("event_type")
  recordId       String?  @map("record_id") @db.Uuid
  versionId      String?  @map("version_id") @db.Uuid
  contentHash    String?  @map("content_hash")
  actorProfileId String?  @map("actor_profile_id") @db.Uuid
  /// Canonical JSON, hashed as written.
  details        String   @default("{}")
  /// Set by the database.
  prevHash       String   @default("") @map("prev_hash")
  /// Set by the database.
  rowHash        String   @default("") @map("row_hash")

  @@unique([schemeId, seq])
  @@index([recordId, seq], map: "vault_events_record_idx")
  @@map("vault_events")
}

model VaultCheck {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId      String   @map("scheme_id") @db.Uuid
  /// Set by the database.
  checkedAt     DateTime @default(now()) @db.Timestamptz @map("checked_at")
  checkedBy     String?  @map("checked_by") @db.Uuid
  ok            Boolean
  eventsChecked Int      @map("events_checked")
  filesChecked  Int      @map("files_checked")
  headSeq       BigInt?  @map("head_seq")
  headHash      String?  @map("head_hash")
  /// JSON array of the version ids the check found missing or changed.
  failedVersions String  @default("[]") @map("failed_versions")
  problem       String?

  @@index([schemeId, checkedAt], map: "vault_checks_scheme_idx")
  @@map("vault_checks")
}

/// A building's works settings (25 Oct 2026): how many committee members
/// must agree a works decision, the urgent spending limit, and whether the
/// Adviser may decide for the committee (and up to what amount).
model WorksSettings {
  schemeId          String    @id @map("scheme_id") @db.Uuid
  /// ONE, TWO or MAJORITY (src/config/works.ts).
  approvalRule      String    @default("TWO") @map("approval_rule")
  /// Most an urgent work order may cost without quotes, GST inclusive. Null = not set, no urgent orders.
  urgentLimit       Decimal?  @db.Decimal(12, 2) @map("urgent_limit")
  adviserMayDecide  Boolean   @default(false) @map("adviser_may_decide")
  adviserLimit      Decimal?  @db.Decimal(12, 2) @map("adviser_limit")
  /// The Adviser may choose the fund and account for works invoices (works stage 4).
  adviserMayCodeInvoices Boolean @default(false) @map("adviser_may_code_invoices")
  updatedById       String?   @map("updated_by_id") @db.Uuid
  updatedAt         DateTime  @default(now()) @db.Timestamptz @map("updated_at")

  scheme            Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  updatedBy         Profile?  @relation("WorksSettingsUpdatedBy", fields: [updatedById], references: [id])

  @@map("works_settings")
}

/// The building's preferred contractor for a trade, for urgent works (25 Oct 2026).
model WorksPreferredContractor {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId              String             @map("scheme_id") @db.Uuid
  trade                 String             @db.VarChar(60)
  contractorBusinessId  String             @map("contractor_business_id") @db.Uuid
  createdById           String?            @map("created_by_id") @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz @map("created_at")

  scheme                Scheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  contractorBusiness    ContractorBusiness @relation(fields: [contractorBusinessId], references: [id])
  createdBy             Profile?           @relation("WorksPreferredCreatedBy", fields: [createdById], references: [id])

  @@unique([schemeId, trade])
  @@map("works_preferred_contractors")
}

/// A works decision put to the committee (25 Oct 2026): proposed by one
/// member and agreed by electronic vote under the building's rule, or made
/// by the Adviser where the building delegates it.
model WorksDecision {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId            String               @map("scheme_id") @db.Uuid
  requestId           String               @map("request_id") @db.Uuid
  /// ROUTE (how a request is handled); later stages add URGENT_ORDER and QUOTE.
  kind                String               @default("ROUTE")
  /// For ROUTE: URGENT, QUOTES, RETURN or DECLINE.
  outcome             String
  note                String?
  proposedById        String               @map("proposed_by_id") @db.Uuid
  /// The building's rule when it was proposed, and what it required then.
  rule                String
  requiredVotes       Int                  @map("required_votes")
  committeeSize       Int                  @map("committee_size")
  /// OPEN, DECIDED, NOT_AGREED or WITHDRAWN.
  status              String               @default("OPEN")
  decidedAt           DateTime?            @db.Timestamptz @map("decided_at")
  byDelegation        Boolean              @default(false) @map("by_delegation")
  /// For an URGENT route: the most the work order may cost (works stage 2).
  amount              Decimal?             @db.Decimal(12, 2)
  /// For a QUOTES route: what contractors see before they are invited.
  summary             String?
  /// For a QUOTE decision: the quote being approved (works stage 3).
  quotationId         String?              @map("quotation_id") @db.Uuid
  /// For a VARIATION decision: the invoice over its work order's amount (works stage 4).
  invoiceId           String?              @map("invoice_id") @db.Uuid
  createdAt           DateTime             @default(now()) @db.Timestamptz @map("created_at")

  scheme              Scheme               @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  request             WorksRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposedBy          Profile              @relation("WorksDecisionProposedBy", fields: [proposedById], references: [id])
  quotation           WorksQuotation?      @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  invoice             WorksInvoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  votes               WorksDecisionVote[]

  @@index([schemeId, status])
  @@index([requestId])
  @@map("works_decisions")
}

/// One committee member's vote on a works decision.
model WorksDecisionVote {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  decisionId  String         @map("decision_id") @db.Uuid
  voterId     String         @map("voter_id") @db.Uuid
  /// FOR or AGAINST.
  vote        String
  comment     String?
  createdAt   DateTime       @default(now()) @db.Timestamptz @map("created_at")

  decision    WorksDecision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  voter       Profile        @relation("WorksDecisionVoter", fields: [voterId], references: [id])

  @@unique([decisionId, voterId])
  @@map("works_decision_votes")
}

/// A strata committee member's training: when they were appointed, when
/// they completed the training, or why they are exempt. One row per member
/// of a scheme; the appointment date is updated when they are re-appointed.
model CommitteeTraining {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId      String    @map("scheme_id") @db.Uuid
  profileId     String    @map("profile_id") @db.Uuid
  appointedOn   DateTime  @db.Date @map("appointed_on")
  completedOn   DateTime? @db.Date @map("completed_on")
  exemption     String?   // ACSL_MEMBER, STRATA_MANAGING_AGENT, CASUAL_VACANCY_SHORT
  note          String?
  lastReminderOn DateTime? @db.Date @map("last_reminder_on") // the day the last reminder was sent (claimed so a repeated run sends none)
  appointedRecordedBy String? @map("appointed_recorded_by") @db.Uuid // the adviser who recorded the appointment date; null while it is only the date committee access began
  completedRecordedBy String? @map("completed_recorded_by") @db.Uuid // who recorded the completion (the member or an adviser)
  createdAt     DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  scheme        Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  profile       Profile   @relation("CommitteeTrainingMember", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([schemeId, profileId])
  @@map("committee_training")
}

/// The Strata Hub annual report for one AGM: when it is due, and when it
/// was reported. A row is also how an AGM held outside StrataVerze is recorded.
model AnnualReport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId       String    @map("scheme_id") @db.Uuid
  agmOn          DateTime  @db.Date @map("agm_on")
  agmRecorded    Boolean   @default(false) @map("agm_recorded") // the AGM was entered by hand (held outside StrataVerze)
  reportedOn     DateTime? @db.Date @map("reported_on")
  reference      String?   // the Strata Hub receipt or reference
  reportedBy     String?   @map("reported_by") @db.Uuid
  note           String?
  lastReminderOn DateTime? @db.Date @map("last_reminder_on")
  createdAt      DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  scheme         Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, agmOn])
  @@map("annual_reports")
}

/// A building selector value an adviser recorded (VIC, ACT and WA stage 2, PR 2), for a selector the building's rule pack
/// lists in BUILDING_SELECTORS as RECORDED. The allowed values are checked in the app from the pack
/// (src/lib/jurisdiction/building-selectors.ts); a state change deletes the building's rows. Queensland's regulation
/// module and plan format keep their own columns on schemes.
model SchemeSelectorValue {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId   String   @map("scheme_id") @db.Uuid
  key        String // the selector's key in the pack, for example "schemeType"
  value      String // one of the selector's option values, for example "STRATA"
  recordedBy String?  @map("recorded_by") @db.Uuid
  recordedAt DateTime @default(now()) @db.Timestamptz @map("recorded_at")

  scheme     Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, key])
  @@map("scheme_selector_values")
}

/// The daily reminder for the deadline to start proceedings for a long
/// outstanding debt (the Queensland 2 year rule, SM s 166(2); QLD go-live gap,
/// 27 Oct 2026). One row per lot and oldest unpaid due date: the last stage
/// emailed, claimed before it is sent so a retried run sends it once.
model ProceedingsDeadlineReminder {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String   @map("scheme_id") @db.Uuid
  lotId       String   @map("lot_id") @db.Uuid
  oldestDueOn DateTime @db.Date @map("oldest_due_on") // the date for payment of the lot's oldest unpaid contribution
  deadlineOn  DateTime @db.Date @map("deadline_on") // the last day to start proceedings, as StrataVerze reads the rule
  lastStage   String   @map("last_stage") // FLAGGED, DAYS_30, DAYS_14, DAYS_7, PASSED
  lastSentOn  DateTime @db.Date @map("last_sent_on") // the building's day the stage was sent
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at")

  scheme      Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, oldestDueOn])
  @@map("proceedings_deadline_reminders")
}

/// A section 184 strata information certificate for a lot: drafted from the
/// platform's records, completed by the adviser, then issued (locked).
model SaleCertificate {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId           String    @map("scheme_id") @db.Uuid
  lotId              String    @map("lot_id") @db.Uuid
  number             Int       // per scheme, from 1
  status             String    @default("DRAFT") // DRAFT, ISSUED, CANCELLED
  requestedOn        DateTime  @db.Date @map("requested_on")
  requesterType      String    @map("requester_type") // the pack's requester types: NSW OWNER, MORTGAGEE, COVENANT_CHARGEE, AUTHORISED_PERSON; Queensland also BUYER, DISCLOSURE_RECIPIENT, PROPER_INTEREST, AGENT
  requesterName      String    @map("requester_name")
  requesterAddress   String    @map("requester_address")
  authorisedByType   String?   @map("authorised_by_type") // for an authorised person or agent: any requester type but that one
  authorisedByName   String?   @map("authorised_by_name")
  authorisedByAddress String?  @map("authorised_by_address")
  /// The items, in the order of the approved form: [{ no, title, text }].
  items              Json
  draftedOn          DateTime  @db.Date @map("drafted_on") // the day the figures were last taken from StrataVerze's records
  certificateDate    DateTime? @db.Date @map("certificate_date") // the date it is issued
  feeCents           Int?      @map("fee_cents")
  feeRepeat          Boolean   @default(false) @map("fee_repeat")
  feePaidOn          DateTime? @db.Date @map("fee_paid_on") // the fee is collected outside StrataVerze
  rulePack           String?   @map("rule_pack") @db.VarChar(40)
  /// What the certificate's PDF reads, kept when it is issued (migration 20261126): the wording, the
  /// building's details, the items and the dates, with the layout, the file name and the SHA-256 of
  /// the PDF, so a later change never alters an issued certificate. Never changed once set, and an
  /// issued certificate stays issued (trigger sale_certificates_issued_guard). Null for a draft, a
  /// cancelled draft and a certificate issued before the migration.
  issuedContent      Json?     @map("issued_content")
  /// The kind of certificate under a VIC, ACT or WA pack's CERTIFICATE_KINDS (migration 20261127): OWNERS_CORPORATION,
  /// SALE, SALE_UPDATE, RENTAL, SCHEME or LOT. Null for an NSW or Queensland certificate (check sale_certificates_kind_check).
  kind               String?
  /// The cap the fee was checked against when it was issued, and whether it includes GST (kind rows only; the fee is
  /// never above it). Null for an NSW or Queensland certificate.
  feeCapCents        Int?      @map("fee_cap_cents")
  feeIncludesGst     Boolean?  @map("fee_includes_gst")
  /// The adviser's answer: an additional certificate for the same applicant (VIC OWNERS_CORPORATION only).
  additionalCertificate Boolean? @map("additional_certificate")
  createdBy          String    @map("created_by") @db.Uuid
  issuedBy           String?   @map("issued_by") @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt          DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  scheme             Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  lot                Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([schemeId, number])
  @@index([lotId])
  @@map("sale_certificates")
}

/// A request to inspect the records or get copies (NSW s 182, Queensland Act s 205; the draft packs' RECORDS_ACCESS kinds, migration 20261127).
model RecordsInspection {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId         String    @map("scheme_id") @db.Uuid
  lotId            String    @map("lot_id") @db.Uuid // the owner's lot (an authorised person acts for its owner)
  inspectorType    String    @map("inspector_type") // the pack's requester types: NSW OWNER, AUTHORISED_PERSON; Queensland OWNER, MORTGAGEE, BUYER, DISCLOSURE_RECIPIENT, PROPER_INTEREST, AGENT
  inspectorName    String    @map("inspector_name")
  authorisedBy     String?   @map("authorised_by") // the owner who authorised it, for an authorised person
  requestedOn      DateTime  @db.Date @map("requested_on")
  status           String    @default("REQUESTED") // REQUESTED, SCHEDULED, COMPLETED, CANCELLED
  scheduledFor     DateTime? @db.Timestamptz @map("scheduled_for")
  setByNotice      Boolean   @default(false) @map("set_by_notice") // the time was set by the owners corporation's written notice
  place            String?
  minutes          Int?      // how long it took (NSW)
  inspected        Boolean?  // whether the records were inspected (Queensland; copies alone carry no inspection fee)
  copyPages        Int?      @map("copy_pages") // pages copied (Queensland)
  feeCents         Int?      @map("fee_cents")
  feePaidOn        DateTime? @db.Date @map("fee_paid_on")
  notes            String?
  /// The rule pack it was recorded under (migration 20261127). Null for NSW and Queensland requests recorded before it.
  rulePack         String?   @map("rule_pack") @db.VarChar(40)
  /// The kind of records access under a VIC, ACT or WA pack's RECORDS_ACCESS: RECORDS, REGISTER, EXECUTIVE_MEMBERS,
  /// INSURANCE or CONTACT. Null for NSW and Queensland (check records_inspections_access_kind_check).
  accessKind       String?   @map("access_kind")
  /// What copies were given (access kind rows only): PHOTOCOPY, ELECTRONIC or STORAGE_DEVICE, how many records, and the
  /// cost of a storage device.
  copyMedium       String?   @map("copy_medium")
  recordsCopied    Int?      @map("records_copied")
  deviceCostCents  Int?      @map("device_cost_cents")
  /// The cap the fee was checked against when it was completed, and whether it includes GST (access kind rows only).
  feeCapCents      Int?      @map("fee_cap_cents")
  feeIncludesGst   Boolean?  @map("fee_includes_gst")
  /// The adviser's answer: the person also asked for a sale certificate (ACT RECORDS only).
  alsoSaleCertificate Boolean? @map("also_sale_certificate")
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt        DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  scheme           Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  lot              Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([schemeId, status])
  @@map("records_inspections")
}

/// A waiver of the late charge on one levy notice in a particular case (VIC, ACT and WA stage 2, PR 5; Victoria
/// s 29(3), WA s 100(4)(b)), as the pack allows it (LATE_CHARGE.annual.waiver). Migration 20261123.
model LateChargeWaiver {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId            String    @map("scheme_id") @db.Uuid
  levyNoticeId        String    @map("levy_notice_id") @db.Uuid
  kind                String    // WHOLE, AMOUNT, PERIOD
  amount              Decimal?  @db.Decimal(12, 2) // AMOUNT only: the amount waived (> 0)
  fromDate            DateTime? @db.Date @map("from_date") // PERIOD only: the first day waived
  toDate              DateTime? @db.Date @map("to_date") // PERIOD only: the last day waived (included)
  decidedBy           String    @map("decided_by") // the kind of resolution that decided it: GENERAL_MEETING, ORDINARY, SPECIAL
  resolutionMeetingId String    @map("resolution_meeting_id") @db.Uuid
  resolutionMotionId  String    @map("resolution_motion_id") @db.Uuid
  decidedOn           DateTime  @db.Date @map("decided_on") // the meeting's day
  reasons             String?   // required by the app where decisions are reported to the AGM (Victoria s 29(4))
  rulePack            String    @map("rule_pack") @db.VarChar(40)
  recordedBy          String    @map("recorded_by") @db.Uuid
  recordedAt          DateTime  @default(now()) @db.Timestamptz @map("recorded_at")

  scheme              Scheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  levyNotice          LevyNotice @relation(fields: [levyNoticeId], references: [id], onDelete: Cascade)

  // The meeting and motion have foreign keys in the database (NO ACTION), not declared here: no relation to
  // meetings or agenda items is declared for the other resolution references either (schemes, budgets).
  @@unique([levyNoticeId, resolutionMotionId, kind])
  @@index([levyNoticeId])
  @@index([schemeId])
  @@map("late_charge_waivers")
}

// A resolution decided or taking effect after its meeting (VIC, ACT and WA stage 2, PR 8b-i, migration
// 20261124): Victoria's interim special resolution (s 97) and interim resolution without a quorum (s 78), and
// the ACT's reduced quorum decision (sch 3 ss 3.10, 3.11). One row for each agenda item, opened at conduct with
// the item stored as INTERIM, and decided once (CARRIED or LOST) by the daily run or an adviser's record; the
// item is updated to CARRIED or LOST in the same transaction. A trigger refuses any change to a decided row
// and to a fact once recorded. The meetings and agenda items have foreign keys in the database (NO ACTION),
// not declared here, as for the waivers.
model PendingResolution {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId               String    @map("scheme_id") @db.Uuid
  meetingId              String    @map("meeting_id") @db.Uuid
  agendaItemId           String    @unique @map("agenda_item_id") @db.Uuid
  state                  String    // VIC, ACT (WA from PR 8b-ii)
  kind                   String    // INTERIM_SPECIAL, INTERIM_NO_QUORUM, REDUCED_QUORUM (VOTING_PERIOD from PR 8b-ii)
  category               String    // the item's resolution category at the meeting
  takesEffectAs          String    @map("takes_effect_as") // the category it takes effect as (SPECIAL for s 97)
  status                 String    @default("PENDING") // PENDING, CARRIED, LOST
  madeOn                 DateTime  @db.Date @map("made_on") // the later of the meeting's day and the day it was recorded
  windowClosesOn         DateTime  @db.Date @map("window_closes_on") // the last day a petition or notice can arrive
  noticeDueOn            DateTime? @db.Date @map("notice_due_on")
  noticeGivenOn          DateTime? @db.Date @map("notice_given_on")
  petitionReceivedOn     DateTime? @db.Date @map("petition_received_on")
  meetingNoticeGivenOn   DateTime? @db.Date @map("meeting_notice_given_on") // Victoria s 78: special general meeting notice
  meetingNoticeMeetingId String?   @map("meeting_notice_meeting_id") @db.Uuid
  meetingHeldBy          DateTime? @db.Date @map("meeting_held_by")
  confirmedMeetingId     String?   @map("confirmed_meeting_id") @db.Uuid
  confirmedItemId        String?   @map("confirmed_item_id") @db.Uuid
  effectiveOn            DateTime? @db.Date @map("effective_on") // CARRIED only: the day it took effect
  endedBy                String?   @map("ended_by") // PERIOD_ENDED, PETITION, CONFIRMED, NOT_CONFIRMED, MEETING_NOT_HELD
  decidedAt              DateTime? @db.Timestamptz @map("decided_at")
  decidedBy              String?   @map("decided_by") @db.Uuid // null when the daily run decided it
  meetingVotes           Json      @map("meeting_votes") // {counted, notCounted, tally} at the meeting
  rule                   Json      // the pack's pending rule and the category's rule at the meeting
  rulePack               String    @map("rule_pack") @db.VarChar(40)
  recordedBy             String    @map("recorded_by") @db.Uuid
  createdAt              DateTime  @default(now()) @db.Timestamptz @map("created_at")

  scheme Scheme                 @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  lots   PendingResolutionLot[]

  @@index([schemeId])
  @@index([meetingId])
  @@index([status, windowClosesOn])
  @@map("pending_resolutions")
}

// The lots that signed a petition against a pending resolution (Victoria s 97(5), the ACT sch 3 s 3.11), one
// row for each lot. Rows are never updated (trigger). The lot has a foreign key in the database, not declared
// here. LATE_VOTE (Western Australia s 121(2)) is allowed by the database for PR 8b-ii.
model PendingResolutionLot {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pendingResolutionId String   @map("pending_resolution_id") @db.Uuid
  lotId               String   @map("lot_id") @db.Uuid
  entry               String   // PETITION (LATE_VOTE from PR 8b-ii)
  vote                String?  // LATE_VOTE only: FOR or AGAINST
  receivedOn          DateTime @db.Date @map("received_on")
  recordedBy          String   @map("recorded_by") @db.Uuid
  recordedAt          DateTime @default(now()) @db.Timestamptz @map("recorded_at")

  pendingResolution PendingResolution @relation(fields: [pendingResolutionId], references: [id], onDelete: Cascade)

  @@unique([pendingResolutionId, lotId, entry])
  @@map("pending_resolution_lots")
}
