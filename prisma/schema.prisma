// StrataVerze Data Model
// Strata management platform for Australian Owners Corporations
// Four portal roles: Owner, Committee, Adviser, Supplier
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identity & Access ───────────────────────────────────────────
enum PortalRole {
  OWNER
  COMMITTEE
  ADVISER
  SUPPLIER
  ACCOUNTANT
  ORG_ADMIN
  STRATA_MANAGER
  BUILDING_MANAGER
  COMPLIANCE_REVIEWER
  CONTRACTOR_ADMIN
  ACCOUNTS_OFFICER
  PAYMENT_AUTHORISER
  AUDITOR
}

model Profile {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authId        String             @unique @map("auth_id") @db.Uuid
  email         String             @unique
  firstName     String             @map("first_name")
  lastName      String             @map("last_name")
  phone         String?
  /// StrataVerze staff. Not a scheme role: platform admins see platform billing across schemes.
  isPlatformAdmin Boolean          @default(false) @map("is_platform_admin")
  avatarUrl     String?            @map("avatar_url")
  /// Every session that signed in before this time is ended (security stage S5).
  sessionsRevokedAt DateTime?      @db.Timestamptz @map("sessions_revoked_at")
  createdAt     DateTime           @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime           @updatedAt @db.Timestamptz @map("updated_at")

  memberships   SchemeMembership[]
  motions       Motion[]
  votes         Vote[]
  comments      Comment[]
  workOrders    WorkOrder[]        @relation("RaisedBy")
  awardedOrders WorkOrder[]        @relation("AwardedSupplier")
  invitations   Invitation[]       @relation("InvitedBy")
  activityLogs  ActivityLog[]
  announcements Announcement[]
  quotes        Quote[]
  invoices      Invoice[]
  // Organisation relations
  organisationMemberships       OrganisationMembership[]
  // Works Module: Delegations
  delegationsGiven              WorksDelegation[]          @relation("DelegatedBy")
  delegationsReceived           WorksDelegation[]          @relation("DelegatedTo")
  // Works Module: Requests
  worksRequestsRaised           WorksRequest[]             @relation("WorksRequestRaisedBy")
  worksRequestsAssigned         WorksRequest[]             @relation("WorksRequestAssignedTo")
  worksRequestVersions          WorksRequestVersion[]      @relation("WorksRequestVersionCreatedBy")
  worksRequestReviews           WorksRequestReview[]       @relation("WorksRequestReviewer")
  // Works Module: Scope & RFQ
  worksScopesApproved           WorksScope[]               @relation("WorksScopeApprovedBy")
  worksScopeVersions            WorksScopeVersion[]        @relation("WorksScopeVersionCreatedBy")
  worksRfqsIssued               WorksRfq[]                 @relation("WorksRfqIssuedBy")
  worksRfqInvitations           WorksRfqInvitation[]       @relation("WorksRfqInvitedBy")
  worksClarificationsAsked      WorksRfqClarification[]    @relation("WorksClarificationAskedBy")
  worksClarificationsAnswered   WorksRfqClarification[]    @relation("WorksClarificationAnsweredBy")
  worksAddenda                  WorksRfqAddendum[]         @relation("WorksAddendumIssuedBy")
  // Works Module: Contractors
  contractorContacts            ContractorContact[]
  // Works Module: Compliance
  worksComplianceVerifications  WorksComplianceCheck[]     @relation("WorksComplianceVerifiedBy")
  worksLicenceVerifications     WorksLicence[]             @relation("WorksLicenceVerifiedBy")
  worksInsuranceVerifications   WorksInsurance[]           @relation("WorksInsuranceVerifiedBy")
  worksVerificationEvents       WorksVerificationEvent[]   @relation("WorksVerificationEventBy")
  // Works Module: Quotations & Evaluation
  worksEvaluations              WorksEvaluation[]          @relation("WorksEvaluator")
  worksRecommendations          WorksRecommendation[]      @relation("WorksRecommendedBy")
  // Works Module: Approvals
  worksApprovalRecords          WorksApprovalRecord[]      @relation("WorksApprover")
  // Works Module: Contracts & Delivery
  worksContractsSigned          WorksContract[]            @relation("WorksContractSignedBy")
  worksWorkOrdersAuthorised     WorksWorkOrder[]           @relation("WorksWorkOrderAuthorisedBy")
  worksWorkOrdersIssued         WorksWorkOrder[]           @relation("WorksWorkOrderIssuedBy")
  worksRfqInterests             WorksRfqInterest[]         @relation("WorksRfqInterestCreatedBy")
  worksMilestonesCertified      WorksMilestone[]           @relation("WorksMilestoneCertifiedBy")
  worksSiteVisits               WorksSiteVisit[]           @relation("WorksSiteVisitConductedBy")
  worksProgressReports          WorksProgressReport[]      @relation("WorksProgressReportBy")
  worksVariationsRequested      WorksVariation[]           @relation("WorksVariationRequestedBy")
  worksVariationsApproved       WorksVariation[]           @relation("WorksVariationApprovedBy")
  worksInspections              WorksInspection[]          @relation("WorksInspector")
  worksDefectsVerified          WorksDefect[]              @relation("WorksDefectVerifiedBy")
  worksCompletionSubmissions    WorksCompletionSubmission[] @relation("WorksCompletionSubmittedBy")
  worksCompletionReviews        WorksCompletionSubmission[] @relation("WorksCompletionReviewedBy")
  // Works Module: Invoices & Payments
  worksInvoicesSubmitted        WorksInvoice[]             @relation("WorksInvoiceSubmittedBy")
  worksInvoicesAssessed         WorksInvoice[]             @relation("WorksInvoiceAssessedBy")
  worksInvoicesCoded            WorksInvoice[]             @relation("WorksInvoiceCodedBy")
  worksPaymentAssessments       WorksPaymentAssessment[]   @relation("WorksPaymentAssessor")
  worksPaymentInstructions      WorksPaymentInstruction[]  @relation("WorksPaymentAuthorisedBy")
  worksPaymentRecords           WorksPaymentRecord[]       @relation("WorksPaymentRecordedBy")
  worksPaymentReconciliations   WorksPaymentRecord[]       @relation("WorksPaymentReconciledBy")
  worksBankDetailsUpdated       WorksBankDetailVersion[]   @relation("WorksBankDetailUpdatedBy")
  worksBankDetailsVerified      WorksBankDetailVersion[]   @relation("WorksBankDetailVerifiedBy")
  // Works Module: Documents, Notifications & Audit
  worksDocuments                WorksDocument[]            @relation("WorksDocumentUploadedBy")
  worksNotifications            WorksNotification[]        @relation("WorksNotificationRecipient")
  worksAuditEvents              WorksAuditEvent[]          @relation("WorksAuditActor")
  // Contractor Onboarding Module
  abnLookups                    AbnLookupRecord[]          @relation("AbnLookupPerformedBy")
  contractorDeclarations        ContractorDeclaration[]    @relation("ContractorDeclarationAcceptedBy")
  contractorMembershipsAccepted ContractorMembership[]     @relation("ContractorMembershipAcceptedBy")
  contractorReviewsAssigned     ContractorReviewItem[]     @relation("ContractorReviewAssignedTo")
  contractorReviewsCompleted    ContractorReviewItem[]     @relation("ContractorReviewCompletedBy")
  // Debt Recovery Module
  debtRecoveryCasesAsOwner      DebtRecoveryCase[]         @relation("DebtRecoveryCaseOwner")
  debtRecoveryCasesInitiated    DebtRecoveryCase[]         @relation("DebtRecoveryCaseInitiator")

  worksSettingsUpdated   WorksSettings[]            @relation("WorksSettingsUpdatedBy")
  worksPreferredCreated  WorksPreferredContractor[] @relation("WorksPreferredCreatedBy")
  worksDecisionsProposed WorksDecision[]            @relation("WorksDecisionProposedBy")
  worksDecisionVotes     WorksDecisionVote[]        @relation("WorksDecisionVoter")
  committeeTraining CommitteeTraining[] @relation("CommitteeTrainingMember")
  @@map("profiles")
}

// ─── Schemes (Owners Corporations / Strata Plans) ────────────────
model Scheme {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  /// Unique within each state, not across the platform (decided 27 Oct 2026; @@unique([state, planNumber]) below,
  /// migration 20261122): an NSW and a Queensland building may have the same plan number.
  planNumber          String              @map("plan_number")
  address             String
  suburb              String
  state               String              @default("NSW") // Only NSW and QLD buildings can be set up (src/config/jurisdictions.ts; schemes_state_has_rule_pack_check, migration 20261122)
  postcode            String
  totalLots           Int                 @map("total_lots")
  totalEntitlement    Int                 @map("total_entitlement")
  financialYearEnd    String              @default("06-30") @map("financial_year_end")
  timeZone            String              @default("Australia/Sydney") @map("time_zone") @db.VarChar(64) // IANA time zone for the building's dates, set from state and postcode (src/lib/jurisdiction/time-zone.ts)
  abnNumber           String?             @map("abn_number")
  buildingClass       String?             @map("building_class") // e.g. "1", "2", "3"
  buildingType        String?             @map("building_type") // STRATA, COMMUNITY, COMPANY_TITLE, STRATUM
  buildingSubType     String?             @map("building_sub_type") // e.g. "Residential", "Commercial", "Mixed Use"
  folio               String? // land title folio reference
  isActive            Boolean             @default(true) @map("is_active")
  allInclusiveFees    Boolean             @default(false) @map("all_inclusive_fees")
  paymentPlan         String?             @map("payment_plan") // e.g. "QUARTERLY", "MONTHLY", "ANNUALLY"
  debtCollection      Boolean             @default(false) @map("debt_collection")
  // Financial management fields
  gstRegistered       Boolean             @default(false) @map("gst_registered")
  preMeetingEvotingAdopted Boolean        @default(false) @map("pre_meeting_evoting_adopted") // body resolved to adopt pre-meeting e-voting (Reg cl 14)
  interestRate        Decimal?            @db.Decimal(5, 2) @map("interest_rate") // Deprecated: interest follows SSMA s 85 (see interestMode)
  /// The late charge mode, from the building's rule pack (LATE_CHARGE.modes). NSW: STATUTORY (SSMA 2015 s 85:
  /// 10% simple, one month grace) or NO_INTEREST by recorded resolution (s 85(3)). QLD: NONE (no penalty) or
  /// RESOLVED_RATE (a monthly penalty at the rate a recorded resolution set, Standard Module s 165). VIC, ACT and
  /// WA: RESOLVED_ANNUAL_RATE (a yearly rate a recorded resolution set, within the pack's range).
  interestMode        String              @default("STATUTORY") @map("interest_mode")
  /// The resolved monthly penalty rate; set exactly when interestMode is RESOLVED_RATE (> 0, <= 100; the pack caps it lower).
  lateChargeMonthlyRatePercent Decimal?   @db.Decimal(5, 2) @map("late_charge_monthly_rate_percent")
  /// The resolved yearly interest rate; set exactly when interestMode is RESOLVED_ANNUAL_RATE (>= 0, <= 100; the pack's
  /// range decides), for a VIC, ACT or WA building only (migration 20261123).
  lateChargeAnnualRatePercent Decimal?    @db.Decimal(5, 2) @map("late_charge_annual_rate_percent")
  interestResolutionMeetingId String?     @map("interest_resolution_meeting_id") @db.Uuid
  interestResolutionMotionId  String?     @map("interest_resolution_motion_id") @db.Uuid
  interestResolutionRecordedBy String?    @map("interest_resolution_recorded_by") @db.Uuid
  interestResolutionRecordedAt DateTime?  @db.Timestamptz @map("interest_resolution_recorded_at")
  /// Apply an owner's credit (overpayment) to their next levy notice automatically.
  autoApplyOwnerCredit Boolean            @default(true) @map("auto_apply_owner_credit")
  /// The regulation module, for a pack with a REGULATION_MODULE selector (Queensland: STANDARD, ACCOMMODATION,
  /// COMMERCIAL, SMALL_SCHEMES, SPECIFIED_TWO_LOT; BCCMA s 21). Null for every other building. A Queensland
  /// building with none is flagged to the adviser (src/lib/jurisdiction/building-data.ts).
  regulationModule    String?             @map("regulation_module")
  /// The plan format, for a pack with a PLAN_FORMAT selector (Queensland: BUILDING, VOLUMETRIC, STANDARD; Standard
  /// Module ss 198, 199, 201). Null for every other building. It decides how a Queensland contribution's insurance
  /// part is shared; a standard format plan, or none recorded, is refused (src/lib/levies/contribution-shares.ts).
  planFormat          String?             @map("plan_format")
  /// Whether the building is a services only owners corporation (Victoria, OCA s 3), a fact the pack's derived tier
  /// reads (BUILDING_FACTS SERVICES_ONLY). Null for every other building and until recorded; the tier is then refused.
  servicesOnly        Boolean?            @map("services_only")
  /// The replacement cost the Western Australian designated strata company test reads (STGR reg 79; BUILDING_FACTS
  /// REPLACEMENT_COST), in dollars. Null for every other building and until recorded.
  replacementCost     Decimal?            @db.Decimal(14, 2) @map("replacement_cost")
  defaultPaymentTerms Int?                @map("default_payment_terms") // days for supplier invoices
  organisationId      String?             @map("organisation_id") @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz @map("created_at")
  updatedAt           DateTime            @updatedAt @db.Timestamptz @map("updated_at")

  organisation        Organisation?       @relation(fields: [organisationId], references: [id])
  lots                Lot[]
  memberships         SchemeMembership[]
  images              SchemeImage[]
  motions             Motion[]
  meetings            Meeting[]
  documents           Document[]
  workOrders          WorkOrder[]
  funds               Fund[]
  compliance          ComplianceItem[]
  invitations         Invitation[]
  activityLogs        ActivityLog[]
  announcements       Announcement[]
  bylaws              ByLaw[]
  insurancePolicies   InsurancePolicy[]
  insuranceClaims     InsuranceClaim[]
  insuranceRenewals   InsuranceRenewal[]
  insuranceDocuments  InsuranceDocument[]
  insuranceTasks      InsuranceTask[]
  contacts            Contact[]
  quoteRequests       QuoteRequest[]
  invoices            Invoice[]
  // Financial management relations
  accountCodes        AccountCode[]
  bankAccounts        SchemeBankAccount[]
  bankTransactions    BankTransaction[]
  financialPeriods    FinancialPeriod[]
  journalEntries      JournalEntry[]
  levySchedules       LevySchedule[]
  levyNotices         LevyNotice[]
  financialDocuments  FinancialDocument[]
  suppliers           Supplier[]
  supplierInvoices    SupplierInvoice[]
  matchingRules       MatchingRule[]
  // Works Module relations
  worksCategories             WorksCategory[]
  worksApprovalRoutes         WorksApprovalRoute[]
  worksDelegations            WorksDelegation[]
  worksRequests               WorksRequest[]
  worksScopes                 WorksScope[]
  worksRfqs                   WorksRfq[]
  worksWorkOrders             WorksWorkOrder[]
  worksApprovalWorkflows      WorksApprovalWorkflow[]
  worksContracts              WorksContract[]
  worksInvoices               WorksInvoice[]
  worksDocuments              WorksDocument[]
  worksNotifications          WorksNotification[]
  worksAuditEvents            WorksAuditEvent[]
  worksComplianceRequirements WorksComplianceRequirement[]
  // Debt Recovery Module
  debtRecoveryCases           DebtRecoveryCase[]
  debtRecoveryPaymentPlans    PaymentPlan[]
  paymentPlanRequests         PaymentPlanRequest[]
  committeeTraining           CommitteeTraining[]
  annualReports               AnnualReport[]
  proceedingsDeadlineReminders ProceedingsDeadlineReminder[]
  selectorValues     SchemeSelectorValue[]
  lateChargeWaivers           LateChargeWaiver[]
  pendingResolutions          PendingResolution[]
  debtRecoveryRecords         DebtRecoveryRecord[]
  saleCertificates            SaleCertificate[]
  recordsInspections          RecordsInspection[]

  worksSettings          WorksSettings?
  worksPreferredContractors WorksPreferredContractor[]
  worksDecisions         WorksDecision[]
  @@unique([state, planNumber])
  @@map("schemes")
}

model SchemeImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId  String   @map("scheme_id") @db.Uuid
  url       String
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")

  scheme    Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId, sortOrder])
  @@map("scheme_images")
}

model Lot {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId           String              @map("scheme_id") @db.Uuid
  lotNumber          String              @map("lot_number")
  unitNumber         String?             @map("unit_number")
  entitlement        Int                 // the schedule the pack holds on each lot (NSW unit entitlement, Queensland contribution schedule, Victorian lot liability)
  /// The Queensland interest schedule lot entitlement (BCCMA s 46), the pack's second schedule; positive when set, null for NSW.
  interestScheduleEntitlement Int?       @map("interest_schedule_entitlement")
  /// The Victorian lot entitlement (OCA s 3), the pack's second schedule (lot liability is in entitlement); positive when
  /// set, null for every other building. Cleared when the building's state changes.
  lotEntitlement     Int?                @map("lot_entitlement")
  /// Whether the lot is occupiable (Victoria, OCA s 3: ordinarily used for residential or business purposes), a fact the
  /// pack's derived tier reads (BUILDING_FACTS LOT_OCCUPIABLE). Null for every other building and until answered.
  occupiable         Boolean?
  floorArea          Float?              @map("floor_area")
  lotType            String              @default("RESIDENTIAL") @map("lot_type")

  // Extended lot details (per Figma)
  streetNo           String?             @map("street_no")
  streetName         String?             @map("street_name")
  suburb             String?
  accessoryUnit      String?             @map("accessory_unit")
  uof                String?             // Unit of Functionality
  crn                String?             // Certificate Registration Number

  scheme             Scheme              @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  memberships        SchemeMembership[]
  invitations        Invitation[]
  levyNotices        LevyNotice[]
  journalLines       JournalLine[]
  financialDocuments FinancialDocument[]
  lotDetail          LotDetail?
  tenants            LotTenant[]
  deliveryPreferences LotDeliveryPreference[]
  debtCollection     LotDebtCollection?
  debtRecoveryCases  DebtRecoveryCase[]
  debtRecoveryPaymentPlans PaymentPlan[]
  proceedingsDeadlineReminders ProceedingsDeadlineReminder[]
  paymentPlanRequests PaymentPlanRequest[]
  proxies            LotProxy[]
  powersOfAttorney   LotPowerOfAttorney[]
  propertyManager    PropertyManager?

  saleCertificates   SaleCertificate[]
  recordsInspections RecordsInspection[]
  @@unique([schemeId, lotNumber])
  @@map("lots")
}

// ─── Lot Detail (extended owner/settlement info per lot) ─────────
model LotDetail {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId             String    @unique @map("lot_id") @db.Uuid
  // Owner contact (overrides profile defaults for this lot)
  ownerPhone        String?   @map("owner_phone")
  ownerMobile       String?   @map("owner_mobile")
  contactName       String?   @map("contact_name")
  ownerAddress      String?   @map("owner_address")
  ownerEmail        String?   @map("owner_email")
  isCommitteeMember Boolean   @default(false) @map("is_committee_member")
  paidToDate        DateTime? @db.Date @map("paid_to_date")
  lastSettled       DateTime? @db.Date @map("last_settled")
  rollOwnerName     String?   @map("roll_owner_name") // as it appears on the strata roll
  createdAt         DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  lot               Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@map("lot_details")
}

// ─── Lot Tenancy ──────────────────────────────────────────────────
model LotTenant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId             String    @map("lot_id") @db.Uuid
  tenantNumber      Int       @default(1) @map("tenant_number") // 1 or 2
  isOwnerOccupier   Boolean   @default(false) @map("is_owner_occupier")
  isFormalTenant    Boolean   @default(false) @map("is_formal_tenant")
  dateReceived      DateTime? @db.Date @map("date_received")
  deliveryBy        String    @default("EMAIL") @map("delivery_by") // EMAIL, POST
  salutation        String?
  name              String?
  contactName       String?   @map("contact_name")
  mobile            String?
  email             String?
  leaseStart        DateTime? @db.Date @map("lease_start")
  leaseExpiry       DateTime? @db.Date @map("lease_expiry")
  notes             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  lot               Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, tenantNumber])
  @@map("lot_tenants")
}

// ─── Property Manager ────────────────────────────────────────────
model PropertyManager {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId       String   @unique @map("lot_id") @db.Uuid
  agentName   String?  @map("agent_name")
  company     String?
  address     String?
  agentEmail  String?  @map("agent_email")
  phone       String?
  fax         String?
  email       String?
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at")

  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@map("property_managers")
}

// ─── Delivery Preferences ────────────────────────────────────────
model LotDeliveryPreference {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId           String   @map("lot_id") @db.Uuid
  category        String   // ANNUAL_NOTICES, MEETING_NOTICES, GENERAL_CORRESPONDENCE
  deliveryMethod  String   @default("EMAIL") @map("delivery_method") // EMAIL, POST, SMS
  recipientType   String   @default("OWNER") @map("recipient_type") // AGENT, OWNER, TENANT, OTHER
  recipientName   String?  @map("recipient_name")
  recipientEmail  String?  @map("recipient_email")
  recipientAddress String? @map("recipient_address")
  recipientSuburb  String? @map("recipient_suburb")
  recipientState   String? @map("recipient_state")
  recipientPostcode String? @map("recipient_postcode")
  createdAt       DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime @updatedAt @db.Timestamptz @map("updated_at")

  lot             Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, category])
  @@map("lot_delivery_preferences")
}

// ─── Debt Collection ─────────────────────────────────────────────
model LotDebtCollection {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId                   String   @unique @map("lot_id") @db.Uuid
  stage                   String   @default("NONE") // NONE, REMINDER, NOTICE, LEGAL, JUDGMENT
  notes                   String?
  excludeFromCollection   Boolean  @default(false) @map("exclude_from_collection")
  hasPaymentPlan          Boolean  @default(false) @map("has_payment_plan")
  buildingDebtCollection  Boolean  @default(false) @map("building_debt_collection")
  repaymentPlan           Boolean  @default(false) @map("repayment_plan")
  legalAction             Boolean  @default(false) @map("legal_action")
  createdAt               DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt               DateTime @updatedAt @db.Timestamptz @map("updated_at")

  lot                     Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@map("lot_debt_collections")
}

// ─── Power of Attorney ───────────────────────────────────────────
model LotPowerOfAttorney {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId           String    @map("lot_id") @db.Uuid
  attorneyName    String    @map("attorney_name")
  attorneyEmail   String?   @map("attorney_email")
  attorneyPhone   String?   @map("attorney_phone")
  attorneyAddress String?   @map("attorney_address")
  startDate       DateTime? @db.Date @map("start_date")
  endDate         DateTime? @db.Date @map("end_date")
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?
  createdAt       DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  lot             Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, isActive])
  @@map("lot_powers_of_attorney")
}

// ─── Proxy Voting ────────────────────────────────────────────────
model LotProxy {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId         String    @map("lot_id") @db.Uuid
  proxyName     String    @map("proxy_name")
  proxyEmail    String?   @map("proxy_email")
  proxyPhone    String?   @map("proxy_phone")
  meetingDate   DateTime? @db.Date @map("meeting_date")
  meetingTitle  String?   @map("meeting_title")
  isActive      Boolean   @default(true) @map("is_active")
  notes         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  lot           Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, isActive])
  @@map("lot_proxies")
}

model SchemeMembership {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId  String     @map("scheme_id") @db.Uuid
  profileId String     @map("profile_id") @db.Uuid
  lotId     String?    @map("lot_id") @db.Uuid
  role      PortalRole
  isActive  Boolean    @default(true) @map("is_active")
  /// Committee member who is the treasurer (an eligible payment approver).
  isTreasurer Boolean  @default(false) @map("is_treasurer")
  startDate DateTime   @default(now()) @db.Timestamptz @map("start_date")
  endDate   DateTime?  @db.Timestamptz @map("end_date")
  createdAt DateTime   @default(now()) @db.Timestamptz @map("created_at")

  scheme    Scheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lot       Lot?       @relation(fields: [lotId], references: [id])

  @@unique([schemeId, profileId, role])
  @@map("scheme_memberships")
}

// ─── Sovereign Ledger (Financial) ────────────────────────────────
model Fund {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId           String             @map("scheme_id") @db.Uuid
  name               String
  fundType           String             @map("fund_type") // ADMINISTRATIVE, CAPITAL_WORKS, SPECIAL
  balance            Decimal            @default(0) @db.Decimal(12, 2)
  bankAccountId      String?            @map("bank_account_id") @db.Uuid
  openingBalance     Decimal?           @db.Decimal(12, 2) @map("opening_balance")
  openingBalanceDate DateTime?          @db.Date @map("opening_balance_date")
  /// CASH or ACCRUAL: how reports recognise income and expenditure for this fund (posting is unchanged).
  accountingBasis    String             @default("CASH") @map("accounting_basis")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @db.Timestamptz @map("created_at")
  updatedAt          DateTime           @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt          DateTime?          @db.Timestamptz @map("deleted_at")

  scheme             Scheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  bankAccount        SchemeBankAccount? @relation(fields: [bankAccountId], references: [id])
  accountCodes       AccountCode[]
  levySchedules      LevySchedule[]
  levyNotices        LevyNotice[]
  journalLines       JournalLine[]
  supplierInvoices   SupplierInvoice[]
  budgetLines        BudgetLine[]
  matchingRules      MatchingRule[]

  @@index([schemeId, fundType])
  @@map("funds")
}

// Legacy levy model — retained for backward compatibility during migration
// ─── Governance Engine ───────────────────────────────────────────
model Meeting {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String    @map("scheme_id") @db.Uuid
  title       String
  meetingType String    @map("meeting_type") // AGM, EGM (legacy SGM), COMMITTEE, FIRST_AGM
  scheduledAt DateTime  @db.Timestamptz @map("scheduled_at")
  location    String?
  agenda      String?   // legacy free-text agenda; structured items live in AgendaItem
  minutesUrl  String?   @map("minutes_url") // legacy minutes link; structured minutes come later
  // Meeting-wizard status vocabulary (legacy default "SCHEDULED" retained for old rows):
  // DRAFT, NOTICE_ISSUED, IN_PROGRESS, MINUTES_DRAFT, PUBLISHED, CANCELLED, ADJOURNED
  status      String    @default("SCHEDULED")
  // Epic 0 setup fields (all nullable, additive)
  timezone          String?   // IANA zone, e.g. Australia/Sydney
  format            String?   // IN_PERSON, VIRTUAL, HYBRID
  startTime         DateTime? @db.Timestamptz @map("start_time")
  endTime           DateTime? @db.Timestamptz @map("end_time")
  convenorId        String?   @map("convenor_id") @db.Uuid
  chairpersonId     String?   @map("chairperson_id") @db.Uuid
  financialPeriodId String?   @map("financial_period_id") @db.Uuid
  joinUrl           String?   @map("join_url")
  joinDetails       String?   @map("join_details")
  cancelledReason   String?   @map("cancelled_reason")
  openedAt          DateTime? @db.Timestamptz @map("opened_at")
  closedAt          DateTime? @db.Timestamptz @map("closed_at")
  quorumMet         Boolean?  @map("quorum_met")
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz @map("deleted_at")

  scheme         Scheme          @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  motions        Motion[]
  agendaItems    AgendaItem[]
  events         MeetingEvent[]
  appliedRuleSet AppliedRuleSet?
  notices        Notice[]
  minutes        Minutes[]
  electronicBallot ElectronicBallot?

  @@map("meetings")
}

// A pre-meeting electronic ballot for a meeting (Reg cl 14-17).
model ElectronicBallot {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId   String    @unique @map("meeting_id") @db.Uuid
  status      String    @default("OPEN") // OPEN, CLOSED
  opensAt     DateTime  @db.Timestamptz @map("opens_at")
  closesAt    DateTime  @db.Timestamptz @map("closes_at")
  createdById String?   @map("created_by_id") @db.Uuid
  closedAt    DateTime? @db.Timestamptz @map("closed_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")

  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  votes   ElectronicVote[]

  @@map("electronic_ballots")
}

// A single owner's electronic vote on an agenda item (secret-ballot capable).
model ElectronicVote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ballotId        String   @map("ballot_id") @db.Uuid
  agendaItemId    String   @map("agenda_item_id") @db.Uuid
  lotId           String?  @map("lot_id") @db.Uuid
  profileId       String?  @map("profile_id") @db.Uuid
  unitEntitlement Int      @default(0) @map("unit_entitlement")
  voteValue       String   @map("vote_value") // FOR, AGAINST, ABSTAIN
  isInformal      Boolean  @default(false) @map("is_informal")
  castAt          DateTime @default(now()) @db.Timestamptz @map("cast_at")

  ballot ElectronicBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  @@unique([ballotId, agendaItemId, lotId])
  @@index([ballotId, agendaItemId])
  @@map("electronic_votes")
}

// Meeting minutes. WORKING and DRAFT precede the CONFIRMED official record.
model Minutes {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId      String    @map("meeting_id") @db.Uuid
  version        Int       @default(1)
  state          String    @default("DRAFT") // WORKING, DRAFT, CONFIRMED
  content        Json
  documentUrl    String?   @map("document_url")
  preparedById   String?   @map("prepared_by_id") @db.Uuid
  confirmedAt    DateTime? @db.Timestamptz @map("confirmed_at")
  confirmedById  String?   @map("confirmed_by_id") @db.Uuid
  distributedAt  DateTime? @db.Timestamptz @map("distributed_at")
  retentionUntil DateTime? @db.Date @map("retention_until")
  createdAt      DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, version])
  @@map("minutes")
}

// A meeting notice issued to recipients. Re-issuing creates a new version.
model Notice {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId        String   @map("meeting_id") @db.Uuid
  version          Int      @default(1)
  status           String   @default("ISSUED") // ISSUED, SUPERSEDED
  issuedById       String?  @map("issued_by_id") @db.Uuid
  issuedAt         DateTime @default(now()) @db.Timestamptz @map("issued_at")
  noticePeriodDays Int?     @map("notice_period_days")
  compliant        Boolean  @default(true)
  content          Json
  documentUrl      String?  @map("document_url")
  createdAt        DateTime @default(now()) @db.Timestamptz @map("created_at")

  meeting    Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recipients NoticeRecipient[]

  @@index([meetingId, version])
  @@map("notices")
}

// A recorded recipient of a notice and the delivery outcome.
model NoticeRecipient {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noticeId        String    @map("notice_id") @db.Uuid
  lotId           String?   @map("lot_id") @db.Uuid
  profileId       String?   @map("profile_id") @db.Uuid
  name            String?
  email           String?
  method          String    @default("EMAIL")
  sentAt          DateTime? @db.Timestamptz @map("sent_at")
  deliveryOutcome String    @default("PENDING") @map("delivery_outcome") // PENDING, SENT, DELIVERED, BOUNCED, SERVED
  createdAt       DateTime  @default(now()) @db.Timestamptz @map("created_at")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@map("notice_recipients")
}

// Structured agenda item (replaces the single free-text agenda column going forward).
model AgendaItem {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId            String   @map("meeting_id") @db.Uuid
  position             Int
  title                String
  resolutionText       String?  @map("resolution_text")
  explanatoryNote      String?  @map("explanatory_note")
  resolutionCategory   String?  @map("resolution_category") // ORDINARY, SPECIAL, UNANIMOUS, SUSTAINABILITY_INFRASTRUCTURE
  submitterId          String?  @map("submitter_id") @db.Uuid
  motionLibraryEntryId String?  @map("motion_library_entry_id") @db.Uuid
  outcome              String?  // RESOLVED, MOTION_LOST, DEFERRED
  status               String   @default("PENDING") // PENDING, CARRIED, LOST, DEFERRED
  createdAt            DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt           DateTime @updatedAt @db.Timestamptz @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, position])
  @@map("agenda_items")
}

// Reusable agenda template for a meeting type and jurisdiction (rules-layer data).
model MeetingTemplate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state           String   // NSW
  meetingType     String   @map("meeting_type")
  name            String
  items           Json     // ordered mandatory items: [{title, resolutionText, explanatoryNote, resolutionCategory}]
  ruleSetVersion  String?  @map("rule_set_version")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime @updatedAt @db.Timestamptz @map("updated_at")

  @@unique([state, meetingType, name])
  @@map("meeting_templates")
}

// Pre-written motion for the motion library (rules-layer data).
model MotionLibraryEntry {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state                     String   // NSW
  meetingType               String?  @map("meeting_type") // null = any
  category                  String
  title                     String
  resolutionText            String   @map("resolution_text")
  explanatoryNote           String?  @map("explanatory_note")
  defaultResolutionCategory String?  @map("default_resolution_category")
  placeholders              Json?    // token -> description
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt                 DateTime @updatedAt @db.Timestamptz @map("updated_at")

  @@map("motion_library_entries")
}

// Versioned jurisdiction rule set. Legislative deadlines and thresholds live here as data, not in code.
model MeetingRuleSet {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state                String   // NSW
  version              String
  effectiveFrom        DateTime @db.Date @map("effective_from")
  noticePeriods        Json     @map("notice_periods")        // { AGM: 14, EGM: 7, COMMITTEE: 3, FIRST_AGM: 14 } days
  minutesDeadlines     Json     @map("minutes_deadlines")     // { AGM: 7, EGM: 7, COMMITTEE: 7 } days
  quorumRules          Json     @map("quorum_rules")
  resolutionCategories Json     @map("resolution_categories")
  retention            Json
  notes                String?
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @db.Timestamptz @map("created_at")

  @@unique([state, version])
  @@map("meeting_rule_sets")
}

// Immutable snapshot of the rule set that governed a specific meeting.
model AppliedRuleSet {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId       String   @unique @map("meeting_id") @db.Uuid
  ruleSetState    String   @map("rule_set_state")
  ruleSetVersion  String   @map("rule_set_version")
  snapshot        Json
  appliedAt       DateTime @default(now()) @db.Timestamptz @map("applied_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("applied_rule_sets")
}

// Append-only audit log of changes during a meeting.
model MeetingEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  eventType String   @map("event_type")
  payload   Json?
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@map("meeting_events")
}

model Motion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String   @map("scheme_id") @db.Uuid
  meetingId   String?  @map("meeting_id") @db.Uuid
  raisedById  String   @map("raised_by_id") @db.Uuid
  title       String
  description String
  motionType  String   @map("motion_type") // ORDINARY, SPECIAL, UNANIMOUS
  status      String   @default("DRAFT")
  outcome     String?
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at")

  scheme      Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  meeting     Meeting? @relation(fields: [meetingId], references: [id])
  raisedBy    Profile  @relation(fields: [raisedById], references: [id])
  votes       Vote[]
  debtRecoveryCases DebtRecoveryCase[]

  @@map("motions")
}

model Vote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  motionId  String   @map("motion_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  voteValue String   @map("vote_value") // FOR, AGAINST, ABSTAIN
  votedAt   DateTime @default(now()) @db.Timestamptz @map("voted_at")

  motion    Motion   @relation(fields: [motionId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id])

  @@unique([motionId, profileId])
  @@map("votes")
}

// ─── Asset Vault (Maintenance & Work Orders) ─────────────────────
model WorkOrder {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId       String         @map("scheme_id") @db.Uuid
  raisedById     String         @map("raised_by_id") @db.Uuid
  title          String
  description    String
  priority       String         @default("MEDIUM")
  status         String         @default("OPEN") // OPEN, QUOTING, AWARDED, IN_PROGRESS, COMPLETED, CANCELLED
  category       String?
  estimatedCost  Decimal?       @map("estimated_cost") @db.Decimal(12, 2)
  actualCost     Decimal?       @map("actual_cost") @db.Decimal(12, 2)
  assignedTo     String?        @map("assigned_to")
  supplierId     String?        @map("supplier_id") @db.Uuid
  awardedQuoteId String?        @unique @map("awarded_quote_id") @db.Uuid
  completedAt    DateTime?      @db.Timestamptz @map("completed_at")
  createdAt      DateTime       @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime       @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt      DateTime?      @db.Timestamptz @map("deleted_at")

  scheme         Scheme         @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  raisedBy       Profile        @relation("RaisedBy", fields: [raisedById], references: [id])
  supplier       Profile?       @relation("AwardedSupplier", fields: [supplierId], references: [id])
  awardedQuote   Quote?         @relation("AwardedQuote", fields: [awardedQuoteId], references: [id])
  comments       Comment[]
  invoices       Invoice[]
  quoteRequests  QuoteRequest[]

  @@map("work_orders")
}

model Comment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  content     String
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author      Profile   @relation(fields: [authorId], references: [id])

  @@map("comments")
}

// ─── Supplier Marketplace (Quote Requests, Quotes & Invoices) ────
model QuoteRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String    @map("scheme_id") @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  title       String
  description String
  category    String // PLUMBER, ELECTRICIAN, BUILDER, GARDENER, CLEANER, LOCKSMITH, PEST_CONTROL, FIRE_SAFETY, LIFT, POOL, OTHER
  urgency     String    @default("STANDARD") // URGENT, STANDARD, FLEXIBLE
  budget      String? // e.g. "Under $500", "$500-$2000", "$2000-$5000", "Over $5000"
  closesAt    DateTime? @db.Timestamptz @map("closes_at")
  status      String    @default("OPEN") // OPEN, CLOSED, AWARDED, CANCELLED
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  scheme      Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  quotes      Quote[]

  @@index([schemeId, status])
  @@index([category, status])
  @@map("quote_requests")
}

model Quote {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteRequestId String       @map("quote_request_id") @db.Uuid
  supplierId     String       @map("supplier_id") @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  estimatedDays  Int?         @map("estimated_days")
  validUntil     DateTime?    @db.Timestamptz @map("valid_until")
  status         String       @default("SUBMITTED") // SUBMITTED, ACCEPTED, DECLINED, WITHDRAWN
  notes          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime     @updatedAt @db.Timestamptz @map("updated_at")

  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplier       Profile      @relation(fields: [supplierId], references: [id])
  awardedOrder   WorkOrder?   @relation("AwardedQuote")

  @@unique([quoteRequestId, supplierId])
  @@map("quotes")
}

model Invoice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId   String    @map("work_order_id") @db.Uuid
  schemeId      String    @map("scheme_id") @db.Uuid
  supplierId    String    @map("supplier_id") @db.Uuid
  invoiceNumber String    @map("invoice_number")
  amount        Decimal   @db.Decimal(12, 2)
  gstAmount     Decimal   @default(0) @map("gst_amount") @db.Decimal(12, 2)
  totalAmount   Decimal   @map("total_amount") @db.Decimal(12, 2)
  description   String?
  status        String    @default("SUBMITTED") // SUBMITTED, APPROVED, PAID, DISPUTED, CANCELLED
  dueDate       DateTime? @db.Timestamptz @map("due_date")
  paidAt        DateTime? @db.Timestamptz @map("paid_at")
  fileUrl       String?   @map("file_url")
  createdAt     DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  scheme        Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  supplier      Profile   @relation(fields: [supplierId], references: [id])

  @@index([schemeId, status])
  @@index([supplierId, status])
  @@map("invoices")
}

// ─── Announcements / Notices ─────────────────────────────────────
model Announcement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String    @map("scheme_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  title       String
  body        String
  priority    String    @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  isPinned    Boolean   @default(false) @map("is_pinned")
  publishedAt DateTime  @default(now()) @db.Timestamptz @map("published_at")
  expiresAt   DateTime? @db.Timestamptz @map("expires_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz @map("deleted_at")

  scheme      Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  author      Profile   @relation(fields: [authorId], references: [id])

  @@index([schemeId, publishedAt])
  @@map("announcements")
}

// ─── Insurance Tracking ─────────────────────────────────────────
model InsurancePolicy {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId       String    @map("scheme_id") @db.Uuid
  policyNumber   String    @map("policy_number")
  policyType     String    @map("policy_type") // BUILDING, STRATA, PUBLIC_LIABILITY, WORKERS_COMP, OFFICE_BEARERS, FIDELITY_GUARANTEE, MACHINERY, VOLUNTARY_WORKERS, OTHER
  insurer        String
  broker         String?
  brokerContact  String?   @map("broker_contact")
  coverageAmount Decimal   @map("coverage_amount") @db.Decimal(14, 2) // headline sum insured; itemised cover lives in coverageItems
  premium        Decimal   @db.Decimal(12, 2) // headline/base premium; itemised charges live in premiumLineItems
  excessAmount   Decimal?  @map("excess_amount") @db.Decimal(12, 2)
  startDate      DateTime  @db.Timestamptz @map("start_date")
  endDate        DateTime  @db.Timestamptz @map("end_date")
  status         String    @default("ACTIVE") // DRAFT, UPCOMING, ACTIVE, EXPIRED, CANCELLED
  renewalDate    DateTime? @db.Timestamptz @map("renewal_date")
  notes          String?

  // Insured entity / property
  insuredEntityName String? @map("insured_entity_name")
  insuredAddress    String? @map("insured_address")
  additionalInsured String? @map("additional_insured")
  // Broker / insurer contacts
  contactPerson     String? @map("contact_person")
  contactEmail      String? @map("contact_email")
  contactPhone      String? @map("contact_phone")
  claimsContact     String? @map("claims_contact")
  referenceNumbers  String? @map("reference_numbers")
  // Policy detail
  coverageSummary   String? @map("coverage_summary")
  exclusions        String?
  conditions        String?
  endorsements      String?
  // Premium / payment
  currency          String    @default("AUD")
  totalPremium      Decimal?  @map("total_premium") @db.Decimal(12, 2) // computed from premiumLineItems when present
  paymentDueDate    DateTime? @map("payment_due_date") @db.Timestamptz
  paymentStatus     String?   @map("payment_status") // UNPAID, PART_PAID, PAID
  paymentDate       DateTime? @map("payment_date") @db.Timestamptz
  paymentReference  String?   @map("payment_reference")
  invoiceDocumentId String?   @map("invoice_document_id") @db.Uuid

  createdAt      DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime  @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt      DateTime? @db.Timestamptz @map("deleted_at")

  scheme         Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  coverageItems    InsuranceCoverageItem[]
  premiumLineItems InsurancePremiumLineItem[]
  documents        InsuranceDocument[]
  claims           InsuranceClaim[]
  renewalsFrom     InsuranceRenewal[] @relation("RenewalExpiringPolicy")
  renewalSuccessor InsuranceRenewal?  @relation("RenewalSuccessorPolicy")

  @@unique([schemeId, policyNumber])
  @@index([schemeId, status])
  @@index([schemeId, endDate])
  @@map("insurance_policies")
}

// Itemised cover within a policy (building, common contents, public liability, …)
model InsuranceCoverageItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId    String   @map("policy_id") @db.Uuid
  category    String   // BUILDING, COMMON_CONTENTS, PUBLIC_LIABILITY, OFFICE_BEARERS, MACHINERY_BREAKDOWN, FIDELITY_GUARANTEE, LOSS_OF_RENT, VOLUNTARY_WORKERS, FLOOD, CATASTROPHE, OTHER
  description String?
  sumInsured  Decimal? @map("sum_insured") @db.Decimal(14, 2)
  excess      Decimal? @db.Decimal(12, 2)
  conditions  String?  // conditions or sublimits
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at")

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("insurance_coverage_items")
}

// Itemised premium charges (base, taxes, duties, levies, fees)
model InsurancePremiumLineItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId  String   @map("policy_id") @db.Uuid
  label     String
  kind      String   @default("BASE") // BASE, TAX, DUTY, LEVY, FEE, COMMISSION, OTHER
  amount    Decimal  @db.Decimal(12, 2)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("insurance_premium_line_items")
}

// Policy / claim / renewal documents with version history. Never overwrites: a new
// version supersedes the previous one, which is retained.
model InsuranceDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String   @map("scheme_id") @db.Uuid
  policyId    String?  @map("policy_id") @db.Uuid
  claimId     String?  @map("claim_id") @db.Uuid
  renewalId   String?  @map("renewal_id") @db.Uuid
  category    String   // POLICY_SCHEDULE, POLICY_WORDING_PDS, CERTIFICATE_OF_CURRENCY, ENDORSEMENT, PREMIUM_INVOICE, PAYMENT_RECEIPT, VALUATION_REPORT, BROKER_CORRESPONDENCE, CLAIM_EVIDENCE, RENEWAL_NOTICE, QUOTE, APPROVAL_EVIDENCE, OTHER
  title       String
  fileUrl     String   @map("file_url") // Supabase storage path, not a public URL
  fileName    String   @map("file_name")
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type")
  version     Int      @default(1)
  supersedesId String? @map("supersedes_id") @db.Uuid
  isCurrent   Boolean  @default(true) @map("is_current")
  accessLevel String   @default("RESTRICTED") @map("access_level") // PUBLIC, RESTRICTED, CONFIDENTIAL
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  documentDate DateTime? @db.Timestamptz @map("document_date")
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")
  deletedAt   DateTime? @db.Timestamptz @map("deleted_at")

  scheme    Scheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  policy    InsurancePolicy?  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claim     InsuranceClaim?   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  renewal   InsuranceRenewal? @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  supersedes InsuranceDocument?  @relation("DocumentVersion", fields: [supersedesId], references: [id])
  supersededBy InsuranceDocument[] @relation("DocumentVersion")

  @@index([policyId])
  @@index([claimId])
  @@index([renewalId])
  @@index([schemeId, category])
  @@map("insurance_documents")
}

// An insurance claim lodged against a policy.
model InsuranceClaim {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId        String    @map("scheme_id") @db.Uuid
  policyId        String?   @map("policy_id") @db.Uuid
  claimNumber     String?   @map("claim_number") // internal reference
  title           String
  incidentCategory String?  @map("incident_category")
  incidentDate    DateTime? @db.Timestamptz @map("incident_date")
  incidentTime    String?   @map("incident_time")
  discoveredDate  DateTime? @db.Timestamptz @map("discovered_date")
  incidentLocation String?  @map("incident_location")
  lotReference    String?   @map("lot_reference")
  commonProperty  Boolean?  @map("common_property")
  individualLot   Boolean?  @map("individual_lot")
  description     String?
  damageDetails   String?   @map("damage_details")
  immediateAction String?   @map("immediate_action")
  estimatedLoss   Decimal?  @map("estimated_loss") @db.Decimal(14, 2)
  // Reporter / contact
  reporterType    String?   @map("reporter_type") // STRATA_MANAGER, LOT_OWNER
  reporterName    String?   @map("reporter_name")
  contactEmail    String?   @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  smsUpdates      Boolean   @default(false) @map("sms_updates")
  otherParties    String?   @map("other_parties")
  insurerClaimRef String?   @map("insurer_claim_ref")
  // Status / administration
  status          String    @default("DRAFT") // DRAFT, SUBMITTED, ACKNOWLEDGED, UNDER_ASSESSMENT, FURTHER_INFO_REQUIRED, APPROVED, PARTIALLY_APPROVED, DECLINED, WITHDRAWN, CLOSED
  assignedOwnerId String?   @map("assigned_owner_id") @db.Uuid
  assessorDetails String?   @map("assessor_details")
  contractorDetails String? @map("contractor_details")
  claimedAmount   Decimal?  @map("claimed_amount") @db.Decimal(14, 2)
  approvedAmount  Decimal?  @map("approved_amount") @db.Decimal(14, 2)
  paidAmount      Decimal?  @map("paid_amount") @db.Decimal(14, 2)
  excessAmount    Decimal?  @map("excess_amount") @db.Decimal(12, 2)
  settlementDetails String? @map("settlement_details")
  decisionReason  String?   @map("decision_reason")
  // Lodgement (internal record vs actual submission)
  lodgedAt        DateTime? @db.Timestamptz @map("lodged_at")
  lodgedChannel   String?   @map("lodged_channel")
  lodgedRecipient String?   @map("lodged_recipient")
  lodgedReference String?   @map("lodged_reference")
  lodgedById      String?   @map("lodged_by_id") @db.Uuid
  closedAt        DateTime? @db.Timestamptz @map("closed_at")
  createdAt       DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime  @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt       DateTime? @db.Timestamptz @map("deleted_at")

  scheme    Scheme               @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  policy    InsurancePolicy?     @relation(fields: [policyId], references: [id], onDelete: SetNull)
  events    InsuranceClaimEvent[]
  documents InsuranceDocument[]
  tasks     InsuranceTask[]

  @@index([schemeId, status])
  @@index([policyId])
  @@map("insurance_claims")
}

// Append-only timeline / status history for a claim.
model InsuranceClaimEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId    String   @map("claim_id") @db.Uuid
  eventType  String   @map("event_type") // CREATED, STATUS_CHANGED, LODGED, NOTE, DOCUMENT_ADDED, ASSIGNED, AMOUNT_UPDATED, TASK
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  actorId    String?  @map("actor_id") @db.Uuid
  payload    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz @map("created_at")

  claim InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("insurance_claim_events")
}

// A renewal workflow linked to an expiring policy.
model InsuranceRenewal {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId           String    @map("scheme_id") @db.Uuid
  expiringPolicyId   String    @map("expiring_policy_id") @db.Uuid
  stage              String    @default("NOT_STARTED") // NOT_STARTED, INFORMATION_REQUIRED, QUOTES_REQUESTED, QUOTES_RECEIVED, UNDER_REVIEW, AWAITING_APPROVAL, PLACEMENT_REQUESTED, COVER_CONFIRMED, COMPLETED, NOT_PROCEEDING
  ownerId            String?   @map("owner_id") @db.Uuid
  dueDate            DateTime? @db.Timestamptz @map("due_date")
  reminderLeadDays   Int?      @map("reminder_lead_days")
  declaredChanges    String?   @map("declared_changes")
  outstandingInfo    String?   @map("outstanding_info")
  declaration        Json?     // pre-renewal declaration form snapshot
  selectedQuoteId    String?   @map("selected_quote_id") @db.Uuid // resolved in code (no FK, avoids cycle)
  selectionRationale String?   @map("selection_rationale")
  approvedBy         String?   @map("approved_by")
  placementInstructions String? @map("placement_instructions")
  coverConfirmedAt   DateTime? @db.Timestamptz @map("cover_confirmed_at")
  successorPolicyId  String?   @unique @map("successor_policy_id") @db.Uuid
  notProceedingReason String?  @map("not_proceeding_reason")
  notes              String?
  createdAt          DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt          DateTime  @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt          DateTime? @db.Timestamptz @map("deleted_at")

  scheme          Scheme          @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  expiringPolicy  InsurancePolicy @relation("RenewalExpiringPolicy", fields: [expiringPolicyId], references: [id], onDelete: Cascade)
  successorPolicy InsurancePolicy? @relation("RenewalSuccessorPolicy", fields: [successorPolicyId], references: [id], onDelete: SetNull)
  quotes          InsuranceRenewalQuote[]
  documents       InsuranceDocument[]

  @@index([schemeId, stage])
  @@index([expiringPolicyId])
  @@map("insurance_renewals")
}

// A renewal quote recorded for comparison.
model InsuranceRenewalQuote {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  renewalId          String    @map("renewal_id") @db.Uuid
  insurer            String
  broker             String?
  periodStart        DateTime? @db.Timestamptz @map("period_start")
  periodEnd          DateTime? @db.Timestamptz @map("period_end")
  premium            Decimal?  @db.Decimal(12, 2)
  itemisedCharges    Json?     @map("itemised_charges")
  sumInsured         Decimal?  @map("sum_insured") @db.Decimal(14, 2)
  coverageLimits     Json?     @map("coverage_limits")
  excesses           Json?
  exclusions         String?
  conditions         String?
  endorsements       String?
  materialDifferences String?  @map("material_differences")
  validUntil         DateTime? @db.Timestamptz @map("valid_until")
  notes              String?
  createdAt          DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt          DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  renewal InsuranceRenewal @relation(fields: [renewalId], references: [id], onDelete: Cascade)

  @@index([renewalId])
  @@map("insurance_renewal_quotes")
}

// Follow-up tasks / reminders for claims and renewals.
model InsuranceTask {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String    @map("scheme_id") @db.Uuid
  policyId    String?   @map("policy_id") @db.Uuid
  claimId     String?   @map("claim_id") @db.Uuid
  renewalId   String?   @map("renewal_id") @db.Uuid
  title       String
  dueDate     DateTime? @db.Timestamptz @map("due_date")
  status      String    @default("OPEN") // OPEN, DONE, CANCELLED
  assignedTo  String?   @map("assigned_to") @db.Uuid
  notes       String?
  completedAt DateTime? @db.Timestamptz @map("completed_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  scheme Scheme          @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  claim  InsuranceClaim? @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([schemeId, status])
  @@index([claimId])
  @@map("insurance_tasks")
}

// ─── Contacts / Contractor Directory ───────────────────────────
model Contact {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String    @map("scheme_id") @db.Uuid
  name        String
  company     String?
  category    String // PLUMBER, ELECTRICIAN, BUILDER, GARDENER, CLEANER, LOCKSMITH, PEST_CONTROL, FIRE_SAFETY, LIFT, POOL, BODY_CORPORATE, LEGAL, ACCOUNTING, INSURANCE_BROKER, OTHER
  phone       String?
  email       String?
  address     String?
  notes       String?
  isPreferred Boolean   @default(false) @map("is_preferred")
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz @map("deleted_at")

  scheme      Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId, category])
  @@map("contacts")
}

// ─── By-Laws Register ───────────────────────────────────────────
model ByLaw {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId      String    @map("scheme_id") @db.Uuid
  bylawNumber   Int       @map("bylaw_number")
  title         String
  body          String
  category      String    @default("GENERAL") // GENERAL, SAFETY, PARKING, PETS, NOISE, APPEARANCE, BEHAVIOUR, OTHER
  status        String    @default("ACTIVE") // ACTIVE, AMENDED, REPEALED
  effectiveDate DateTime  @db.Timestamptz @map("effective_date")
  amendedDate   DateTime? @db.Timestamptz @map("amended_date")
  repealedDate  DateTime? @db.Timestamptz @map("repealed_date")
  motionRef     String?   @map("motion_ref") // reference to the resolution/motion that enacted this
  notes         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime  @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt     DateTime? @db.Timestamptz @map("deleted_at")

  scheme        Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, bylawNumber])
  @@index([schemeId, status])
  @@map("bylaws")
}

// ─── Document Management ─────────────────────────────────────────
model Document {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId     String    @map("scheme_id") @db.Uuid
  title        String
  description  String?
  category     String // MINUTES, INSURANCE, BYLAW, FINANCIAL, COMPLIANCE, OTHER
  documentType String?   @map("document_type") // More granular: STRATA_PLAN, BY_LAW, SCHEDULE, NOTICE, CERTIFICATE, CORRESPONDENCE, REPORT, CONTRACT, OTHER
  fileUrl      String    @map("file_url")
  fileName     String    @map("file_name")
  fileSize     Int?      @map("file_size")
  mimeType     String?   @map("mime_type")
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  documentDate DateTime? @db.Timestamptz @map("document_date")
  strataPlan   String?   @map("strata_plan")
  schedule     String?
  lotNumber    String?   @map("lot_number")
  supplier     String?
  comments     String?
  /// Who may see it (security stage S3): ALL_MEMBERS, COMMITTEE, LOT_OWNERS (owners of lotNumber) or MANAGEMENT.
  visibility   String    @default("ALL_MEMBERS")
  createdAt    DateTime  @default(now()) @db.Timestamptz @map("created_at")
  deletedAt    DateTime? @db.Timestamptz @map("deleted_at")

  scheme       Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ─── Compliance Tracker ──────────────────────────────────────────
model ComplianceItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String    @map("scheme_id") @db.Uuid
  title       String
  description String?
  category    String // INSURANCE, FIRE_SAFETY, OHS, BUILDING, OTHER
  dueDate     DateTime? @db.Timestamptz @map("due_date")
  status      String    @default("PENDING")
  lastChecked DateTime? @db.Timestamptz @map("last_checked")
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz @map("deleted_at")

  scheme      Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@map("compliance_items")
}

// ─── Invitations ─────────────────────────────────────────────────
model Invitation {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId    String     @map("scheme_id") @db.Uuid
  email       String
  role        PortalRole
  lotId       String?    @map("lot_id") @db.Uuid
  token       String     @unique @default(dbgenerated("gen_random_uuid()"))
  status      String     @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED
  invitedById String     @map("invited_by_id") @db.Uuid
  expiresAt   DateTime   @db.Timestamptz @map("expires_at")
  acceptedAt  DateTime?  @db.Timestamptz @map("accepted_at")
  createdAt   DateTime   @default(now()) @db.Timestamptz @map("created_at")

  scheme      Scheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  invitedBy   Profile    @relation("InvitedBy", fields: [invitedById], references: [id])
  lot         Lot?       @relation(fields: [lotId], references: [id])

  @@unique([schemeId, email, role])
  @@map("invitations")
}

// ─── Activity Log / Audit Trail ─────────────────────────────────
model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId   String   @map("scheme_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String // LEVY_CREATED, LEVY_ISSUED, INVITATION_SENT, MEMBER_JOINED, DOCUMENT_UPLOADED, WORK_ORDER_CREATED, MEETING_SCHEDULED, COMPLIANCE_UPDATED, SCHEME_UPDATED, MEMBER_REMOVED
  entityType String   @map("entity_type") // Levy, Invitation, SchemeMembership, Document, WorkOrder, Meeting, ComplianceItem, Scheme
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json? // Additional context (e.g. { levyTitle: "Q1 FY26", amount: 10000 })
  createdAt  DateTime @default(now()) @db.Timestamptz @map("created_at")

  scheme     Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  actor      Profile  @relation(fields: [actorId], references: [id])

  @@index([schemeId, createdAt])
  @@map("activity_logs")
}

// ─── Financial Management Module ────────────────────────────────
model SchemeBankAccount {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId              String            @map("scheme_id") @db.Uuid
  accountName           String            @map("account_name")
  bsb                   String            @db.VarChar(7)
  accountNumber         String            @map("account_number") @db.VarChar(20)
  bankName              String?           @map("bank_name")
  accountType           String            @default("CHEQUE") @map("account_type") // CHEQUE, SAVINGS, TRUST, TERM_DEPOSIT
  isOperating           Boolean           @default(false) @map("is_operating")
  isActive              Boolean           @default(true) @map("is_active")
  lastReconciledDate    DateTime?         @db.Date @map("last_reconciled_date")
  lastReconciledBalance Decimal?          @db.Decimal(12, 2) @map("last_reconciled_balance")
  bankFeedEnabled       Boolean           @default(false) @map("bank_feed_enabled")
  /// Saved CSV column mapping (JSON, by header name), pre-selected on the next import.
  csvMapping             String?             @map("csv_mapping")
  createdAt             DateTime          @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime          @updatedAt @db.Timestamptz @map("updated_at")

  scheme                Scheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  funds                 Fund[]
  bankTransactions      BankTransaction[]

  @@index([schemeId])
  @@map("scheme_bank_accounts")
}

model AccountCode {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId         String            @map("scheme_id") @db.Uuid
  code             String            @db.VarChar(10)
  name             String            @db.VarChar(200)
  accountType      String            @map("account_type") // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  accountSubType   String?           @map("account_sub_type") // BANK, ACCOUNTS_RECEIVABLE, ACCOUNTS_PAYABLE, LEVY_INCOME, etc.
  fundId           String?           @map("fund_id") @db.Uuid
  parentAccountId  String?           @map("parent_account_id") @db.Uuid
  isSystemAccount  Boolean           @default(false) @map("is_system_account")
  isActive         Boolean           @default(true) @map("is_active")
  gstApplicable    Boolean           @default(false) @map("gst_applicable")
  description      String?
  createdAt        DateTime          @default(now()) @db.Timestamptz @map("created_at")
  updatedAt        DateTime          @updatedAt @db.Timestamptz @map("updated_at")

  scheme           Scheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  fund             Fund?             @relation(fields: [fundId], references: [id])
  parentAccount    AccountCode?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts    AccountCode[]     @relation("AccountHierarchy")
  journalLines     JournalLine[]
  supplierInvoices SupplierInvoice[]
  matchingRules    MatchingRule[]

  @@unique([schemeId, code])
  @@index([schemeId, accountType])
  @@map("account_codes")
}

model FinancialPeriod {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId   String    @map("scheme_id") @db.Uuid
  name       String    @db.VarChar(100)
  startDate  DateTime  @db.Date @map("start_date")
  endDate    DateTime  @db.Date @map("end_date")
  periodType String    @map("period_type") // MONTH, QUARTER, HALF_YEAR, FULL_YEAR
  status     String    @default("OPEN") // OPEN, CLOSED, LOCKED
  closedAt   DateTime? @db.Timestamptz @map("closed_at")
  closedBy   String?   @map("closed_by") @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz @map("created_at")

  scheme     Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, startDate, endDate])
  @@index([schemeId, status])
  @@map("financial_periods")
}

model JournalEntry {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId         String            @map("scheme_id") @db.Uuid
  entryNumber      String            @map("entry_number") @db.VarChar(20)
  transactionDate  DateTime          @db.Date @map("transaction_date")
  postingDate      DateTime          @default(now()) @db.Date @map("posting_date")
  description      String            @db.VarChar(500)
  entryType        String            @map("entry_type") // LEVY_RAISED, RECEIPT, INVOICE, PAYMENT, BANK_FEE, INTEREST, TRANSFER, ADJUSTMENT, OPENING_BALANCE, REVERSAL
  sourceType       String            @map("source_type") // LEVY_ISSUE, PAYMENT_RECEIPT, SUPPLIER_INVOICE, SUPPLIER_PAYMENT, BANK_FEE, INTEREST, TRANSFER, MANUAL_JOURNAL, ADJUSTMENT, REVERSAL
  sourceId         String?           @map("source_id") @db.Uuid
  rulePack         String?           @map("rule_pack") @db.VarChar(40) // the rule pack an interest charge was worked out under; null for other entries
  status           String            @default("DRAFT") // DRAFT, POSTED, REVERSED
  reversalOfId     String?           @map("reversal_of_id") @db.Uuid
  postedAt         DateTime?         @db.Timestamptz @map("posted_at")
  postedBy         String?           @map("posted_by") @db.Uuid
  createdBy        String            @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz @map("created_at")

  scheme           Scheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  reversalOf       JournalEntry?     @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy       JournalEntry[]    @relation("JournalReversal")
  lines            JournalLine[]
  bankTransactions BankTransaction[]

  @@unique([schemeId, entryNumber])
  @@index([schemeId, transactionDate])
  @@index([schemeId, entryType])
  @@index([schemeId, status])
  @@map("journal_entries")
}

model JournalLine {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId    String           @map("journal_entry_id") @db.Uuid
  accountCodeId     String           @map("account_code_id") @db.Uuid
  fundId            String           @map("fund_id") @db.Uuid
  debit             Decimal?         @db.Decimal(12, 2)
  credit            Decimal?         @db.Decimal(12, 2)
  description       String?          @db.VarChar(500)
  lotId             String?          @map("lot_id") @db.Uuid
  supplierId        String?          @map("supplier_id") @db.Uuid
  gstAmount         Decimal?         @db.Decimal(12, 2) @map("gst_amount")
  bankTransactionId String?          @map("bank_transaction_id") @db.Uuid

  journalEntry      JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode       AccountCode      @relation(fields: [accountCodeId], references: [id])
  fund              Fund             @relation(fields: [fundId], references: [id])
  lot               Lot?             @relation(fields: [lotId], references: [id])
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@index([journalEntryId])
  @@index([accountCodeId])
  @@index([fundId])
  @@map("journal_lines")
}

model BankTransaction {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId         String              @map("bank_account_id") @db.Uuid
  schemeId              String              @map("scheme_id") @db.Uuid
  transactionDate       DateTime            @db.Date @map("transaction_date")
  amount                Decimal             @db.Decimal(12, 2) // positive = credit/receipt, negative = debit/payment
  description           String              @db.VarChar(500)
  reference             String?             @db.VarChar(100)
  balance               Decimal?            @db.Decimal(12, 2)
  importSource          String              @map("import_source") // MANUAL, CSV_IMPORT, OFX_IMPORT, BANK_FEED
  importBatchId         String?             @map("import_batch_id") @db.Uuid
  importedAt            DateTime            @default(now()) @db.Timestamptz @map("imported_at")
  reconciliationStatus  String              @default("UNMATCHED") @map("reconciliation_status") // UNMATCHED, MATCHED, RECONCILED, EXCLUDED
  matchedJournalEntryId String?             @map("matched_journal_entry_id") @db.Uuid
  matchedAt             DateTime?           @db.Timestamptz @map("matched_at")
  matchedBy             String?             @map("matched_by") @db.Uuid
  isDuplicate           Boolean             @default(false) @map("is_duplicate")
  /// OFX FITID: the bank's own id for the transaction, used to skip it if imported again.
  fitid                 String?             @db.VarChar(255)
  /// Why the transaction was excluded from reconciliation.
  exclusionReason       String?             @map("exclusion_reason")

  bankAccount           SchemeBankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  scheme                Scheme              @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  matchedJournalEntry   JournalEntry?       @relation(fields: [matchedJournalEntryId], references: [id])
  journalLines          JournalLine[]
  financialDocuments    FinancialDocument[]

  matchingRuleId        String?             @map("matching_rule_id") @db.Uuid
  matchingRule          MatchingRule?        @relation(fields: [matchingRuleId], references: [id])

  @@index([bankAccountId, transactionDate])
  @@index([schemeId, reconciliationStatus])
  @@index([bankAccountId, amount, transactionDate]) // for duplicate detection
  @@map("bank_transactions")
}

model MatchingRule {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId          String              @map("scheme_id") @db.Uuid
  name              String              @db.VarChar(200)
  description       String?             @db.VarChar(500)
  isActive          Boolean             @default(true) @map("is_active")

  // Match criteria
  matchType         String              @map("match_type") // DESCRIPTION, REFERENCE, AMOUNT, DESCRIPTION_AND_AMOUNT
  descriptionPattern String?            @map("description_pattern") @db.VarChar(500) // substring or regex to match
  referencePattern  String?             @map("reference_pattern") @db.VarChar(200)
  exactAmount       Decimal?            @db.Decimal(12, 2) @map("exact_amount")
  minAmount         Decimal?            @db.Decimal(12, 2) @map("min_amount")
  maxAmount         Decimal?            @db.Decimal(12, 2) @map("max_amount")
  transactionSign   String?             @map("transaction_sign") // CREDIT, DEBIT, ANY

  // Action when matched
  targetAccountCodeId String?           @map("target_account_code_id") @db.Uuid
  targetFundId      String?             @map("target_fund_id") @db.Uuid
  autoPost          Boolean             @default(false) @map("auto_post")

  priority          Int                 @default(0) // higher = checked first
  matchCount        Int                 @default(0) @map("match_count")
  lastMatchedAt     DateTime?           @db.Timestamptz @map("last_matched_at")
  createdAt         DateTime            @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime            @updatedAt @db.Timestamptz @map("updated_at")

  scheme            Scheme              @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  targetAccountCode AccountCode?        @relation(fields: [targetAccountCodeId], references: [id])
  targetFund        Fund?               @relation(fields: [targetFundId], references: [id])
  matchedTransactions BankTransaction[]

  @@index([schemeId, isActive])
  @@map("matching_rules")
}

model LevySchedule {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId         String       @map("scheme_id") @db.Uuid
  fundId           String       @map("fund_id") @db.Uuid
  financialYear    Int          @map("financial_year")
  budgetAmount     Decimal      @db.Decimal(12, 2) @map("budget_amount")
  frequency        String // QUARTERLY, MONTHLY, HALF_YEARLY, ANNUALLY, ONE_OFF (special levies)
  levyType         String       @default("ORDINARY") @map("levy_type") // ORDINARY (budget), SPECIAL
  title            String?
  description      String?
  dueDate          DateTime?    @db.Date @map("due_date") // special levies: the single due date
  /// The first instalment's due date, entered at onboarding.
  firstDueDate     DateTime?    @db.Date @map("first_due_date")
  /// Instalments the previous manager raised before the takeover, as
  /// comma-separated instalment numbers ("1,2"); not raised again.
  raisedBeforeTakeover String?  @map("raised_before_takeover")
  totalLots        Int          @map("total_lots")
  totalEntitlement Decimal      @db.Decimal(10, 2) @map("total_entitlement")
  status           String       @default("DRAFT") // DRAFT, APPROVED, ACTIVE, SUPERSEDED
  approvedAt       DateTime?    @db.Timestamptz @map("approved_at")
  approvedBy       String?      @map("approved_by") @db.Uuid
  /// The adopted capital works fund plan this schedule was generated from, if any.
  capitalWorksPlanId String?    @map("capital_works_plan_id") @db.Uuid
  /// The cutover this schedule holds brought-forward notices for, if any.
  migrationBatchId String?     @map("migration_batch_id") @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz @map("created_at")
  updatedAt        DateTime     @updatedAt @db.Timestamptz @map("updated_at")

  scheme           Scheme       @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  fund             Fund         @relation(fields: [fundId], references: [id])
  levyNotices      LevyNotice[]

  @@index([schemeId, financialYear])
  @@map("levy_schedules")
}

model LevyNotice {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId           String              @map("scheme_id") @db.Uuid
  levyScheduleId     String              @map("levy_schedule_id") @db.Uuid
  lotId              String              @map("lot_id") @db.Uuid
  ownerId            String?             @map("owner_id") @db.Uuid // owner profile when the lot has one
  fundId             String              @map("fund_id") @db.Uuid
  noticeNumber       String              @map("notice_number") @db.VarChar(20)
  periodStart        DateTime            @db.Date @map("period_start")
  periodEnd          DateTime            @db.Date @map("period_end")
  dueDate            DateTime            @db.Date @map("due_date")
  amountDue          Decimal             @db.Decimal(12, 2) @map("amount_due")
  amountPaid         Decimal             @default(0) @db.Decimal(12, 2) @map("amount_paid")
  balanceOutstanding Decimal             @db.Decimal(12, 2) @map("balance_outstanding")
  interestCharged    Decimal             @default(0) @db.Decimal(12, 2) @map("interest_charged")
  /// For a notice brought across at takeover: the interest the old system had
  /// charged and received, which interestCharged and amountPaid include. Kept
  /// apart so interest charged here is worked out on its own (review B8).
  migratedInterestCharged Decimal        @default(0) @db.Decimal(12, 2) @map("migrated_interest_charged")
  migratedInterestPaid    Decimal        @default(0) @db.Decimal(12, 2) @map("migrated_interest_paid")
  status             String              @default("DRAFT") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, WRITTEN_OFF
  issuedAt           DateTime?           @db.Timestamptz @map("issued_at")
  /// Issued, and its levy not yet posted in the ledger (25 Oct 2026). Set
  /// when a notice is issued and cleared once the levy is posted; the daily
  /// job posts any left pending by a run that stopped part way.
  levyPostPending    Boolean             @default(false) @map("levy_post_pending")
  /// When the notice was emailed to the owner (from 25 Oct 2026), so a
  /// failed email is sent again.
  emailedAt          DateTime?           @db.Timestamptz @map("emailed_at")
  paidInFullAt       DateTime?           @db.Timestamptz @map("paid_in_full_at")
  /// The cutover this notice was brought across in, if any.
  migrationBatchId   String?             @map("migration_batch_id") @db.Uuid
  rulePack           String?             @map("rule_pack") @db.VarChar(40) // the rule pack the notice was issued under, e.g. "AU-NSW 2026.10.1"; null before rule packs were recorded and for takeover notices
  /// The part of amountDue that pays for insurance, where the contribution was split (Queensland, Standard Module
  /// s 162(5)): shared by the interest schedule, the rest by the contribution schedule. Null for every other notice.
  insuranceAmount    Decimal?            @db.Decimal(12, 2) @map("insurance_amount")
  createdAt          DateTime            @default(now()) @db.Timestamptz @map("created_at")
  updatedAt          DateTime            @updatedAt @db.Timestamptz @map("updated_at")

  scheme             Scheme              @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  levySchedule       LevySchedule        @relation(fields: [levyScheduleId], references: [id])
  lot                Lot                 @relation(fields: [lotId], references: [id])
  fund               Fund                @relation(fields: [fundId], references: [id])
  financialDocuments FinancialDocument[]
  payments           LevyPayment[]
  lateChargeWaivers  LateChargeWaiver[]

  @@unique([schemeId, noticeNumber])
  @@index([schemeId, status])
  @@index([lotId, status])
  @@index([ownerId])
  @@map("levy_notices")
}

/// One payment received against a levy notice (the receipt record behind
/// LevyNotice.amountPaid), so statements can show each payment and its date.
model LevyPayment {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId     String     @map("scheme_id") @db.Uuid
  levyNoticeId String     @map("levy_notice_id") @db.Uuid
  lotId        String     @map("lot_id") @db.Uuid
  amount       Decimal    @db.Decimal(12, 2)
  /// The part of the payment applied to the late charge, where the building
  /// applies payments to it first (Queensland's penalty, Standard Module
  /// s 166(5); 20261117). Its receipt journal carries the same amount. 0 where
  /// payments go to the levy first (NSW).
  lateChargeAmount Decimal @default(0) @db.Decimal(12, 2) @map("late_charge_amount")
  paymentDate  DateTime   @db.Date @map("payment_date")
  reference    String?
  recordedBy   String?    @map("recorded_by") @db.Uuid
  /// The receipt journal this payment was posted in.
  journalEntryId         String?    @map("journal_entry_id") @db.Uuid
  /// Set when the payment is reversed (wrong lot, dishonoured, entered in error).
  reversedAt             DateTime?  @db.Timestamptz @map("reversed_at")
  /// The date the reversal took effect, such as the date the bank dishonoured it.
  reversalDate           DateTime?  @db.Date @map("reversal_date")
  /// WRONG_LOT, DISHONOURED or ENTERED_IN_ERROR.
  reversalReason         String?    @map("reversal_reason")
  reversalNote           String?    @map("reversal_note")
  reversalJournalEntryId String?    @map("reversal_journal_entry_id") @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz @map("created_at")

  levyNotice   LevyNotice @relation(fields: [levyNoticeId], references: [id], onDelete: Cascade)

  @@index([levyNoticeId])
  @@index([schemeId, paymentDate])
  @@index([lotId])
  @@map("levy_payments")
}

model Supplier {
