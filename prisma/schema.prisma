  quotation       WorksQuotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("works_quotation_line_items")
}

model WorksEvaluation {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rfqId           String           @map("rfq_id") @db.Uuid
  quotationId     String?          @map("quotation_id") @db.Uuid
  evaluatorId     String           @map("evaluator_id") @db.Uuid
  overallScore    Decimal?         @db.Decimal(5, 2) @map("overall_score")
  comments        String?
  evaluatedAt     DateTime         @default(now()) @db.Timestamptz @map("evaluated_at")
