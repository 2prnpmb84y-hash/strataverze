  @@unique([bankTransactionId, journalEntryId])
  @@index([schemeId])
  @@index([journalEntryId])
  @@map("bank_transaction_allocations")
}

/// An unidentified bank amount posted to the suspense account. Must be cleared
/// to the right account before the period it falls in can be closed.
model SuspenseItem {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId              String    @map("scheme_id") @db.Uuid
  bankTransactionId     String    @map("bank_transaction_id") @db.Uuid
  journalEntryId        String    @map("journal_entry_id") @db.Uuid
  /// Signed: positive for money received, negative for money paid out.
  amount                Decimal   @db.Decimal(12, 2)
  transactionDate       DateTime  @db.Date @map("transaction_date")
  description           String
  status                String    @default("OPEN")
  clearedJournalEntryId String?   @map("cleared_journal_entry_id") @db.Uuid
  clearedNote           String?   @map("cleared_note")
  clearedBy             String?   @map("cleared_by") @db.Uuid
  clearedAt             DateTime? @db.Timestamptz @map("cleared_at")
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz @map("created_at")

  @@index([schemeId, status])
  @@map("suspense_items")
}

/// A budget for one fund and financial year. Adopted budgets are read-only; a
/// change creates a new version. Budget levy schedules need an adopted budget.
model Budget {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId         String    @map("scheme_id") @db.Uuid
  fundId           String    @map("fund_id") @db.Uuid
  financialYear    Int       @map("financial_year")
  version          Int       @default(1)
  status           String    @default("DRAFT")
  adoptedMeetingId String?   @map("adopted_meeting_id") @db.Uuid
  adoptedMotionId  String?   @map("adopted_motion_id") @db.Uuid
  adoptedAt        DateTime? @db.Timestamptz @map("adopted_at")
  adoptedBy        String?   @map("adopted_by") @db.Uuid
  /// The date of the general meeting, held before StrataVerze took over, that adopted this budget (onboarding).
  adoptedBeforeTakeoverOn DateTime? @db.Date @map("adopted_before_takeover_on")
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt        DateTime  @default(now()) @db.Timestamptz @map("updated_at")

  @@unique([fundId, financialYear, version])
  @@index([schemeId, financialYear])
  @@map("budgets")
}

/// Capital works fund plan (SSMA 2015 s 80): anticipated major expenditure for
/// at least the next 10 years, reviewed at least every 5 years.
model CapitalWorksPlan {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId              String    @map("scheme_id") @db.Uuid
  title                 String
  preparedBy            String?   @map("prepared_by")
  preparedAt            DateTime  @db.Date @map("prepared_at")
  periodStartYear       Int       @map("period_start_year")
  reviewDueAt           DateTime  @db.Date @map("review_due_at")
  openingBalance        Decimal   @default(0) @db.Decimal(12, 2) @map("opening_balance")
  contributionMethod    String    @default("LEVEL") @map("contribution_method")
  annualContribution    Decimal?  @db.Decimal(12, 2) @map("annual_contribution")
  status                String    @default("DRAFT")
  adoptedMeetingId      String?   @map("adopted_meeting_id") @db.Uuid
  adoptedMotionId       String?   @map("adopted_motion_id") @db.Uuid
  adoptedAt             DateTime? @db.Timestamptz @map("adopted_at")
  complianceItemId      String?   @map("compliance_item_id") @db.Uuid
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz @map("created_at")

  items                 CapitalWorksPlanItem[]

  @@index([schemeId, status])
  @@map("capital_works_plans")
}

model CapitalWorksPlanItem {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId        String           @map("plan_id") @db.Uuid
  description   String
  component     String?
  plannedYear   Int              @map("planned_year")
  estimatedCost Decimal          @db.Decimal(12, 2) @map("estimated_cost")
  fundingSource String           @default("CAPITAL_WORKS_FUND") @map("funding_source")
  notes         String?
