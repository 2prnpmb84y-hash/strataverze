  lotId               String                @map("lot_id") @db.Uuid
  ownerId             String                @map("owner_id") @db.Uuid
  caseNumber          String                @unique @map("case_number") @db.VarChar(30) // e.g. DR-2026-0001
  // Debt summary
  principalOwed       Decimal               @db.Decimal(12, 2) @map("principal_owed")
  interestOwed        Decimal               @default(0) @db.Decimal(12, 2) @map("interest_owed")
  costsOwed           Decimal               @default(0) @db.Decimal(12, 2) @map("costs_owed")
  totalOwed           Decimal               @db.Decimal(12, 2) @map("total_owed")
  // Status tracking
  status              String                @default("OPEN") // OPEN, IN_PROGRESS, PAYMENT_PLAN, ON_HOLD, REFERRED_LEGAL, CLOSED_PAID, CLOSED_WRITTEN_OFF, CLOSED_SETTLED
  currentStep         String                @default("LEDGER_VERIFICATION") @map("current_step")
  rulePack            String?               @map("rule_pack") @db.VarChar(40) // the rule pack the case's steps came from; null before rule packs were recorded
  // LEDGER_VERIFICATION, INITIAL_CONTACT, REMINDER_NOTICE, FINAL_NOTICE, HARDSHIP_REVIEW, COMMITTEE_REVIEW, LEGAL_REFERRAL, PROCEEDINGS, ENFORCEMENT, CLOSED
  priority            String                @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  // Initiator
  initiatedBy         String                @map("initiated_by") @db.Uuid
  initiatedRole       String                @map("initiated_role") // COMMITTEE, ADVISER
  // Authority and approvals
  committeeApproval   Boolean               @default(false) @map("committee_approval")
  approvalMotionId    String?               @map("approval_motion_id") @db.Uuid
  approvalDate        DateTime?             @db.Date @map("approval_date")
  // Legal tracking
  solicitorRef        String?               @map("solicitor_ref") @db.VarChar(100)
  solicitorName       String?               @map("solicitor_name") @db.VarChar(200)
  courtFileNumber     String?               @map("court_file_number") @db.VarChar(50)
  // Dispute and hardship
  hasDispute          Boolean               @default(false) @map("has_dispute")
  disputeDetails      String?               @map("dispute_details")
  hasHardshipRequest  Boolean               @default(false) @map("has_hardship_request")
  hardshipDetails     String?               @map("hardship_details")
  // Exclusion
  excludeFromRecovery Boolean               @default(false) @map("exclude_from_recovery")
  exclusionReason     String?               @map("exclusion_reason")
  // Metadata
  notes               String?
  closedAt            DateTime?             @db.Timestamptz @map("closed_at")
  closedReason        String?               @map("closed_reason")
  createdAt           DateTime              @default(now()) @db.Timestamptz @map("created_at")
  updatedAt           DateTime              @updatedAt @db.Timestamptz @map("updated_at")

  scheme              Scheme                @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  lot                 Lot                   @relation(fields: [lotId], references: [id])
  owner               Profile               @relation("DebtRecoveryCaseOwner", fields: [ownerId], references: [id])
  initiator           Profile               @relation("DebtRecoveryCaseInitiator", fields: [initiatedBy], references: [id])
  approvalMotion      Motion?               @relation(fields: [approvalMotionId], references: [id])
  steps               DebtRecoveryStep[]
  paymentPlans        PaymentPlan[]
  paymentPlanRequests PaymentPlanRequest[]
  documents           DebtRecoveryDocument[]
  activityLog         DebtRecoveryActivity[]
  records             DebtRecoveryRecord[]

  @@index([schemeId, status])
  @@index([lotId])
  @@index([ownerId])
  @@map("debt_recovery_cases")
}

// Facts recorded on a debt recovery case under a draft pack's recovery rules (VIC, ACT and WA stage 2, PR 9a,
// migration 20261125), written in the same transaction as the step that records them: the resolution that
// decided to start proceedings (AUTHORITY_TO_SUE, with the lot's amount owing when the step is completed), where proceedings were
// started (PROCEEDINGS_STARTED, forum), and from PR 9b and 9c the statutory charge and the final notice. Read
// and written only for a pack with DEBT_RECOVERY.forum or authorityToSue (and the later keys); NSW and
// Queensland have none. The meeting and agenda item have foreign keys in the database (NO ACTION), not
// declared here, as for the waivers.
model DebtRecoveryRecord {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId              String    @map("case_id") @db.Uuid
  schemeId            String    @map("scheme_id") @db.Uuid
  state               String    // VIC, ACT, WA
  kind                String    // AUTHORITY_TO_SUE, FINAL_NOTICE_GIVEN, PROCEEDINGS_STARTED, STATUTORY_CHARGE_LODGED, STATUTORY_CHARGE_REVOKED
  decidedOn           DateTime  @db.Date @map("decided_on") // the day the resolution took effect, or the day recorded
  resolutionMeetingId String?   @map("resolution_meeting_id") @db.Uuid
  resolutionItemId    String?   @map("resolution_item_id") @db.Uuid
  resolutionKind      String?   @map("resolution_kind") // GENERAL_MEETING, ORDINARY, SPECIAL, COMMITTEE
  amount              Decimal?  @db.Decimal(12, 2) // AUTHORITY_TO_SUE only: the lot's amount owing when the step was completed
  forum               String?   // PROCEEDINGS_STARTED only: VCAT, ACAT, COURT
  lodgedOn            DateTime? @db.Date @map("lodged_on") // the statutory charge and its revocation only
  rulePack            String    @map("rule_pack") @db.VarChar(40)
  recordedBy          String    @map("recorded_by") @db.Uuid
  recordedAt          DateTime  @default(now()) @db.Timestamptz @map("recorded_at")
  notes               String?

  debtCase            DebtRecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  scheme              Scheme           @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([caseId, kind])
  @@index([schemeId])
  @@map("debt_recovery_records")
}

model DebtRecoveryStep {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId            String             @map("case_id") @db.Uuid
  stepType          String             @map("step_type")
  // LEDGER_VERIFICATION, INITIAL_CONTACT, REMINDER_NOTICE, FINAL_NOTICE, HARDSHIP_REVIEW, COMMITTEE_REVIEW, LEGAL_REFERRAL, PROCEEDINGS, ENFORCEMENT, CLOSED
  stepOrder         Int                @map("step_order")
  status            String             @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SKIPPED, BLOCKED
  // Action details
  actionRequired    String             @map("action_required") // Description of what must be done
  legalBasis        String?            @map("legal_basis") // e.g. "s 83 SSMA 2015"
  responsibleParty  String             @map("responsible_party") // COMMITTEE, ADVISER, SOLICITOR, TRIBUNAL
  approvalRequired  Boolean            @default(false) @map("approval_required")
  approvedBy        String?            @map("approved_by") @db.Uuid
  approvedAt        DateTime?          @db.Timestamptz @map("approved_at")
  // Timing
  triggerCondition  String?            @map("trigger_condition") // e.g. "14 days after reminder"
  dueDate           DateTime?          @db.Date @map("due_date")
  completedAt       DateTime?          @db.Timestamptz @map("completed_at")
  completedBy       String?            @map("completed_by") @db.Uuid
  // Correspondence
  noticeType        String?            @map("notice_type") // REMINDER, DEMAND, FINAL_DEMAND, STATUTORY_NOTICE
  noticeSentAt      DateTime?          @db.Timestamptz @map("notice_sent_at")
  noticeMethod      String?            @map("notice_method") // EMAIL, POST, REGISTERED_POST, PERSONAL_SERVICE
  // Evidence and outcome
  evidenceNotes     String?            @map("evidence_notes")
  outcome           String?            // Description of what happened
  notes             String?
  createdAt         DateTime           @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime           @updatedAt @db.Timestamptz @map("updated_at")

  case              DebtRecoveryCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, stepOrder])
  @@map("debt_recovery_steps")
}

model PaymentPlan {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId              String?               @map("case_id") @db.Uuid // null for a plan agreed without a recovery case
  schemeId            String                @map("scheme_id") @db.Uuid
  lotId               String                @map("lot_id") @db.Uuid
  requestId           String?               @unique @map("request_id") @db.Uuid // the owner's request on the standard form
  agreedOn            DateTime?             @db.Date @map("agreed_on")
  coversCurrentLevies Boolean               @default(false) @map("covers_current_levies")
  // For the payment plan statement, as at agreement
  leviesOwing         Decimal?              @db.Decimal(12, 2) @map("levies_owing")
  interestOwing       Decimal?              @db.Decimal(12, 2) @map("interest_owing")
  interestMethod      String?               @map("interest_method")
  paymentMethods      String?               @map("payment_methods")
  contactDetails      String?               @map("contact_details")
  rulePack            String?               @map("rule_pack") @db.VarChar(40)
  // Plan terms
  totalAmount         Decimal               @db.Decimal(12, 2) @map("total_amount")
  instalmentAmount    Decimal               @db.Decimal(12, 2) @map("instalment_amount")
  frequency           String                // WEEKLY, FORTNIGHTLY, MONTHLY
  startDate           DateTime              @db.Date @map("start_date")
  endDate             DateTime              @db.Date @map("end_date")
  numberOfInstalments Int                   @map("number_of_instalments")
  // Interest and ongoing levies
  includesInterest    Boolean               @default(false) @map("includes_interest")
  includesOngoing     Boolean               @default(false) @map("includes_ongoing") // includes ongoing levy contributions
  interestWaived      Boolean               @default(false) @map("interest_waived")
  // Status
  status              String                @default("PROPOSED") // PROPOSED, ACTIVE, COMPLETED, DEFAULTED, CANCELLED
  approvedBy          String?               @map("approved_by") @db.Uuid
  approvedAt          DateTime?             @db.Timestamptz @map("approved_at")
  defaultedAt         DateTime?             @db.Timestamptz @map("defaulted_at")
  defaultReason       String?               @map("default_reason")
  // Conditions
  conditions          String?               // any special conditions
  notes               String?
  createdAt           DateTime              @default(now()) @db.Timestamptz @map("created_at")
  updatedAt           DateTime              @updatedAt @db.Timestamptz @map("updated_at")

  case                DebtRecoveryCase?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  scheme              Scheme                @relation(fields: [schemeId], references: [id])
  lot                 Lot                   @relation(fields: [lotId], references: [id])
  request             PaymentPlanRequest?   @relation("PaymentPlanFromRequest", fields: [requestId], references: [id], onDelete: SetNull)
  instalments         PaymentPlanInstalment[]

  @@index([schemeId])
  @@index([lotId])
  @@index([caseId])
  @@map("payment_plans")
}

/// An owner's request for a payment plan on the standard form, and the
/// decision of the owners corporation or strata committee meeting on it.
model PaymentPlanRequest {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId                String            @map("scheme_id") @db.Uuid
  lotId                   String            @map("lot_id") @db.Uuid
  caseId                  String?           @map("case_id") @db.Uuid
  // As on the form
  ownerNames              String            @map("owner_names")
  hardshipStatement       Boolean           @map("hardship_statement")
  currentDebt             Decimal?          @db.Decimal(12, 2) @map("current_debt")
  proposedInstalment      Decimal?          @db.Decimal(12, 2) @map("proposed_instalment")
  proposedFrequency       String?           @map("proposed_frequency")
  proposedMonths          Int?              @map("proposed_months")
  interestWaiverRequested Boolean           @default(false) @map("interest_waiver_requested")
  receivedOn              DateTime          @db.Date @map("received_on")
  replyDueOn              DateTime          @db.Date @map("reply_due_on")
  source                  String            // OWNER_PORTAL, RECEIVED
  submittedBy             String?           @map("submitted_by") @db.Uuid
  // Decision
  status                  String            @default("RECEIVED") // RECEIVED, APPROVED, REFUSED, WITHDRAWN
  decisionBody            String?           @map("decision_body") // STRATA_COMMITTEE, OWNERS_CORPORATION
  decidedOn               DateTime?         @db.Date @map("decided_on") // the meeting date
  decisionRecordedBy      String?           @map("decision_recorded_by") @db.Uuid
  decisionRecordedAt      DateTime?         @db.Timestamptz @map("decision_recorded_at")
  refusalReasons          String?           @map("refusal_reasons")
  interestWaiver          String?           @map("interest_waiver") // WAIVED, NOT_WAIVED
  repliedOn               DateTime?         @db.Date @map("replied_on")
  lastReminderOn          DateTime?         @db.Date @map("last_reminder_on") // the day the last reply reminder was sent (claimed so a repeated run sends none)
  rulePack                String?           @map("rule_pack") @db.VarChar(40)
  notes                   String?
  createdAt               DateTime          @default(now()) @db.Timestamptz @map("created_at")
  updatedAt               DateTime          @updatedAt @db.Timestamptz @map("updated_at")

  scheme                  Scheme            @relation(fields: [schemeId], references: [id])
  lot                     Lot               @relation(fields: [lotId], references: [id])
  case                    DebtRecoveryCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  plan                    PaymentPlan?      @relation("PaymentPlanFromRequest")

  @@index([schemeId, status])
  @@index([lotId])
  @@map("payment_plan_requests")
}

model PaymentPlanInstalment {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId            String       @map("plan_id") @db.Uuid
  instalmentNumber  Int          @map("instalment_number")
  dueDate           DateTime     @db.Date @map("due_date")
  amount            Decimal      @db.Decimal(12, 2)
  amountPaid        Decimal      @default(0) @db.Decimal(12, 2) @map("amount_paid")
  status            String       @default("UPCOMING") // UPCOMING, DUE, PAID, OVERDUE, PARTIALLY_PAID
  paidAt            DateTime?    @db.Timestamptz @map("paid_at")
  notes             String?
  createdAt         DateTime     @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime     @updatedAt @db.Timestamptz @map("updated_at")

  plan              PaymentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, instalmentNumber])
  @@index([planId, status])
  @@map("payment_plan_instalments")
}

model DebtRecoveryDocument {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId            String             @map("case_id") @db.Uuid
  documentType      String             @map("document_type")
  // ARREARS_REMINDER, DEMAND_NOTICE, FINAL_DEMAND, STATUTORY_NOTICE, PAYMENT_PLAN_AGREEMENT, COMMITTEE_REPORT, SOLICITOR_REFERRAL, COURT_FILING, JUDGMENT, CORRESPONDENCE
  title             String             @db.VarChar(300)
  description       String?
  fileUrl           String?            @map("file_url")
  generatedContent  String?            @map("generated_content") // for draft letters/notices
  isDraft           Boolean            @default(true) @map("is_draft")
  issuedAt          DateTime?          @db.Timestamptz @map("issued_at")
  createdBy         String             @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime           @updatedAt @db.Timestamptz @map("updated_at")

  case              DebtRecoveryCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, documentType])
  @@map("debt_recovery_documents")
}

model DebtRecoveryActivity {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId            String             @map("case_id") @db.Uuid
  activityType      String             @map("activity_type")
  // CASE_OPENED, STEP_ADVANCED, NOTICE_SENT, PAYMENT_RECEIVED, PAYMENT_PLAN_CREATED, PAYMENT_PLAN_DEFAULTED, DISPUTE_RAISED, HARDSHIP_REQUEST, LEGAL_REFERRAL, CASE_CLOSED, NOTE_ADDED, DOCUMENT_ADDED, APPROVAL_GRANTED, STATUS_CHANGED
  description       String
  performedBy       String             @map("performed_by") @db.Uuid
  metadata          Json?              // flexible JSON for extra context
  createdAt         DateTime           @default(now()) @db.Timestamptz @map("created_at")

  case              DebtRecoveryCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("debt_recovery_activities")
}

// ═══════════════════════════════════════════════════════════════
// PLATFORM BILLING (StrataVerze charges to schemes, suppliers and developers)
// ═══════════════════════════════════════════════════════════════

/// Every StrataVerze price, with effective dates. Prices are flat amounts,
/// never percentages. Banded rows share a code and carry inclusive band bounds
/// (cents for money bands, lots for lot bands). Amounts exclude GST unless
/// gstInclusive is true.
model PlatformPriceBook {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String
  variant              String?
  description          String
  amount               Decimal?  @db.Decimal(12, 2)
  gstInclusive         Boolean   @default(false) @map("gst_inclusive")
  unit                 String // PER_EVENT, PER_MONTH, PER_YEAR, PER_SEAT_MONTH, PER_STEP, PER_NOTICE
  payerType            String    @map("payer_type") // OC, OWNER_VIA_OC, REQUESTING_PARTY, INCOMING_OWNER, DEVELOPER, SUPPLIER
  effectiveFrom        DateTime  @db.Date @map("effective_from")
  effectiveTo          DateTime? @db.Date @map("effective_to")
  isActive             Boolean   @default(true) @map("is_active")
  recoverableFromOwner Boolean   @default(false) @map("recoverable_from_owner")
  bandMin              Int?      @map("band_min")
  bandMax              Int?      @map("band_max")
  notes                String?
  createdAt            DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt            DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  @@index([code, isActive])
  @@map("platform_price_book")
}

/// A scheme's StrataVerze subscription. Tier comes from the active lot count
/// at the start of each billing period.
model SchemeSubscription {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId              String    @unique @map("scheme_id") @db.Uuid
  tier                  String // SMALL, MEDIUM, LARGE, ENTERPRISE
  monthlyPrice          Decimal?  @db.Decimal(12, 2) @map("monthly_price") // ex GST; null = manual quote
  status                String    @default("PROMOTIONAL") // PROMOTIONAL, ACTIVE, PAST_DUE, CANCELLED
  promotionEnd          DateTime? @db.Date @map("promotion_end")
  currentPeriodStart    DateTime? @db.Date @map("current_period_start")
  currentPeriodEnd      DateTime? @db.Date @map("current_period_end")
  lotCountAtPeriodStart Int?      @map("lot_count_at_period_start")
  createdAt             DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  @@map("scheme_subscriptions")
}

/// One StrataVerze charge arising from an action in a scheme. Never deleted:
/// reversing the source creates a REVERSED event that points at the original.
model PlatformFeeEvent {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The scheme charged, or null for a charge to a contractor business.
  schemeId            String?   @map("scheme_id") @db.Uuid
  /// The contractor business charged, for supplier charges.
  contractorBusinessId String?  @map("contractor_business_id") @db.Uuid
  code                String
  variant             String?
  description         String
  sourceType          String    @map("source_type")
  sourceId            String    @map("source_id")
  quantity            Int       @default(1)
  amountExGst         Decimal   @db.Decimal(12, 2) @map("amount_ex_gst") // negative on a reversal
  gstAmount           Decimal   @db.Decimal(12, 2) @map("gst_amount")
  payerType           String    @map("payer_type")
  payerProfileId      String?   @map("payer_profile_id") @db.Uuid
  recoverableFromOwner Boolean  @default(false) @map("recoverable_from_owner")
  status              String    @default("ACCRUED") // ACCRUED, INVOICED, EXTRACTED, WAIVED, REVERSED
  reversalOfId        String?   @map("reversal_of_id") @db.Uuid
  disclosureShownToId String?   @map("disclosure_shown_to_id") @db.Uuid
  disclosureShownAt   DateTime? @db.Timestamptz @map("disclosure_shown_at")
  disclosedAmount     Decimal?  @db.Decimal(12, 2) @map("disclosed_amount") // incl GST, as shown
  createdById         String?   @map("created_by_id") @db.Uuid
  providerItemId      String?   @map("provider_item_id")
  invoiceId           String?   @map("invoice_id") @db.Uuid
  journalEntryId      String?   @map("journal_entry_id") @db.Uuid
  idempotencyKey      String    @unique @map("idempotency_key")
  occurredAt          DateTime  @default(now()) @db.Timestamptz @map("occurred_at")
  createdAt           DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt           DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  @@index([schemeId, status])
  @@index([schemeId, occurredAt])
  @@index([sourceType, sourceId])
  @@index([contractorBusinessId, occurredAt])
  @@map("platform_fee_events")
}

/// StrataVerze's monthly invoice to a scheme. Recorded in the scheme's own
/// ledger as a supplier invoice so it is approved and paid like any other.
model PlatformInvoice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId          String    @map("scheme_id") @db.Uuid
  invoiceNumber     String    @unique @map("invoice_number")
  periodStart       DateTime  @db.Date @map("period_start")
  periodEnd         DateTime  @db.Date @map("period_end")
  subtotal          Decimal   @db.Decimal(12, 2)
  gst               Decimal   @db.Decimal(12, 2)
  total             Decimal   @db.Decimal(12, 2)
  status            String    @default("DRAFT") // DRAFT, ISSUED, APPROVED, PAID, CANCELLED
  supplierInvoiceId String?   @map("supplier_invoice_id") @db.Uuid
  pdfDocumentId     String?   @map("pdf_document_id") @db.Uuid
  issuedAt          DateTime? @db.Timestamptz @map("issued_at")
  createdAt         DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  @@unique([schemeId, periodStart])
  @@map("platform_invoices")
}

/// Commission a broker or underwriter partner paid StrataVerze on a scheme's
/// policy. Recorded only: StrataVerze does not quote, compare or place cover.
model ReferralIncome {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId          String    @map("scheme_id") @db.Uuid
  insurancePolicyId String?   @map("insurance_policy_id") @db.Uuid
  partnerName       String    @map("partner_name")
  amount            Decimal   @db.Decimal(12, 2)
  receivedAt        DateTime  @db.Date @map("received_at")
  disclosedAt       DateTime  @default(now()) @db.Timestamptz @map("disclosed_at")
  disclosureText    String    @map("disclosure_text")
  notes             String?
  recordedById      String?   @map("recorded_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  @@index([schemeId, receivedAt])
  @@index([insurancePolicyId])
  @@map("referral_income")
}

/// A scheme's StrataVerze credit balance (whole credits, never below zero).
model SchemeCreditBalance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId  String   @unique @map("scheme_id") @db.Uuid
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")

  @@map("scheme_credit_balances")
}

/// One movement of scheme credits. Consumptions name the fee event they pay.
model CreditTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId       String   @map("scheme_id") @db.Uuid
  type           String // PURCHASE, ALLOCATION, CONSUMPTION, ADJUSTMENT, REFUND
  credits        Int
  feeEventId     String?  @map("fee_event_id") @db.Uuid
  refundOfId     String?  @map("refund_of_id") @db.Uuid
  rateCardId     String?  @map("rate_card_id") @db.Uuid
  amountPaid     Decimal? @db.Decimal(12, 2) @map("amount_paid")
  reason         String?
  createdById    String?  @map("created_by_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @db.Timestamptz @map("created_at")

  @@index([schemeId, createdAt])
  @@map("credit_transactions")
}

/// Credit packs on sale: a number of credits for a flat price.
model CreditRateCard {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String
