  assignedTo      Profile?              @relation("WorksRequestAssignedTo", fields: [assignedToId], references: [id])
  category        WorksCategory?        @relation(fields: [categoryId], references: [id])
  versions        WorksRequestVersion[]
  reviews         WorksRequestReview[]
