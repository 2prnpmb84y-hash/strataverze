  rfq             WorksRfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation       WorksQuotation?  @relation(fields: [quotationId], references: [id])
  evaluator       Profile          @relation("WorksEvaluator", fields: [evaluatorId], references: [id])
  criteria        WorksEvaluationCriterion[]

  @@index([rfqId])
  @@index([quotationId])
  @@map("works_evaluations")
}

model WorksEvaluationCriterion {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluationId    String          @map("evaluation_id") @db.Uuid
  criterionName   String          @map("criterion_name") @db.VarChar(200)
  weight          Decimal         @db.Decimal(5, 2)
  score           Decimal         @db.Decimal(5, 2)
  weightedScore   Decimal         @db.Decimal(5, 2) @map("weighted_score")
  comments        String?
  createdAt       DateTime        @default(now()) @db.Timestamptz @map("created_at")

  evaluation      WorksEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@map("works_evaluation_criteria")
}

model WorksRecommendation {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rfqId             String?         @map("rfq_id") @db.Uuid
  quotationId       String          @map("quotation_id") @db.Uuid
  recommendedById   String          @map("recommended_by_id") @db.Uuid
  recommendation    String          // AWARD, REJECT, RE_TENDER, NEGOTIATE
