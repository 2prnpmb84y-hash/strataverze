  quotation         WorksQuotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  recommendedBy     Profile         @relation("WorksRecommendedBy", fields: [recommendedById], references: [id])

  @@index([quotationId])
  @@map("works_recommendations")
}

// ─── Works Module: Approvals ────────────────────────────────────

model WorksApprovalWorkflow {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId        String               @map("scheme_id") @db.Uuid
  entityType      String               @map("entity_type") // QUOTATION, VARIATION, INVOICE, PAYMENT
