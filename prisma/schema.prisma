// ─── Works Module: Contracts & Delivery ─────────────────────────

model WorksContract {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId             String                  @map("request_id") @db.Uuid
  schemeId              String                  @map("scheme_id") @db.Uuid
  quotationId           String?                 @map("quotation_id") @db.Uuid
  contractorBusinessId  String                  @map("contractor_business_id") @db.Uuid
  contractNumber        String                  @map("contract_number") @db.VarChar(30)
  title                 String                  @db.VarChar(300)
  description           String?
  contractValue         Decimal                 @db.Decimal(12, 2) @map("contract_value")
  gstAmount             Decimal                 @default(0) @db.Decimal(12, 2) @map("gst_amount")
  totalValue            Decimal                 @db.Decimal(12, 2) @map("total_value")
  approvedVariations    Decimal                 @default(0) @db.Decimal(12, 2) @map("approved_variations")
  revisedContractValue  Decimal?                @db.Decimal(12, 2) @map("revised_contract_value")
  startDate             DateTime?               @db.Date @map("start_date")
  endDate               DateTime?               @db.Date @map("end_date")
  defectsLiabilityEnd   DateTime?               @db.Date @map("defects_liability_end")
  retentionPercentage   Decimal?                @db.Decimal(5, 2) @map("retention_percentage")
  retentionAmount       Decimal?                @db.Decimal(12, 2) @map("retention_amount")
  status                String                  @default("DRAFT") // DRAFT, UNDER_REVIEW, AWAITING_EXECUTION, EXECUTED, ACTIVE, COMPLETE, TERMINATED
  signedById            String?                 @map("signed_by_id") @db.Uuid
  signedAt              DateTime?               @db.Timestamptz @map("signed_at")
  executedAt            DateTime?               @db.Timestamptz @map("executed_at")
  completedAt           DateTime?               @db.Timestamptz @map("completed_at")
  createdAt             DateTime                @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime                @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt             DateTime?               @db.Timestamptz @map("deleted_at")

  request               WorksRequest            @relation(fields: [requestId], references: [id])
  scheme                Scheme                  @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  quotation             WorksQuotation?         @relation(fields: [quotationId], references: [id])
  contractorBusiness    ContractorBusiness       @relation(fields: [contractorBusinessId], references: [id])
  signedBy              Profile?                @relation("WorksContractSignedBy", fields: [signedById], references: [id])
  workOrders            WorksWorkOrder[]
  variations            WorksVariation[]
  invoices              WorksInvoice[]
  documents             WorksDocument[]

  @@unique([schemeId, contractNumber])
  @@index([schemeId, status])
  @@index([contractorBusinessId])
  @@map("works_contracts")
}

model WorksWorkOrder {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// An urgent work order has no contract (works stage 2, 25 Oct 2026).
  contractId            String?                @map("contract_id") @db.Uuid
  /// The works request an urgent order was issued for.
  requestId             String?                @map("request_id") @db.Uuid
  /// The most the contractor may charge without coming back (urgent orders).
  amountLimit           Decimal?               @db.Decimal(12, 2) @map("amount_limit")
  issuedById            String?                @map("issued_by_id") @db.Uuid
  declinedAt            DateTime?              @db.Timestamptz @map("declined_at")
  declineReason         String?                @map("decline_reason")
  schemeId              String                 @map("scheme_id") @db.Uuid
  contractorBusinessId  String                 @map("contractor_business_id") @db.Uuid
  workOrderNumber       String                 @map("work_order_number") @db.VarChar(30)
  title                 String                 @db.VarChar(300)
  description           String?
  scheduledStart        DateTime?              @db.Date @map("scheduled_start")
  scheduledEnd          DateTime?              @db.Date @map("scheduled_end")
  actualStart           DateTime?              @db.Date @map("actual_start")
  actualEnd             DateTime?              @db.Date @map("actual_end")
  status                String                 @default("DRAFT") // DRAFT, AWAITING_ACKNOWLEDGEMENT, PRE_START_REVIEW, AUTHORISED, SCHEDULED, IN_PROGRESS, COMPLETION_REVIEW, COMPLETE
  acknowledgedAt        DateTime?              @db.Timestamptz @map("acknowledged_at")
  authorisedById        String?                @map("authorised_by_id") @db.Uuid
  authorisedAt          DateTime?              @db.Timestamptz @map("authorised_at")
  createdAt             DateTime               @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime               @updatedAt @db.Timestamptz @map("updated_at")

  contract              WorksContract?         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  request               WorksRequest?          @relation(fields: [requestId], references: [id], onDelete: SetNull)
  scheme                Scheme                 @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  contractorBusiness    ContractorBusiness      @relation(fields: [contractorBusinessId], references: [id])
  authorisedBy          Profile?               @relation("WorksWorkOrderAuthorisedBy", fields: [authorisedById], references: [id])
  issuedBy              Profile?               @relation("WorksWorkOrderIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  milestones            WorksMilestone[]
  siteVisits            WorksSiteVisit[]
  progressReports       WorksProgressReport[]
  inspections           WorksInspection[]
  completionSubmissions WorksCompletionSubmission[]
  complianceChecks      WorksComplianceCheck[]
  invoices              WorksInvoice[]

  @@unique([schemeId, workOrderNumber])
  @@index([contractId])
  @@index([requestId])
  @@index([schemeId, status])
  @@map("works_work_orders")
}

model WorksMilestone {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId     String         @map("work_order_id") @db.Uuid
  name            String         @db.VarChar(300)
