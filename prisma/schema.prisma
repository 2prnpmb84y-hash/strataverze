  orgId            String?   @map("org_id") @db.Uuid
  name             String    @db.VarChar(200)
  description      String?
  minAmount        Decimal?  @db.Decimal(12, 2) @map("min_amount")
  maxAmount        Decimal?  @db.Decimal(12, 2) @map("max_amount")
  requiredApprovers Int      @default(1) @map("required_approvers")
  approverRoles    String[]  @map("approver_roles") // array of PortalRole values
